# .env

# --- Global Settings ---
PROJECT_NAME=says

# --- Database Settings (for Docker Compose) ---
# This will be used to create the database and user inside the MySQL container
MYSQL_DATABASE=says_dev
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306

# --- Backend Services Database Connection ---
# These are the connection details for the services running inside Docker
DB_HOST=mysql_db  # The service name in docker-compose
DB_PORT=3306
DB_USER=${MYSQL_USER}
DB_PASSWORD=${MYSQL_PASSWORD}
DB_NAME=${MYSQL_DATABASE}

# --- Service Ports ---
# Ports exposed on your local machine
ACCOUNTS_SERVICE_PORT=8001
CONTACTS_SERVICE_PORT=8002
BOT_MESSAGE_SERVICE_PORT=8000

# --- Ngrok Settings ---
# Get your authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# --- Frontend Settings ---
# API base URL for frontend (accessed from browser)
# In development, use relative path to leverage Vite proxy
VITE_API_BASE_URL=/api/v1
# App version for cache management
VITE_APP_VERSION=1.0.2
# LeanCloud settings for frontend
VITE_LEANCLOUD_APP_ID=
VITE_LEANCLOUD_APP_KEY=

# --- LeanCloud Settings (Backend) ---
LEANCLOUD_APP_ID=
LEANCLOUD_APP_KEY=
LEANCLOUD_MASTER_KEY=
LEANCLOUD_BASE_URL=
VITE_LEANCLOUD_SERVER_URL=CN

# --- Doubao API Settings ---
DOUBAO_API_KEY=
# doubao-1.5-pro-32k
DOUBAO_MODEL_ID_STANDARD=
# doubao-seed-1.6
DOUBAO_MODEL_ID_ADVANCED=