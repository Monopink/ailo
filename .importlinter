[importlinter]
root_package = app
include_external_packages = True

[importlinter:contract:ai-services-layers]
name = Enforce layered architecture in AI services (package level)
type = layers
layers =
    orchestrators
    queries
containers =
    app.services.ai

[importlinter:contract:backend-layering]
name = Enforce backend layered architecture according to AGENTS
type = layers
layers =
    services.ai.orchestrators
    services.ai.relationship_scoring
    services.ai.queries
    services.ai.memory
    crud
    models
containers =
    app
