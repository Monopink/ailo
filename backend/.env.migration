# Database configuration for Alembic migrations
# This file is used when running Alembic from the host machine

# Application settings
PROJECT_NAME=Says
VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# PostgreSQL connection settings (Docker container)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=says
POSTGRES_USER=says_user
POSTGRES_PASSWORD=says_password
POSTGRES_ECHO=false

# Logging settings (not used for migrations but required by config)
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_DIR=logs

# JWT settings (not used for migrations but required by config)
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Security settings (not used for migrations but required by config)
BCRYPT_ROUNDS=12
CORS_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost", "127.0.0.1"]

# LeanCloud settings (not used for migrations but required by config)
LEANCLOUD_MASTER_KEY=your-master-key

# Snowflake ID settings (not used for migrations but required by config)
SNOWFLAKE_DATACENTER_ID=1
SNOWFLAKE_MACHINE_ID=1

# Admin settings (not used for migrations but required by config)
ADMIN_SECRET_KEY=your-admin-secret-key

# Redis settings (not used for migrations but required by config)
REDIS_URL=redis://localhost:6379/0
