# backend/chat_service/Dockerfile.stable

# ---- Build Stage ----
# Use a specific version of Python for reproducibility.
# Using 'as builder' names this stage.
FROM python:3.11-slim as builder

# Set the working directory
WORKDIR /app

# Upgrade pip
RUN pip install --no-cache-dir --upgrade pip

# Copy only the requirements file to leverage Docker's layer caching.
# This step will only be re-run if requirements.txt changes.
COPY ./requirements.txt /app/requirements.txt

# Install dependencies into a specific directory.
# Using a virtual environment is a good practice even in containers.
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN pip install --no-cache-dir -r requirements.txt

# ---- Final Stage ----
# Use the same base image for the final stage.
FROM python:3.11-slim

# Set a neutral working directory to avoid import ambiguity
WORKDIR /

# Copy the virtual environment from the builder stage.
COPY --from=builder /opt/venv /opt/venv

# Copy the application code into the /app directory
COPY . /app

# Activate the virtual environment and set PYTHONPATH.
ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONPATH="/app"

# Set the command to run the application in production mode.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"] 