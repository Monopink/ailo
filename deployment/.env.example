# .env.example

# --- Global Settings ---
# Application name (used for logging, monitoring, etc.)
APP_NAME=ailo
# Docker Compose project name (auto-generated from directory name if not set)
COMPOSE_PROJECT_NAME=ailo-dev

# --- Database Settings (for Docker Compose) ---
# This will be used to create the database and user inside the PostgreSQL container
# Using generic names for better reusability across projects
POSTGRES_DB=ailo
POSTGRES_USER=ailo_user
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- Database Initialization Settings ---
# Control whether to load sample/test data during database initialization
# Set to 'true' for development/testing, 'false' for production
LOAD_SAMPLE_DATA=true

# --- Backend Services Database Connection ---
# These are the connection details for the services running inside Docker
DB_HOST=postgres  # The service name in docker-compose
DB_PORT=5432
DB_USER=ailo_user
DB_PASSWORD=${POSTGRES_PASSWORD}
DB_NAME=ailo

# --- Service Ports ---
# Ports exposed on your local machine
BACKEND_PORT=8000

# --- JWT Authentication ---
# Secret key for JWT token signing (generate with: openssl rand -hex 32)
SECRET_KEY=
# JWT algorithm
ALGORITHM=HS256

# --- Admin Authentication ---
# Secret key for admin session (generate with: openssl rand -hex 32)
ADMIN_SECRET_KEY=

# --- Proxy Trust Settings ---
# Client IP source mode: peer (direct connection) or trusted_header (reverse proxy header)
CLIENT_IP_MODE=trusted_header
# Header injected by reverse proxy for real client IP
CLIENT_IP_HEADER=X-Client-IP
# JSON array of trusted proxy IP/CIDR entries
TRUSTED_PROXY_CIDRS=["127.0.0.1/32","::1/128","172.16.0.0/12"]

# --- Ngrok Settings ---
# Get your authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# --- ID Settings ---
# Prefix for IDs
ID_PREFIX=qqid_

# --- Message Encryption Settings ---
# Encryption algorithm: BASE64 or AES_256_GCM
ENCRYPTION_ALGORITHM=BASE64
# AES-256 encryption key (32 bytes, base64 encoded) - only needed if using AES_256_GCM
# Generate with: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY_AES256=

# --- LeanCloud IM Settings (Backend) ---
LEANCLOUD_MASTER_KEY=

# --- Doubao API Settings ---
DOUBAO_API_KEY=

# --- WeChat Mini Program ---
WECHAT_APP_ID=wx6935fe0a74a96664
WECHAT_APP_SECRET=

# --- CAPTCHA Client Whitelist ---
# Comma-separated client IDs allowed to call /system/captcha-config (lowercase)
CAPTCHA_CLIENT_WHITELIST=web-admin

# --- Object Storage Settings ---
# Storage provider: tencent_cos only
STORAGE_PROVIDER=tencent_cos

# Tencent Cloud COS (Object Storage)
# Get credentials from: https://console.cloud.tencent.com/cam/capi
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_REGION=ap-shanghai
TENCENT_COS_BUCKET=app-media-dev
TENCENT_COS_ENDPOINT=https://cos.ap-shanghai.myqcloud.com

# Public base URL for serving uploaded media files
# Backend will use system_configs.media_public_base_url as the authoritative source.
# This environment variable serves as a bootstrap fallback when database value is empty.
# Examples:
#   - COS bucket domain: https://bucket-name.cos.region.myqcloud.com
#   - CDN domain: https://cdn.example.com
MEDIA_PUBLIC_BASE_URL=
