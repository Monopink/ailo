# .env.example - Shared Baseline Configuration
#
# This file defines the full env var inventory for the backend and deployments.
# Copy it to deployment/.env and fill in all required values.
#
# Environment-specific overrides live in:
# - deployment/dev/.env (from deployment/dev/.env.example)
# - deployment/staging/.env (from deployment/staging/.env.example)
# - deployment/prod/.env (from deployment/prod/.env.example)

# --- Global Settings ---
APP_NAME=ailo
COMPOSE_PROJECT_NAME=ailo
ENVIRONMENT=development
VERSION=0.0.1
DEBUG=false

# --- Domain / Certificate (used by deployment) ---
DOMAIN=example.com
CERTBOT_EMAIL=admin@example.com
API_BASE_URL=https://example.com

# --- Build Mirrors (used by docker build args) ---
# Leave empty to use upstream defaults (deb.debian.org / pypi.org) for the build.
APT_MIRROR_HOST=mirrors.tuna.tsinghua.edu.cn
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# --- Database Settings (for Docker Compose) ---
POSTGRES_DB=ailo
POSTGRES_USER=ailo_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432
# Production may mount external disk; optional.
POSTGRES_DATA_DIR=

# --- Backend Services Database Connection ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=ailo_user
DB_PASSWORD=CHANGE_ME
DB_NAME=ailo
POSTGRES_ECHO=false

# --- Database Initialization (used by docker compose for postgres init scripts) ---
LOAD_SAMPLE_DATA=false

# --- Service Ports (used by docker compose) ---
BACKEND_PORT=8000

# --- JWT Authentication ---
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Admin Settings ---
ADMIN_SECRET_KEY=CHANGE_ME
ADMIN_BOOTSTRAP_PASSWORD_HASH=

# --- Security Settings ---
BCRYPT_ROUNDS=12
CORS_ORIGINS=["https://example.com"]
ALLOWED_HOSTS=["example.com"]
CLIENT_IP_MODE=trusted_header
CLIENT_IP_HEADER=X-Client-IP
TRUSTED_PROXY_CIDRS=["127.0.0.1/32","::1/128","172.16.0.0/12"]

# --- Logging Settings ---
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=/backend/logs

# --- Development Tools ---
NGROK_AUTHTOKEN=

# --- Snowflake ID Settings ---
SNOWFLAKE_DATACENTER_ID=1
SNOWFLAKE_MACHINE_ID=1

# --- Turnstile (Admin CAPTCHA) ---
# Optional. If empty/unset, admin Turnstile login flow cannot complete verification.
ADMIN_TURNSTILE_SECRET_KEY=
ADMIN_TURNSTILE_SITE_KEY=

# --- LeanCloud IM Settings ---
LEANCLOUD_MASTER_KEY=CHANGE_ME
LEANCLOUD_IM_APP_ID=CHANGE_ME
LEANCLOUD_IM_APP_KEY=CHANGE_ME

# --- Doubao API Settings ---
DOUBAO_API_KEY=CHANGE_ME

# --- WeChat Mini Program ---
WECHAT_APP_ID=CHANGE_ME
WECHAT_APP_SECRET=CHANGE_ME

# --- Object Storage Settings (media) ---
TENCENT_COS_MEDIA_SECRET_ID=CHANGE_ME
TENCENT_COS_MEDIA_SECRET_KEY=CHANGE_ME
TENCENT_COS_MEDIA_REGION=ap-shanghai
TENCENT_COS_MEDIA_BUCKET=CHANGE_ME
TENCENT_COS_MEDIA_ENDPOINT=https://cos.ap-shanghai.myqcloud.com

# --- Object Storage Settings (backup - optional until used) ---
TENCENT_COS_BACKUP_SECRET_ID=
TENCENT_COS_BACKUP_SECRET_KEY=
TENCENT_COS_BACKUP_REGION=
TENCENT_COS_BACKUP_BUCKET=
TENCENT_COS_BACKUP_ENDPOINT=
