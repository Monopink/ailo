# .env.example
#
# 使用说明：
# 1. 复制此文件为 .env：cp .env.example .env
# 2. 根据你的实际环境修改相应的配置值
# 3. 确保 .env 文件不要提交到Git仓库（已在.gitignore中排除）

# --- Global Settings ---
PROJECT_NAME=says
COMPOSE_PROJECT_NAME=says_dev

# --- Database Settings (for Docker Compose) ---
# This will be used to create the database and user inside the PostgreSQL container
POSTGRES_DATABASE=says_db
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

# --- Backend Services Database Connection ---
# These are the connection details for the services running inside Docker
DB_HOST=postgres_db  # The service name in docker-compose
DB_PORT=5432
DB_USER=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}
DB_NAME=${POSTGRES_DATABASE}

# --- Service Ports ---
# Ports exposed on your local machine
BACKEND_PORT=8000

# --- JWT Authentication ---
# Secret key for JWT token signing (generate with: openssl rand -hex 32)
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
# JWT algorithm
ALGORITHM=HS256

# --- Admin Authentication ---
# Secret key for admin session (generate with: openssl rand -hex 32)
ADMIN_SECRET_KEY=your_admin_secret_key_here

# --- Ngrok Settings ---
# Get your authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# --- Entity ID Settings ---
# Prefix for entity IDs
ENTITY_ID_PREFIX=qqid_

# --- Message Encryption Settings ---
# Encryption algorithm: BASE64 or AES_256_GCM
ENCRYPTION_ALGORITHM=BASE64
# AES-256 encryption key (32 bytes, base64 encoded) - only needed if using AES_256_GCM
# Generate with: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY_AES256=your_base64_encoded_32_byte_key_here

# --- LeanCloud Settings (Backend) ---
LEANCLOUD_MASTER_KEY=your_leancloud_master_key

# --- Doubao API Settings ---
DOUBAO_API_KEY=your_doubao_api_key
