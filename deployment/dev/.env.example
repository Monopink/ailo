# .env.example - Development Environment Overrides
#
# This file overrides deployment/.env for local development.
# Copy it to deployment/dev/.env and keep the same field set as the actual
# development override file.

COMPOSE_PROJECT_NAME=ailo-dev
ENVIRONMENT=development
DEBUG=true

DOMAIN=localhost
API_BASE_URL=http://localhost
CERTBOT_EMAIL=admin@example.com

POSTGRES_PASSWORD=CHANGE_ME
DB_PASSWORD=CHANGE_ME
LOAD_SAMPLE_DATA=true

JWT_SECRET_KEY=CHANGE_ME
ADMIN_SECRET_KEY=CHANGE_ME

LOG_DIR=logs

CORS_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174"]
ALLOWED_HOSTS=["localhost","127.0.0.1","*"]
CLIENT_IP_MODE=peer

NGROK_AUTHTOKEN=CHANGE_ME

LEANCLOUD_MASTER_KEY=CHANGE_ME
LEANCLOUD_IM_APP_ID=CHANGE_ME
LEANCLOUD_IM_APP_KEY=CHANGE_ME

DOUBAO_API_KEY=CHANGE_ME

WECHAT_APP_ID=CHANGE_ME
WECHAT_APP_SECRET=CHANGE_ME

ADMIN_TURNSTILE_SECRET_KEY=CHANGE_ME
ADMIN_TURNSTILE_SITE_KEY=0x4AAAAAAB4mlG1QV6muTpRg

TENCENT_COS_MEDIA_BUCKET=app-media-dev
TENCENT_COS_MEDIA_REGION=ap-shanghai
TENCENT_COS_MEDIA_ENDPOINT=https://cos.ap-shanghai.myqcloud.com
TENCENT_COS_MEDIA_SECRET_ID=CHANGE_ME
TENCENT_COS_MEDIA_SECRET_KEY=CHANGE_ME

TENCENT_COS_BACKUP_BUCKET=app-backup-dev
TENCENT_COS_BACKUP_REGION=ap-shanghai
TENCENT_COS_BACKUP_ENDPOINT=https://cos.ap-shanghai.myqcloud.com
TENCENT_COS_BACKUP_SECRET_ID=CHANGE_ME
TENCENT_COS_BACKUP_SECRET_KEY=CHANGE_ME
