# .env.example - Production Environment Overrides
#
# This file overrides deployment/.env for production.
# Copy it to deployment/prod/.env and keep the same field set as the actual
# production override file.

COMPOSE_PROJECT_NAME=ailo-prod
ENVIRONMENT=production
DEBUG=false

DOMAIN=synapse.qiaoqiaoai.cn
API_BASE_URL=https://synapse.qiaoqiaoai.cn
CERTBOT_EMAIL=admin@example.com

POSTGRES_PASSWORD=CHANGE_IN_PRODUCTION
POSTGRES_DATA_DIR=/mnt/datadisk0/postgres
DB_PASSWORD=CHANGE_IN_PRODUCTION
POSTGRES_ECHO=false
LOAD_SAMPLE_DATA=false

JWT_SECRET_KEY=CHANGE_IN_PRODUCTION
ADMIN_SECRET_KEY=CHANGE_IN_PRODUCTION
ADMIN_BOOTSTRAP_PASSWORD_HASH=CHANGE_IN_PRODUCTION_BCRYPT_HASH

LOG_DIR=/backend/logs

CORS_ORIGINS=["https://synapse.qiaoqiaoai.cn"]
ALLOWED_HOSTS=["synapse.qiaoqiaoai.cn","localhost","127.0.0.1"]
CLIENT_IP_MODE=trusted_header

LEANCLOUD_MASTER_KEY=CHANGE_IN_PRODUCTION
LEANCLOUD_IM_APP_ID=CHANGE_IN_PRODUCTION
LEANCLOUD_IM_APP_KEY=CHANGE_IN_PRODUCTION

DOUBAO_API_KEY=CHANGE_IN_PRODUCTION

WECHAT_APP_ID=CHANGE_IN_PRODUCTION
WECHAT_APP_SECRET=CHANGE_IN_PRODUCTION

ADMIN_TURNSTILE_SECRET_KEY=CHANGE_IN_PRODUCTION
ADMIN_TURNSTILE_SITE_KEY=CHANGE_IN_PRODUCTION

TENCENT_COS_MEDIA_BUCKET=CHANGE_IN_PRODUCTION
TENCENT_COS_MEDIA_REGION=ap-shanghai
TENCENT_COS_MEDIA_ENDPOINT=https://cos.ap-shanghai.myqcloud.com
TENCENT_COS_MEDIA_SECRET_ID=CHANGE_IN_PRODUCTION
TENCENT_COS_MEDIA_SECRET_KEY=CHANGE_IN_PRODUCTION

TENCENT_COS_BACKUP_SECRET_ID=CHANGE_IN_PRODUCTION
TENCENT_COS_BACKUP_SECRET_KEY=CHANGE_IN_PRODUCTION
TENCENT_COS_BACKUP_REGION=ap-shanghai
TENCENT_COS_BACKUP_BUCKET=CHANGE_IN_PRODUCTION
TENCENT_COS_BACKUP_ENDPOINT=https://cos.ap-shanghai.myqcloud.com
