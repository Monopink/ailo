# .env.example - Staging Environment Overrides (testing environment)
#
# This file overrides deployment/.env for staging.
# Copy it to deployment/staging/.env and keep the same field set as the actual
# staging override file.

COMPOSE_PROJECT_NAME=ailo-staging
ENVIRONMENT=staging
DEBUG=false

DOMAIN=ark3.example.com
API_BASE_URL=https://ark3.example.com
CERTBOT_EMAIL=admin@example.com

POSTGRES_PASSWORD=CHANGE_IN_STAGING
DB_PASSWORD=CHANGE_IN_STAGING
POSTGRES_ECHO=false
LOAD_SAMPLE_DATA=true

JWT_SECRET_KEY=CHANGE_IN_STAGING
ADMIN_SECRET_KEY=CHANGE_IN_STAGING

LOG_DIR=/backend/logs

CORS_ORIGINS=["https://ark3.example.com"]
ALLOWED_HOSTS=["ark3.example.com"]
CLIENT_IP_MODE=trusted_header

LEANCLOUD_MASTER_KEY=CHANGE_IN_STAGING
LEANCLOUD_IM_APP_ID=CHANGE_IN_STAGING
LEANCLOUD_IM_APP_KEY=CHANGE_IN_STAGING

DOUBAO_API_KEY=CHANGE_IN_STAGING

WECHAT_APP_ID=CHANGE_IN_STAGING
WECHAT_APP_SECRET=CHANGE_IN_STAGING

ADMIN_TURNSTILE_SECRET_KEY=CHANGE_IN_STAGING
ADMIN_TURNSTILE_SITE_KEY=0x4AAAAAAB4mlG1QV6muTpRg

TENCENT_COS_MEDIA_BUCKET=CHANGE_IN_STAGING
TENCENT_COS_MEDIA_REGION=ap-shanghai
TENCENT_COS_MEDIA_ENDPOINT=https://cos.ap-shanghai.myqcloud.com
TENCENT_COS_MEDIA_SECRET_ID=CHANGE_IN_STAGING
TENCENT_COS_MEDIA_SECRET_KEY=CHANGE_IN_STAGING

TENCENT_COS_BACKUP_SECRET_ID=CHANGE_IN_STAGING
TENCENT_COS_BACKUP_SECRET_KEY=CHANGE_IN_STAGING
TENCENT_COS_BACKUP_REGION=ap-shanghai
TENCENT_COS_BACKUP_BUCKET=CHANGE_IN_STAGING
TENCENT_COS_BACKUP_ENDPOINT=https://cos.ap-shanghai.myqcloud.com
