{
  "pages": [
    "pages/boot/boot",
    "pages/square-entry/square-entry",
    "pages/square/square",
    "pages/square-demo/square-demo",
    "pages/login/login",
    "pages/setup/setup",
    "pages/index/index",
    "pages/chat/chat",
    "pages/profile/profile",
    "pages/profile-detail/profile-detail",
    "pages/field-edit/field-edit",
    "pages/account-security/account-security",
    "pages/minor-mode/minor-mode",
    "pages/contact-info/contact-info",
    "pages/contact-requests/contact-requests",
    "pages/stranger-info/stranger-info",
    "pages/avatar-cropper/avatar-cropper",
    "pages/about/about",
    "pages/app-page/app-page"
  ],
  "window": {
    "backgroundTextStyle": "@bgTxtStyle",
    "navigationBarBackgroundColor": "@navBgColor",
    "navigationBarTitleText": "敲敲",
    "navigationBarTextStyle": "@navTxtStyle",
    "backgroundColor": "@bgColor"
  },
  "entryPagePath": "pages/boot/boot",
  "tabBar": {
    "custom": true,
    "color": "@tabFontColor",
    "selectedColor": "@tabSelectedColor",
    "backgroundColor": "@tabBgColor",
    "borderStyle": "@tabBorderStyle",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "聊天"
      },
      {
        "pagePath": "pages/square-entry/square-entry",
        "text": "发现"
      },
      {
        "pagePath": "pages/profile/profile",
        "text": "我的"
      }
    ]
  },
  "permission": {
    "scope.userLocation": {
      "desc": "用于推荐附近的联系人"
    }
  },
  "renderer": "webview",
  "lazyCodeLoading": "requiredComponents",
  "networkTimeout": {
    "request": 10000,
    "downloadFile": 10000
  },
  "themeLocation": "theme.json",
  "darkmode": true,
  "debug": false
