{
  "pages": [
    "pages/boot/boot",
    "pages/square-entry/square-entry",
    "pages/login/login",
    "pages/setup/setup",
    "pages/index/index",
    "pages/profile/profile"
  ],
  "subPackages": [
    {
      "root": "pkg",
      "pages": [
        "square/square",
        "square-demo/square-demo",
        "chat/chat",
        "contact-info/contact-info",
        "stranger-info/stranger-info",
        "field-edit/field-edit",
        "contact-requests/contact-requests",
        "profile-detail/profile-detail",
        "account-security/account-security",
        "minor-mode/minor-mode",
        "avatar-cropper/avatar-cropper",
        "about/about",
        "app-page/app-page"
      ]
    }
  ],
  "window": {
    "backgroundTextStyle": "@bgTxtStyle",
    "navigationBarBackgroundColor": "@navBgColor",
    "navigationBarTitleText": "敲敲",
    "navigationBarTextStyle": "@navTxtStyle",
    "backgroundColor": "@bgColor"
  },
  "entryPagePath": "pages/boot/boot",
  "tabBar": {
    "custom": true,
    "color": "@tabFontColor",
    "selectedColor": "@tabSelectedColor",
    "backgroundColor": "@tabBgColor",
    "borderStyle": "@tabBorderStyle",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "聊天"
      },
      {
        "pagePath": "pages/square-entry/square-entry",
        "text": "发现"
      },
      {
        "pagePath": "pages/profile/profile",
        "text": "我的"
      }
    ]
  },
  "permission": {
    "scope.userLocation": {
      "desc": "用于推荐附近的联系人"
    }
  },
  "renderer": "webview",
  "lazyCodeLoading": "requiredComponents",
  "networkTimeout": {
    "request": 10000,
    "downloadFile": 10000
  },
  "themeLocation": "theme.json",
  "darkmode": true,
  "debug": false
}
