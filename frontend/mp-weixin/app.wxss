/* Avoid full global TDesign style entry to control package size. */
/* Keep only the hotspot utility required by TDesign interaction areas. */
.hotspot-expanded.relative {
  position: relative;
}

.hotspot-expanded::after {
  content: '';
  display: block;
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  transform: scale(1.5);
}

/* Import custom TDesign theme overrides */
@import '/styles/tdesign-theme.wxss';

/* Import shared design tokens for custom components */
@import '/styles/design-tokens.global.wxss';

/* Override TDesign TabBar colors globally */
page {
  --td-brand-color: var(--color-primary);
  --td-primary-color: var(--color-primary);
  --td-primary-color-7: var(--color-primary);
}

/* ========================================
   TDesign Component Style Fixes
   ======================================== */

/* Fix: TDesign Input has no border-radius by default */
/* Apply unified border-radius to match buttons and cards */
.t-input {
  border-radius: var(--td-radius-default) !important;
}

.t-input__wrap {
  border-radius: var(--td-radius-default) !important;
}

/* Ensure textarea also has unified border-radius */
.t-textarea {
  border-radius: var(--td-radius-default) !important;
}

.t-textarea__wrapper {
  border-radius: var(--td-radius-default) !important;
}

/**
 * Global utility styles.
 * All numeric values reference design tokens to keep UI consistent.
 */

page {
  min-height: 100%;
  background-color: var(--color-bg-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial,
    sans-serif;
  font-size: var(--font-size-base);
  line-height: var(--line-height-base);
  color: var(--color-text-primary);
}

/* Layout helpers */
.container {
  width: 100%;
  min-height: 100%;
  box-sizing: border-box;
}

.flex {
  display: flex;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
}

/* Spacing utilities */
.padding {
  padding: var(--space-md);
}

.padding-sm {
  padding: var(--space-sm);
}

.padding-lg {
  padding: var(--space-lg);
}

.margin {
  margin: var(--space-md);
}

.margin-sm {
  margin: var(--space-sm);
}

.margin-lg {
  margin: var(--space-lg);
}

.gap-sm {
  gap: var(--space-sm);
}

.gap-md {
  gap: var(--space-md);
}

/* Border radius */
.radius {
  border-radius: var(--radius-md);
}

.radius-sm {
  border-radius: var(--radius-sm);
}

.radius-lg {
  border-radius: var(--radius-lg);
}

.radius-full {
  border-radius: var(--radius-full);
}

/* Typography */
.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

.text-bold {
  font-weight: var(--font-weight-semibold);
}

.text-sm {
  font-size: var(--font-size-sm);
}

.text-lg {
  font-size: var(--font-size-lg);
}

.text-xl {
  font-size: var(--font-size-xl);
}

.text-muted {
  color: var(--color-text-secondary);
}

.text-placeholder {
  color: var(--color-text-tertiary);
}

.text-inverse {
  color: var(--color-text-inverse);
}

/* Utility */
.hidden {
  display: none;
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.page-group {
  background-color: var(--color-bg-secondary);
  margin-top: var(--space-md);
  overflow: hidden;
}

/**
 * Card layout container
 * Used for pages with card-style layout
 * Provides consistent padding for card spacing
 */
.card-container {
  padding: 0; /* No horizontal padding - cards span full width */
}

/**
 * Card wrapper - Wraps each t-cell-group to provide spacing
 * IMPORTANT: TDesign's t-cell-group does NOT support custom external-classes
 * Must wrap with <view class="card-wrapper"> to control spacing
 * Usage: <view class="card-wrapper"><t-cell-group theme="card">...</t-cell-group></view>
 */
.card-wrapper {
  margin-top: var(--space-md); /* 24rpx */
}

.card-wrapper:first-child {
  margin-top: var(--space-sm); /* 16rpx - less space at top */
}

.card-wrapper:last-child {
  margin-bottom: var(--space-md); /* 24rpx - breathing room at bottom */
}

/**
 * Global Navbar Title
 */
.navbar-title {
  font-size: var(--font-size-nav-title);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  line-height: var(--line-height-base);
}

/**
 * Large Title Header
 * Used with t-navbar when a big title is required below the navbar.
 */
.page-large-title {
  padding: var(--space-sm) var(--padding-page) var(--space-md);
  background-color: var(--color-bg-header-solid, var(--color-bg-page));
}

.page-large-title__text {
  font-size: var(--font-size-xxl);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  line-height: var(--line-height-tight);
}

.page-large-title__subtitle {
  display: block;
  margin-top: var(--space-xs);
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  line-height: var(--line-height-base);
}

/**
 * List Text Styles (Unified)
 */
.list-text-primary {
  font-size: var(--font-size-list-primary);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  line-height: var(--line-height-list-primary);
}

.list-text-secondary {
  font-size: var(--font-size-list-secondary);
  color: var(--color-text-secondary);
  line-height: var(--line-height-list-secondary);
}

.list-text-tertiary {
  font-size: var(--font-size-list-secondary);
  color: var(--color-text-tertiary);
  line-height: var(--line-height-list-secondary);
}

/**
 * List Cell Layout (TDesign Cell)
 */
.list-cell {
  --td-cell-vertical-padding: var(--space-list-vertical);
  --td-cell-horizontal-padding: var(--space-list-horizontal);
}

.list-item__left {
  margin-right: var(--space-list-avatar-gap);
}

.list-item__center {
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: var(--space-xs);
}

.list-item__right {
  min-width: var(--size-list-right-meta);
  align-items: center;
  justify-content: center;
  overflow: visible;
}

.list-item__title-wrap,
.list-item__description-wrap {
  min-width: 0;
}

.list-item__description {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  min-width: 0;
}

.list-item__meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  gap: var(--space-xs);
}

.list-preview {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-time {
  font-size: var(--font-size-list-secondary);
  color: var(--color-text-tertiary);
  line-height: var(--line-height-list-secondary);
  white-space: nowrap;
}

/**
 * List Row Layout (Custom Lists)
 */
.list-row {
  display: flex;
  align-items: flex-start;
  gap: var(--space-list-avatar-gap);
  padding: var(--space-list-vertical) var(--space-list-horizontal);
  background-color: var(--color-bg-secondary);
  border-bottom: 1rpx solid var(--color-separator);
}

.list-row:active {
  background-color: var(--color-bg-hover);
}

.list-row:last-child {
  border-bottom: none;
}

.list-row__avatar {
  flex-shrink: 0;
  margin-top: 4rpx;
}

.list-row__info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  gap: var(--space-xs);
}

.list-row__right {
  flex-shrink: 0;
  min-width: var(--size-list-right-meta);
  display: flex;
  justify-content: flex-end;
}

.list-row__meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: var(--space-xs);
}
/**
 * Page footer container
 * Used for bottom action buttons
 * Example: Most pages with action buttons at bottom
 */
.page-footer {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  padding: var(--space-md) var(--padding-page) calc(var(--space-md) + var(--safe-area-inset-bottom));
  background-color: var(--color-bg-secondary);
  border-top: 1rpx solid var(--color-separator);
}
