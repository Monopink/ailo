<view class="page-layout">
  <view class="page-layout__header {{isHeaderSolid ? 'page-layout__header--solid' : ''}}">
    <slot name="header" />
  </view>

  <view wx:if="{{screenState === 'booting'}}" class="page-layout__blank" />

  <view wx:elif="{{contentVariant === 'empty'}}" class="page-layout__empty">
    <slot name="empty">
      <empty-state
        message="{{emptyMessage}}"
        actionText="{{emptyActionText}}"
        bind:action="onEmptyAction" />
    </slot>
  </view>

  <scroll-view
    wx:elif="{{contentVariant === 'data'}}"
    class="page-layout__content"
    scroll-y="{{!disableScroll}}"
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
    scroll-into-view="{{contentScrollIntoView}}"
    scroll-with-animation="{{contentScrollWithAnimation}}"
    bindscroll="onContentScroll">
    <slot name="content" />

    <view wx:if="{{hasFooter && !fixedFooter}}" class="page-layout__footer-inline">
      <slot name="footer" />
    </view>
  </scroll-view>

  <view wx:else class="page-layout__blank">
    <slot name="blank" />
  </view>

  <view
    wx:if="{{hasFooter && fixedFooter && screenState === 'ready'}}"
    class="page-layout__footer-fixed">
    <slot name="footer" />
  </view>
</view>
