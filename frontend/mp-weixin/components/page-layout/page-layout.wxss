/**
 * Page Layout Component Styles
 *
 * Standard styles for page-layout component.
 * CSS variables are inherited from page-level styles.
 */

/* ========================================
   Page Layout Container
   ======================================== */

.page-layout {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  background-color: var(--color-bg-page);
  overflow: hidden;
}

/* ========================================
   Header Area - Always Visible
   ======================================== */

.page-layout__header {
  width: 100%;
  flex-shrink: 0;
  position: relative;
  z-index: var(--z-index-navbar);
  background-color: var(--color-navbar-glass-bg);
  -webkit-backdrop-filter: blur(var(--navbar-glass-blur));
  backdrop-filter: blur(var(--navbar-glass-blur));
  --td-navbar-bg-color: transparent;
  --td-navbar-background: transparent;
}

.page-layout__header--solid {
  background-color: var(--color-bg-header-solid, var(--color-bg-primary));
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
  --td-navbar-bg-color: var(--color-bg-header-solid, var(--color-bg-primary));
  --td-navbar-background: var(--color-bg-header-solid, var(--color-bg-primary));
}

/* ========================================
   Content Area
   ======================================== */

.page-layout__content {
  flex: 1;
  width: 100%;
  height: 0; /* Required for flex child with scroll */
  overflow-y: auto;
}

.page-layout__content--static {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.page-layout__empty,
.page-layout__blank {
  flex: 1;
  width: 100%;
  min-height: 0;
  padding: var(--space-xxl) var(--padding-page);
  box-sizing: border-box;
}

.page-layout__empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ========================================
   Footer Actions - Inline (Modern & Clean)
   ======================================== */

.page-layout__footer-inline {
  width: 100%;
  background-color: transparent; /* Transparent for seamless integration */
  padding: var(--space-xl) var(--padding-page);
  padding-bottom: calc(
    var(--space-xl) + var(--page-safe-area-inset-bottom, var(--safe-area-inset-bottom))
  );
  box-sizing: border-box;
}

/* ========================================
   Footer Actions - Fixed (Special Cases)
   ======================================== */

.page-layout__footer-fixed {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  transform: translate3d(0, calc(-1 * var(--page-footer-offset-y, 0rpx)), 0);
  will-change: transform;
  background-color: var(--color-bg-footer-fixed, var(--color-bg-primary));
  /* Optional glass blur for pages that want frosted footer (e.g., chat input safe area). */
  -webkit-backdrop-filter: blur(var(--footer-glass-blur, 0rpx));
  backdrop-filter: blur(var(--footer-glass-blur, 0rpx));
  border-top: 1rpx solid var(--color-separator);
  padding-bottom: var(--page-safe-area-inset-bottom, var(--safe-area-inset-bottom));
  box-sizing: border-box;
  z-index: var(--z-index-fixed);
}
