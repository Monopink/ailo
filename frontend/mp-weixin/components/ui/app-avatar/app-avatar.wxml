<view
  class="ui-avatar ui-avatar--{{shape}}"
  style="{{sizeStyle}}"
  aria-role="img"
  aria-label="头像">
  <image
    class="ui-avatar__image {{!mainFailed && mainSrc !== '' ? 'ui-avatar__image--visible' : 'ui-avatar__image--hidden'}}"
    src="{{mainSrc}}"
    mode="{{mode}}"
    webp="{{webp}}"
    lazy-load="{{lazy}}"
    bindload="onMainLoad"
    binderror="onMainError" />
  <image
    class="ui-avatar__prefetch"
    src="{{prefetchSrc}}"
    mode="{{mode}}"
    webp="{{webp}}"
    lazy-load="{{lazy}}"
    bindload="onPrefetchLoad"
    binderror="onPrefetchError" />
  <view wx:if="{{mainSrc === '' || mainFailed}}" class="ui-avatar__placeholder" aria-hidden="{{true}}"></view>
</view>
