@import '/styles/design-tokens.global.wxss';
@import '/styles/tdesign-theme.wxss';

.boot-page {
  flex: 1;
  min-height: 100vh;
  padding: 0 var(--padding-page);
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--color-bg-primary);
}

.boot-page__loading {
  opacity: 0;
  animation: boot-loading-fade-in var(--duration-fast) var(--ease-out) forwards;
}

@keyframes boot-loading-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
