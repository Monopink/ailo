<page-layout
  screenState="{{pageLayoutData.screenModel.screenState}}"
  contentVariant="{{pageLayoutData.screenModel.contentVariant}}"
  refreshState="{{pageLayoutData.screenModel.refreshState}}"
  emptyMessage="{{pageLayoutData.emptyMessage}}"
  hasFooter="{{pageLayoutData.hasFooter}}">
  <t-navbar slot="header" left-arrow="{{true}}">
    <view slot="title" class="navbar-title">聊天详情</view>
  </t-navbar>
  <view slot="content" class="chat-detail">
    <!-- Hero section - horizontal layout -->
    <view wx:if="{{contact}}" class="chat-detail__hero">
      <app-avatar src="{{contactView.avatar}}" size="large" shape="circle" />
      <view class="chat-detail__hero-info">
        <view class="chat-detail__hero-name">
          <text class="chat-detail__hero-text">{{contactView.name}}</text>
          <t-tag
            wx:if="{{contactView.hasGender}}"
            size="small"
            variant="outline"
            theme="{{contactView.genderType}}">
            {{contactView.genderLabel}}
          </t-tag>
        </view>
        <text class="chat-detail__hero-id">敲敲号：{{contactView.displayQiaoId}}</text>
      </view>
      <t-button
        variant="outline"
        size="small"
        bindtap="viewProfile">
        查看资料
      </t-button>
    </view>

    <!-- Tags group -->
    <view wx:if="{{contact}}" class="chat-detail__group">
      <t-cell title="联系人标签" arrow hover bindtap="manageTags">
        <text slot="note" class="chat-detail__link">管理</text>
      </t-cell>
    </view>

    <!-- Settings group -->
    <view wx:if="{{contact}}" class="chat-detail__group">
      <t-cell title="聊天背景">
        <text slot="note" class="chat-detail__muted-text">暂未开放</text>
      </t-cell>
    </view>
  </view>

  <view slot="footer" class="chat-detail__footer" wx:if="{{contact}}">
    <t-button theme="primary" block bindtap="goToChat">
      进入聊天
    </t-button>
    <t-button variant="outline" block bindtap="clearChatHistory">
      清空聊天记录
    </t-button>
    <t-button theme="danger" block bindtap="deleteContact">
      删除联系人
    </t-button>
  </view>
</page-layout>
