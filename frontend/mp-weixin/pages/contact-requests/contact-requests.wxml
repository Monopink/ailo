<page-layout
  screenState="{{pageLayoutData.screenModel.screenState}}"
  contentVariant="{{pageLayoutData.screenModel.contentVariant}}"
  refreshState="{{pageLayoutData.screenModel.refreshState}}"
  emptyMessage="{{pageLayoutData.emptyMessage}}"
  hasFooter="{{pageLayoutData.hasFooter}}">
  <t-navbar slot="header" left-arrow="{{true}}">
    <view slot="title" class="navbar-title">联系人申请</view>
  </t-navbar>
  <view slot="content">
    <view class="contact-requests" wx:if="{{requests.length}}">
      <t-cell
        wx:for="{{requests}}"
        wx:key="id"
        title="{{item.nickname}}"
        description="{{item.message}}">
        <app-avatar slot="image" src="{{item.avatar}}" size="large" shape="circle" />
        <view slot="note" class="contact-requests__actions">
          <t-button
            variant="outline"
            size="small"
            data-id="{{item.id}}"
            bindtap="handleReject">
            拒绝
          </t-button>
          <t-button
            theme="primary"
            size="small"
            data-id="{{item.id}}"
            bindtap="handleApprove">
            同意
          </t-button>
        </view>
      </t-cell>
    </view>
  </view>
</page-layout>
