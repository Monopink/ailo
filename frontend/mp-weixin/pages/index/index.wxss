@import '/styles/tdesign-theme.wxss';
@import '/styles/design-tokens.global.wxss';
@import '/styles/tag-tone.wxss';

.index-page__header {
  position: relative;
  overflow: hidden;
  background-color: transparent;

  --page-top-brand-fade-height: 156rpx;
}

.index-page__top-fade {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: var(--page-top-brand-fade-height);
  background: var(--page-top-brand-fade-gradient);
  pointer-events: none;
}

.index-page__header-main {
  position: relative;
  z-index: 1;
}

.index-page__large-title {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  background-color: transparent;
}

.index-page__wordmark {
  display: block;
  width: 143rpx;
}

.index-page__content {
  background-color: var(--color-bg-white);

  --td-bg-color-container: var(--color-bg-white);
}

.index-swipe-cell {
  --td-spacer-2: 0;
}

.index-swipe-cell__action {
  height: 100%;
  padding: 0 var(--space-md);
}

.index-swipe-cell__action--neutral {
  color: var(--color-text-secondary);
  background-color: var(--color-bg-muted);
}

.index-swipe-cell__action--theme {
  color: var(--color-text-on-brand);
  background-color: var(--color-primary);
}

.index-page__connection {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-sm);
  padding: var(--space-sm) var(--space-lg);
  background-color: var(--color-bg-secondary);
  border-bottom: 1rpx solid var(--color-separator);
}

.index-page__connection-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.index-page__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-md);
  width: 100%;
  height: 100%;
}

.index-page__empty-message {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: var(--line-height-base);
}

.index-page__empty-action {
  margin-top: var(--space-sm);
}

.index-page__empty-button {
  --td-button-medium-padding-horizontal: 56rpx;
  --td-button-medium-height: 88rpx;
}

.index-cell {
  --td-cell-vertical-padding: var(--space-md);
  --td-spacer-2: 0;
  --td-spacer-1: var(--space-list-avatar-gap);
  --index-cell-line-height: calc(var(--font-size-list-secondary) * 1.5);
  --index-cell-tag-gap: var(--space-list-tag-gap);
}

.index-cell__left {
  display: flex;
  align-items: center;
}

.index-cell__center-slot {
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
}

.index-cell__title-slot {
  min-width: 0;
  overflow: hidden;
  width: 100%;
}

.index-cell__description-slot {
  min-width: 0;
  overflow: hidden;
  width: 100%;
}

.index-cell__description {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
  min-height: calc(var(--index-cell-line-height) * 2);
  box-sizing: border-box;
}

.index-cell__title-row {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  min-width: 0;
  width: 100%;
}

.index-cell__tags-row {
  display: flex;
  align-items: center;
  height: var(--index-cell-line-height);
  min-width: 0;
  width: 100%;
  overflow-x: hidden;
  overflow-y: visible;
}

.index-cell__tags-track {
  display: flex;
  align-items: center;
  gap: var(--index-cell-tag-gap);
  min-width: 0;
  width: 100%;
  overflow-x: hidden;
  overflow-y: visible;
}

.index-cell__tag-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  max-width: 100%;
  padding: 0 var(--space-list-tag-horizontal);
  border-radius: var(--radius-full);
  font-size: var(--font-size-list-tag);
  line-height: var(--line-height-list-tag);
  color: var(--td-tag-primary-color, var(--color-text-secondary));
  background-color: var(--td-tag-primary-light-color, var(--color-bg-muted));
  white-space: nowrap;
  flex-shrink: 0;
}

.index-cell__tag-pill--overflow {
  color: var(--color-text-secondary);
  background-color: var(--color-bg-muted);
}

.index-cell__tag-pill-text {
  display: block;
  white-space: nowrap;
}

.index-tag-measure {
  position: fixed;
  top: -2000rpx;
  left: -2000rpx;
  z-index: -1;
  opacity: 0;
  pointer-events: none;
}

.index-tag-measure__item {
  margin-right: var(--index-cell-tag-gap);
}

.index-message-measure {
  position: fixed;
  top: -2000rpx;
  left: -2000rpx;
  z-index: -1;
  opacity: 0;
  pointer-events: none;
}

.index-message-measure__item {
  display: block;
  width: auto;
}

.index-cell__message-line {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  height: var(--index-cell-line-height);
  min-width: 0;
  width: 100%;
  overflow: hidden;
}

.index-cell__message-two-lines {
  display: flex;
  align-items: flex-start;
  gap: var(--space-xs);
  min-height: calc(var(--index-cell-line-height) * 2);
  min-width: 0;
  width: 100%;
  overflow: hidden;
}

.index-cell__message-badge--double {
  align-self: flex-end;
}

.index-cell__message-main {
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
}

.index-cell__message-stack {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.index-cell__message-text {
  display: block;
  width: 100%;
  min-width: 0;
  line-height: var(--index-cell-line-height);
}

.index-cell__message-text--single {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.index-cell__message-text--double {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-all;
}

.index-cell__message-badge {
  width: auto;
  min-width: var(--badge-size-lg);
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  flex-shrink: 0;
}

.index-cell__title {
  display: block;
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.index-cell__title-time {
  flex-shrink: 0;
}

.index-cell__badge {
  --td-badge-bg-color: var(--color-primary);
  --td-badge-text-color: var(--color-text-on-brand);

  min-width: var(--badge-size-lg);
  height: var(--badge-size-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 var(--space-xs);
  box-sizing: border-box;
  flex-shrink: 0;
}
