@import '/styles/tdesign-theme.wxss';
@import '/styles/design-tokens.global.wxss';

.invite-share {
  min-height: 100%;
  padding: var(--space-md) 0
    calc(
      var(--space-xxl) + var(--button-height-lg) + var(--button-height-lg) +
        var(--safe-area-inset-bottom)
    );
  box-sizing: border-box;
  background-color: rgb(188 34 39);
  background-image: linear-gradient(
      180deg,
      rgb(184 28 33) 0%,
      rgb(210 48 53) 18%,
      rgb(234 117 96) 34%,
      rgb(244 201 181) 48%,
      rgb(248 239 231) 62%,
      rgb(250 246 241) 100%
    ),
    radial-gradient(
      circle at 50% 22%,
      rgb(255 244 236 / 72%) 0%,
      rgb(255 244 236 / 72%) 22%,
      rgb(255 244 236 / 0%) 54%
    ),
    radial-gradient(circle at 16% 14%, rgb(255 198 174 / 34%) 0%, rgb(255 198 174 / 0%) 30%),
    radial-gradient(circle at 86% 16%, rgb(255 227 188 / 30%) 0%, rgb(255 227 188 / 0%) 30%),
    radial-gradient(circle at 18% 70%, rgb(255 235 221 / 38%) 0%, rgb(255 235 221 / 0%) 34%),
    radial-gradient(circle at 84% 66%, rgb(255 215 198 / 28%) 0%, rgb(255 215 198 / 0%) 34%),
    radial-gradient(circle at 52% 100%, rgb(255 255 255 / 34%) 0%, rgb(255 255 255 / 0%) 30%);
  background-repeat: no-repeat;
  background-size: 100% 100%;
}

@media (prefers-color-scheme: dark) {
  .invite-share {
    background-color: rgb(138 22 28);
    background-image: linear-gradient(
        180deg,
        rgb(150 24 30) 0%,
        rgb(150 24 30) 20%,
        rgb(132 50 54) 42%,
        rgb(66 42 46) 60%,
        rgb(24 24 28) 100%
      ),
      radial-gradient(
        circle at 50% 20%,
        rgb(255 220 208 / 12%) 0%,
        rgb(255 220 208 / 12%) 22%,
        rgb(255 220 208 / 0%) 52%
      ),
      radial-gradient(circle at 16% 14%, rgb(255 170 146 / 12%) 0%, rgb(255 170 146 / 0%) 28%),
      radial-gradient(circle at 86% 16%, rgb(255 210 174 / 10%) 0%, rgb(255 210 174 / 0%) 28%),
      radial-gradient(circle at 18% 70%, rgb(255 210 190 / 8%) 0%, rgb(255 210 190 / 0%) 34%),
      radial-gradient(circle at 84% 66%, rgb(255 226 210 / 8%) 0%, rgb(255 226 210 / 0%) 34%);
  }
}

.invite-share__content {
  padding: 0 var(--padding-page);
  box-sizing: border-box;
}

.invite-share__activity {
  margin: var(--space-sm) 0 calc(var(--space-md) + var(--space-xs));
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-xs);
  text-align: center;
}

.invite-share__activity-title {
  color: rgb(255 255 255);
  font-size: calc(var(--font-size-xxl) + var(--space-sm));
  line-height: var(--line-height-tight);
  font-weight: var(--font-weight-semibold);
  letter-spacing: 2rpx;
  text-shadow: 0 8rpx 24rpx rgb(90 8 12 / 22%);
}

.invite-share__activity-subtitle {
  max-width: 560rpx;
  color: rgb(255 247 240 / 88%);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-relaxed);
  white-space: normal;
  text-shadow: 0 4rpx 12rpx rgb(90 8 12 / 16%);
}

.invite-share__hero-art {
  position: relative;
  width: 100%;
  height: 356rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: calc(var(--space-xl) + var(--space-xs)) 0 calc(var(--space-xxl) + var(--space-sm));
}

.invite-share__hero-glow {
  position: absolute;
  border-radius: var(--radius-full);
  filter: blur(calc(var(--space-md) + var(--space-xs)));
}

.invite-share__hero-glow--red {
  left: 50%;
  top: 84rpx;
  width: 336rpx;
  height: 154rpx;
  background: rgb(150 20 24 / 22%);
  transform: translateX(-50%);
}

.invite-share__hero-glow--gold {
  left: 104rpx;
  top: 168rpx;
  width: 176rpx;
  height: 120rpx;
  background: rgb(255 214 158 / 32%);
}

.invite-share__hero-glow--pearl {
  right: 106rpx;
  top: 146rpx;
  width: 184rpx;
  height: 132rpx;
  background: rgb(255 245 237 / 28%);
}

.invite-share__hero-sheen {
  position: absolute;
  top: 86rpx;
  width: 88rpx;
  height: 188rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(180deg, rgb(255 255 255 / 26%) 0%, rgb(255 255 255 / 0%) 100%);
  opacity: 0.72;
  transform: rotate(22deg);
}

.invite-share__hero-sheen--left {
  left: 98rpx;
}

.invite-share__hero-sheen--right {
  right: 96rpx;
  opacity: 0.54;
  transform: rotate(-18deg);
}

.invite-share__hero-envelope {
  position: relative;
  width: 382rpx;
  height: 252rpx;
}

.invite-share__hero-shadow {
  position: absolute;
  left: 50%;
  bottom: -8rpx;
  width: 276rpx;
  height: 40rpx;
  border-radius: var(--radius-full);
  background: rgb(88 22 22 / 18%);
  filter: blur(12rpx);
  transform: translateX(-50%);
  z-index: 0;
}

.invite-share__hero-ticket {
  position: absolute;
  right: 6rpx;
  top: -10rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(
    180deg,
    rgb(255 236 192) 0%,
    rgb(255 205 118) 52%,
    rgb(247 172 58) 100%
  );
  transform: rotate(12deg);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 6rpx solid rgb(170 37 40 / 18%);
  box-shadow: 0 18rpx 36rpx rgb(116 24 24 / 20%);
  z-index: 6;
}

.invite-share__hero-ticket-text {
  color: rgb(116 28 24);
  font-size: 46rpx;
  line-height: 1;
  font-weight: var(--font-weight-bold);
}

.invite-share__hero-envelope-letter {
  position: absolute;
  left: 50%;
  top: 2rpx;
  width: 224rpx;
  height: 156rpx;
  padding: 24rpx 24rpx 0;
  border-radius: 28rpx 28rpx 18rpx 18rpx;
  background: linear-gradient(180deg, rgb(255 253 250) 0%, rgb(252 241 233) 100%);
  box-shadow:
    0 24rpx 42rpx rgb(100 18 22 / 14%),
    inset 0 2rpx 0 rgb(255 255 255 / 92%);
  box-sizing: border-box;
  transform: translateX(-50%) rotate(-5deg);
  z-index: 4;
}

.invite-share__hero-envelope-letter-head {
  width: 88rpx;
  height: 16rpx;
  border-radius: var(--radius-full);
  background: rgb(225 92 90 / 18%);
}

.invite-share__hero-envelope-letter-line {
  width: 100%;
  height: 10rpx;
  margin-top: 14rpx;
  border-radius: var(--radius-full);
  background: rgb(190 66 64 / 16%);
}

.invite-share__hero-envelope-letter-line--short {
  width: 72%;
}

.invite-share__hero-envelope-letter-line--wide {
  width: 86%;
}

.invite-share__hero-envelope-letter-chip {
  width: 92rpx;
  height: 28rpx;
  margin-top: 20rpx;
  margin-left: auto;
  border-radius: var(--radius-full);
  background: linear-gradient(180deg, rgb(255 221 170) 0%, rgb(248 191 94) 100%);
}

.invite-share__hero-envelope-back {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 0;
  height: 176rpx;
  border-radius: 30rpx;
  background: linear-gradient(180deg, rgb(245 123 111) 0%, rgb(220 72 68) 48%, rgb(176 33 39) 100%);
  box-shadow:
    0 18rpx 40rpx rgb(112 18 24 / 20%),
    inset 0 2rpx 0 rgb(255 255 255 / 18%);
  z-index: 1;
}

.invite-share__hero-envelope-flap {
  display: none;
}

.invite-share__hero-envelope-body {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 0;
  height: 176rpx;
  border-radius: 20rpx;
  background: transparent;
  overflow: hidden;
  z-index: 3;
}

.invite-share__hero-envelope-front {
  position: absolute;
  bottom: 0;
  width: 0;
  height: 0;
  filter: drop-shadow(0 6rpx 8rpx rgb(0 0 0 / 8%));
}

.invite-share__hero-envelope-front--left {
  left: 0;
  border-top: 132rpx solid transparent;
  border-right: 118rpx solid rgb(246 154 146);
  border-bottom: 44rpx solid rgb(238 122 118);
}

.invite-share__hero-envelope-front--right {
  right: 0;
  border-top: 132rpx solid transparent;
  border-left: 118rpx solid rgb(246 154 146);
  border-bottom: 44rpx solid rgb(238 122 118);
}

.invite-share__hero-envelope-front--center {
  display: none;
}

.invite-share__hero-envelope-seal {
  position: absolute;
  left: 50%;
  bottom: 28rpx;
  width: 58rpx;
  height: 58rpx;
  border-radius: var(--radius-full);
  background: radial-gradient(
      circle at 36% 34%,
      rgb(255 208 183 / 76%) 0%,
      rgb(255 208 183 / 0%) 32%
    ),
    linear-gradient(180deg, rgb(255 171 154) 0%, rgb(214 76 78) 100%);
  box-shadow: 0 8rpx 18rpx rgb(112 18 24 / 18%);
  transform: translateX(-50%);
  z-index: 5;
}

.invite-share__ticket-card {
  position: relative;
  padding: calc(var(--space-xl) + var(--space-xs)) calc(var(--padding-card) + var(--space-sm));
  border-radius: var(--radius-xl);
  border: 1rpx solid rgb(255 255 255 / 72%);
  background: linear-gradient(180deg, rgb(255 255 255 / 96%) 0%, rgb(253 247 241 / 98%) 100%);
  box-shadow:
    0 20rpx 44rpx rgb(116 52 44 / 12%),
    inset 0 2rpx 0 rgb(255 255 255 / 92%);
  overflow: hidden;
}

.invite-share__ticket-notch {
  position: absolute;
  top: 168rpx;
  width: calc(var(--space-lg) + var(--space-sm));
  height: calc(var(--space-lg) + var(--space-sm));
  border-radius: var(--radius-full);
  background: var(--color-bg-primary);
  border: 1rpx solid var(--color-border-light);
}

.invite-share__ticket-notch--left {
  left: calc((var(--space-lg) + var(--space-sm)) / -2);
}

.invite-share__ticket-notch--right {
  right: calc((var(--space-lg) + var(--space-sm)) / -2);
}

.invite-share__ticket-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-md);
}

.invite-share__ticket-head-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.invite-share__ticket-label {
  display: block;
  color: var(--color-text-primary);
  font-size: var(--font-size-lg);
  line-height: var(--line-height-tight);
  font-weight: var(--font-weight-semibold);
}

.invite-share__ticket-caption {
  color: rgb(123 106 101);
  font-size: var(--font-size-xs);
  line-height: var(--line-height-relaxed);
}

.invite-share__ticket-copy {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  min-width: 180rpx;
  height: calc(var(--button-height-md) - var(--space-xs));
  padding: var(--space-xs) var(--space-sm);
  border-radius: var(--radius-full);
  border: 1rpx solid rgb(224 210 202);
  background: rgb(255 251 247);
  box-sizing: border-box;
}

.invite-share__ticket-copy-text {
  color: var(--color-text-primary);
  font-size: var(--font-size-sm);
  line-height: 1;
  font-weight: var(--font-weight-medium);
}

.invite-share__ticket-dash {
  height: 1rpx;
  margin: var(--space-md) 0 calc(var(--space-xl) + var(--space-xs));
  background-image: linear-gradient(
    90deg,
    var(--color-border-base) 0%,
    var(--color-border-base) 50%,
    transparent 50%,
    transparent 100%
  );
  background-size: calc(var(--space-sm) + var(--space-xs)) 1rpx;
}

.invite-share__ticket-code {
  display: block;
  text-align: center;
  color: rgb(50 28 24);
  font-size: calc(var(--font-size-xxl) + var(--space-sm));
  line-height: 1;
  font-weight: var(--font-weight-bold);
  letter-spacing: var(--letter-spacing-xl);
  margin-bottom: var(--space-md);
}

.invite-share__ticket-copy-row {
  width: 100%;
  display: flex;
  justify-content: center;
}

.invite-share__ticket-copy--below {
  margin: 0 0 calc(var(--space-xl) + var(--space-xs));
}

.invite-share__ticket-foot {
  margin-top: calc(var(--space-lg) + var(--space-xs));
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.invite-share__ticket-tip {
  color: rgb(116 98 92);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-relaxed);
  text-align: center;
}

.invite-share__stats-card {
  margin-top: calc(var(--space-lg) + var(--space-xs));
  padding: var(--space-lg) var(--padding-card);
  border-radius: var(--radius-xl);
  border: 1rpx solid rgb(255 255 255 / 70%);
  background: linear-gradient(180deg, rgb(255 252 249 / 96%) 0%, rgb(252 247 242 / 96%) 100%);
  box-shadow:
    0 18rpx 40rpx rgb(116 52 44 / 10%),
    inset 0 2rpx 0 rgb(255 255 255 / 88%);
  min-height: 228rpx;
  box-sizing: border-box;
}

.invite-share__stats-title {
  color: var(--color-text-primary);
  font-size: var(--font-size-base);
  line-height: var(--line-height-tight);
  font-weight: var(--font-weight-medium);
}

.invite-share__stats-grid {
  margin-top: var(--space-md);
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: var(--space-sm);
}

.invite-share__stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: var(--space-xs);
  text-align: center;
}

.invite-share__stats-divider {
  width: 1rpx;
  background: var(--color-border-base);
}

.invite-share__stats-count {
  display: inline-flex;
  align-items: baseline;
  gap: var(--space-xs);
}

.invite-share__stats-count-number {
  color: rgb(56 30 28);
  font-size: calc(var(--font-size-xxl) + var(--space-xs));
  line-height: 1;
  font-weight: var(--font-weight-bold);
}

.invite-share__stats-count-label {
  color: var(--color-text-tertiary);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-relaxed);
  text-align: center;
}

.invite-share__stats-empty {
  margin-top: var(--space-md);
  min-height: 112rpx;
  border-radius: var(--radius-lg);
  background: rgb(255 249 244 / 92%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.invite-share__stats-empty-text {
  color: var(--color-text-tertiary);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-base);
}

.invite-share__section {
  margin-top: var(--space-lg);
  padding: var(--space-lg) var(--padding-card);
  border-radius: var(--radius-xl);
  border: 1rpx solid rgb(255 255 255 / 68%);
  background: linear-gradient(180deg, rgb(255 252 249 / 95%) 0%, rgb(252 247 242 / 95%) 100%);
  box-shadow:
    0 18rpx 36rpx rgb(116 52 44 / 9%),
    inset 0 2rpx 0 rgb(255 255 255 / 88%);
}

.invite-share__section--rules {
  margin-bottom: var(--space-md);
}

.invite-share__section-title {
  display: block;
  color: var(--color-text-primary);
  font-size: var(--font-size-lg);
  line-height: var(--line-height-tight);
  font-weight: var(--font-weight-semibold);
}

.invite-share__step-list {
  margin-top: var(--space-md);
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.invite-share__step-card {
  padding: var(--space-md);
  border-radius: var(--radius-lg);
  background: linear-gradient(180deg, rgb(255 248 242) 0%, rgb(254 244 236) 100%);
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.invite-share__step-index {
  color: var(--color-text-tertiary);
  font-size: var(--font-size-xs);
  line-height: var(--line-height-base);
  letter-spacing: var(--letter-spacing-lg);
}

.invite-share__step-title {
  color: var(--color-text-primary);
  font-size: var(--font-size-base);
  line-height: var(--line-height-base);
  font-weight: var(--font-weight-semibold);
}

.invite-share__step-text {
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-relaxed);
}

.invite-share__rule-list {
  margin-top: var(--space-md);
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.invite-share__rule-item {
  display: flex;
  align-items: flex-start;
  gap: var(--space-sm);
}

.invite-share__rule-dot {
  width: 12rpx;
  height: 12rpx;
  margin-top: 18rpx;
  border-radius: var(--radius-full);
  background: rgb(203 76 62);
  flex-shrink: 0;
}

.invite-share__rule-text {
  flex: 1;
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-relaxed);
}

.invite-share__footer {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  padding: var(--space-md) var(--padding-page) var(--space-sm);
  background: transparent;
  backdrop-filter: blur(calc(var(--navbar-glass-blur) + var(--space-xxs))) saturate(148%);
  border-top: 0;
  box-shadow: none;
}

@media (prefers-color-scheme: dark) {
  .invite-share__footer {
    background: transparent;
  }
}

.invite-share__action {
  width: 100%;
  height: var(--button-height-lg);
  line-height: var(--button-height-lg);
  border-radius: var(--radius-full);
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  box-sizing: border-box;
}

.invite-share__action::after {
  border: 0;
}

.invite-share__action--primary {
  border: 0;
  background: var(--color-primary);
  color: var(--color-text-on-brand);
  box-shadow: 0 16rpx 28rpx rgb(191 212 0 / 28%);
}

.invite-share__action--secondary {
  border: 1rpx solid rgb(255 255 255 / 72%);
  background: rgb(255 250 245 / 92%);
  color: var(--color-text-primary);
  box-shadow: 0 10rpx 22rpx rgb(116 52 44 / 8%);
}
