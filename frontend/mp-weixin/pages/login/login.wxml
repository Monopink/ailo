<page-layout
  screenState="{{pageLayoutData.screenModel.screenState}}"
  contentVariant="{{pageLayoutData.screenModel.contentVariant}}"
  refreshState="{{pageLayoutData.screenModel.refreshState}}"
  emptyMessage="{{pageLayoutData.emptyMessage}}"
  hasFooter="{{false}}"
  disableScroll="{{true}}">
  <view slot="content" class="login-page">
    <view class="login-bg"></view>
    <image
      wx:if="{{remoteBackgroundShouldLoad}}"
      class="login-bg-remote {{remoteBackgroundVisible ? 'login-bg-remote--visible' : ''}}"
      src="{{remoteBackgroundUrl}}"
      mode="aspectFill"
      bindload="handleRemoteBackgroundLoad"
      binderror="handleRemoteBackgroundError" />
    <view class="login-bottom-scrim"></view>

    <view class="login-content">
      <view class="login-hero">
        <image class="login-hero__wordmark" src="/assets/wordmark.svg" mode="aspectFit" />
        <text class="login-hero__slogan">让每次对话都被认真回应</text>
      </view>

      <view class="login-actions">
        <t-button
          class="login-actions__button"
          theme="primary"
          block
          open-type="getPhoneNumber"
          loading="{{wechatLoading}}"
          bindgetphonenumber="handleWeChatLogin">
          微信授权登录
        </t-button>
        <view class="login-legal">
          <text class="login-legal__text">登录代表您已阅读并同意</text>
          <text class="login-legal__link" bindtap="navigateToUserAgreement">用户使用协议</text>
          <text class="login-legal__text">、</text>
          <text class="login-legal__link" bindtap="navigateToPrivacyPolicy">隐私政策</text>
        </view>
        <text class="login-actions__hint">未注册手机号登录将自动注册</text>
      </view>
    </view>
  </view>
</page-layout>
