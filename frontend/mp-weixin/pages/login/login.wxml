<page-layout
  screenState="{{pageLayoutData.screenModel.screenState}}"
  contentVariant="{{pageLayoutData.screenModel.contentVariant}}"
  refreshState="{{pageLayoutData.screenModel.refreshState}}"
  emptyMessage="{{pageLayoutData.emptyMessage}}"
  hasFooter="{{false}}"
  disableScroll="{{true}}">
  <view slot="content" class="login-page">
    <view class="login-bg"></view>
    <image
      wx:if="{{remoteBackgroundShouldLoad}}"
      class="login-bg-remote {{remoteBackgroundVisible ? 'login-bg-remote--visible' : ''}}"
      src="{{remoteBackgroundUrl}}"
      mode="aspectFill"
      bindload="handleRemoteBackgroundLoad"
      binderror="handleRemoteBackgroundError" />
    <view class="login-bottom-scrim"></view>

    <view class="login-content">
      <view class="login-hero">
        <image class="login-hero__wordmark" src="/assets/wordmark.svg" mode="aspectFit" />
        <text class="login-hero__slogan">让每次对话都被认真回应</text>
      </view>

      <view class="login-actions">
        <block wx:if="{{privacyAccepted}}">
          <t-button
            class="login-actions__button"
            theme="primary"
            block
            open-type="getPhoneNumber"
            loading="{{wechatLoading}}"
            bindgetphonenumber="handleWeChatLogin">
            登录 / 注册
          </t-button>
        </block>
        <block wx:else>
          <t-button
            class="login-actions__button"
            theme="primary"
            block
            loading="{{wechatLoading}}"
            bindtap="handleLoginTapWithoutPrivacy">
            登录 / 注册
          </t-button>
        </block>
        <view class="login-legal">
          <t-checkbox
            checked="{{privacyAccepted}}"
            block="{{false}}"
            borderless="{{true}}"
            t-class="login-legal__checkbox"
            bindchange="handlePrivacyChange">
            <text class="login-legal__text">我已阅读并同意</text>
          </t-checkbox>
          <text class="login-legal__link" bindtap="navigateToUserAgreement">用户使用协议</text>
          <text class="login-legal__text">、</text>
          <text class="login-legal__link" bindtap="navigateToPrivacyPolicy">隐私政策</text>
        </view>
        <text class="login-actions__hint">未注册手机号登录将自动注册</text>
      </view>
    </view>

    <t-dialog
      visible="{{privacyDialogVisible}}"
      cancelBtn="{{privacyDialogCancelBtn}}"
      confirmBtn="{{privacyDialogConfirmBtn}}"
      bind:open-type-event="handlePrivacyDialogOpenTypeEvent"
      bind:open-type-error-event="handlePrivacyDialogOpenTypeError"
      bind:close="handlePrivacyDialogClose">
      <view slot="content" class="login-privacy-dialog">
        <text class="login-privacy-dialog__text">请先阅读并同意</text>
        <text class="login-privacy-dialog__link" bindtap="navigateToUserAgreement">《用户使用协议》</text>
        <text class="login-privacy-dialog__text">和</text>
        <text class="login-privacy-dialog__link" bindtap="navigateToPrivacyPolicy">《隐私政策》</text>
      </view>
    </t-dialog>
  </view>
</page-layout>
