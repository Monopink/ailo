@import '/styles/tdesign-theme.wxss';
@import '/styles/design-tokens.global.wxss';

.login-page {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: calc(var(--safe-area-inset-top) + var(--space-3xl)) var(--padding-page)
    calc(var(--safe-area-inset-bottom) + var(--space-xl));
  overflow: hidden;
  box-sizing: border-box;
}

.login-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: linear-gradient(
    165deg,
    var(--color-primary-lighter) 0%,
    var(--color-accent-light) 42%,
    var(--color-bg-secondary) 100%
  );
  opacity: 0.72;
  z-index: 0;
}

.login-bg-remote {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 0;
  opacity: 0;
  transition: opacity 280ms ease;
  pointer-events: none;
}

.login-bg-remote--visible {
  opacity: 0.92;
}

.login-bottom-scrim {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 46vh;
  z-index: 0;
  pointer-events: none;
  background: linear-gradient(
    to top,
    rgb(15 20 30 / 62%) 0%,
    rgb(15 20 30 / 30%) 46%,
    rgb(15 20 30 / 0%) 100%
  );
}

.login-content {
  position: relative;
  z-index: 1;
  flex: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  gap: var(--space-xl);
  padding: 0 var(--space-sm) calc(var(--safe-area-inset-bottom) + var(--space-lg));
  box-sizing: border-box;
}

.login-hero {
  width: 100%;
  max-width: 680rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-sm);
  margin-bottom: calc(var(--space-xxl) * 4);
}

.login-hero__wordmark {
  width: min(58vw, 420rpx);
  height: 84rpx;
  opacity: 0.96;
  filter: brightness(0) invert(1) drop-shadow(0 8rpx 24rpx rgb(0 0 0 / 28%));
}

.login-hero__slogan {
  max-width: 92%;
  text-align: center;
  font-size: var(--font-size-base);
  line-height: var(--line-height-base);
  color: rgb(255 255 255 / 78%);
  letter-spacing: var(--letter-spacing-sm);
  text-shadow: 0 2rpx 12rpx rgb(0 0 0 / 20%);
}

.login-actions {
  width: 100%;
  max-width: 680rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-sm);
}

.login-actions__button {
  width: 100%;
  margin-top: var(--space-xs);
}

.login-actions__secondary {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-xs) var(--space-md);
  border-radius: var(--radius-full);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-base);
  color: rgb(255 255 255 / 72%);
  user-select: none;
}

.login-actions__secondary-text {
  margin-right: 8rpx;
}

.login-actions__secondary-icon {
  display: block;
}

.login-legal {
  margin-top: var(--space-xs);
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  row-gap: 6rpx;
}

.login-legal__checkbox {
  --td-checkbox-bg-color: transparent;

  background: transparent;
}

.login-legal__text,
.login-legal__link {
  font-size: var(--font-size-xs);
  line-height: var(--line-height-base);
}

.login-legal__text {
  color: rgb(255 255 255 / 66%);
}

.login-legal__link {
  color: rgb(255 255 255 / 96%);
  text-decoration: underline;
  text-underline-offset: 4rpx;
}

.login-privacy-dialog {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
}

.login-privacy-dialog__text,
.login-privacy-dialog__link {
  font-size: var(--font-size-sm);
  line-height: var(--line-height-base);
  color: var(--color-text-secondary);
}

.login-privacy-dialog__link {
  color: var(--color-text-primary);
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

.login-actions__hint {
  font-size: var(--font-size-xs);
  color: rgb(255 255 255 / 54%);
  line-height: var(--line-height-base);
}

@media (prefers-color-scheme: dark) {
  .login-bg {
    opacity: 0.4;
  }

  .login-bg-remote--visible {
    opacity: 0.74;
  }

  .login-bottom-scrim {
    background: linear-gradient(
      to top,
      rgb(8 10 14 / 74%) 0%,
      rgb(8 10 14 / 40%) 46%,
      rgb(8 10 14 / 0%) 100%
    );
  }
}
