<page-layout
  screenState="{{pageLayoutData.screenModel.screenState}}"
  contentVariant="{{pageLayoutData.screenModel.contentVariant}}"
  refreshState="{{pageLayoutData.screenModel.refreshState}}"
  emptyMessage="{{pageLayoutData.emptyMessage}}"
  hasFooter="{{pageLayoutData.hasFooter}}">
  <t-navbar slot="header" left-arrow="{{true}}">
    <view slot="title" class="navbar-title">我的资料</view>
  </t-navbar>
  <view slot="content" class="profile-detail card-container">
    <button
      wx:if="{{canUseChooseAvatar}}"
      class="profile-detail__avatar"
      disabled="{{avatarUploading}}"
      hover-class="profile-detail__avatar--active"
      open-type="chooseAvatar"
      bindchooseavatar="onChooseWechatAvatar">
      <view class="profile-detail__avatar-image-wrap">
        <app-avatar
          class="profile-detail__avatar-image"
          src="{{profile ? profile.displayAvatar : ''}}"
          size="112rpx"
          shape="circle"
          mode="aspectFill"
          webp="{{true}}"
          lazy="{{false}}"
          bindload="onAvatarRenderSuccess"
          binderror="onAvatarRenderError" />
        <view class="profile-detail__avatar-edit-badge">
          <t-icon name="edit-1" size="var(--icon-xs)" color="var(--color-text-primary)" />
        </view>
      </view>
      <text class="profile-detail__avatar-hint">点击设置头像</text>
    </button>
    <view
      wx:else
      class="profile-detail__avatar"
      bindtap="editAvatar"
      hover-class="profile-detail__avatar--active">
      <view class="profile-detail__avatar-image-wrap">
        <app-avatar
          class="profile-detail__avatar-image"
          src="{{profile ? profile.displayAvatar : ''}}"
          size="112rpx"
          shape="circle"
          mode="aspectFill"
          webp="{{true}}"
          lazy="{{false}}"
          bindload="onAvatarRenderSuccess"
          binderror="onAvatarRenderError" />
        <view class="profile-detail__avatar-edit-badge">
          <t-icon name="edit-1" size="var(--icon-xs)" color="var(--color-text-primary)" />
        </view>
      </view>
      <text class="profile-detail__avatar-hint">点击设置头像</text>
    </view>

    <!-- Info groups - Using t-cell-group with card theme -->
    <view class="card-wrapper">
      <t-cell-group theme="card">
        <t-cell
          title="敲敲号"
          t-class-title="profile-cell__title"
          t-class-center="profile-detail__cell-center"
          arrow="{{profile ? !profile.displayUsername : true}}"
          hover="{{profile ? !profile.displayUsername : true}}"
          bindtap="editUsername">
          <text slot="note" class="profile-cell__note">{{profile ? profile.displayUsername : ''}}</text>
        </t-cell>
      </t-cell-group>
    </view>

    <view class="card-wrapper">
      <t-cell-group theme="card">
        <t-cell
          title="昵称"
          t-class-title="profile-cell__title"
          t-class-center="profile-detail__cell-center"
          arrow
          hover
          bindtap="editNickname">
          <text slot="note" class="profile-cell__note">{{profile ? profile.nickname : ''}}</text>
        </t-cell>

        <picker
          mode="selector"
          range="{{genderOptions}}"
          range-key="label"
          value="{{genderIndex}}"
          bindchange="onGenderChange">
          <t-cell
            title="性别"
            t-class-title="profile-cell__title"
            t-class-center="profile-detail__cell-center"
            arrow
            hover>
            <text slot="note" class="profile-cell__note">{{profile ? genderText : ''}}</text>
          </t-cell>
        </picker>
      </t-cell-group>
    </view>

    <view class="card-wrapper">
      <t-cell-group theme="card">
        <picker mode="region" level="city" disabled="{{fieldUpdating || avatarUploading}}" bindchange="onRegionChange">
          <t-cell
            title="地区"
            t-class-title="profile-cell__title"
            t-class-center="profile-detail__cell-center"
            arrow
            hover>
            <text slot="note" class="profile-cell__note">{{profile && profile.region ? profile.region : ''}}</text>
          </t-cell>
        </picker>

        <t-cell
          title="个性签名"
          t-class-title="profile-cell__title"
          arrow
          hover
          bindtap="editBio">
          <text wx:if="{{profile && profile.bio}}" slot="description" class="profile-cell__description">{{profile.bio}}</text>
        </t-cell>
      </t-cell-group>
    </view>
  </view>
</page-layout>
<canvas id="avatarExportCanvas2d" type="2d" class="profile-detail__avatar-export-canvas"></canvas>
<canvas
  canvas-id="avatarExportCanvasLegacy"
  class="profile-detail__avatar-export-canvas"></canvas>
