<page-layout
  style="--color-navbar-glass-bg: transparent; --color-bg-header-solid: transparent;"
  headerSolidMode="manual"
  headerSolid="{{false}}"
  screenState="{{pageLayoutData.screenModel.screenState}}"
  contentVariant="{{pageLayoutData.screenModel.contentVariant}}"
  refreshState="{{pageLayoutData.screenModel.refreshState}}"
  emptyMessage="{{pageLayoutData.emptyMessage}}"
  hasFooter="{{pageLayoutData.hasFooter}}">
  <t-navbar slot="header" left-arrow="{{false}}" />
  <view slot="content" class="profile">
    <!-- Header Section - Avatar and Name -->
    <view class="profile__header">
      <view
        class="profile__tap-target profile__tap-target--avatar"
        bindtap="navigateToProfileDetail"
        hover-class="profile__tap-target--hover"
        hover-stay-time="80">
        <app-avatar
          class="profile__avatar profile__avatar-image"
          src="{{profile ? profile.displayAvatar : ''}}"
          size="128rpx"
          shape="circle"
          mode="aspectFill"
          webp="{{true}}"
          lazy="{{false}}"
          bindload="onAvatarRenderSuccess"
          binderror="onAvatarRenderError" />
      </view>

      <view
        class="profile__tap-target profile__tap-target--name"
        bindtap="navigateToProfileDetail"
        hover-class="profile__tap-target--hover"
        hover-stay-time="80">
        <view class="profile__name-row">
          <text class="profile__name">{{profile ? profile.nickname : ''}}</text>
          <gender-badge wx:if="{{profile && profile.gender}}" gender="{{profile.gender}}" />
        </view>
      </view>

      <text wx:if="{{profile && profile.displayUsername}}" class="profile__qiao-id">敲敲号：{{profile.displayUsername}}</text>
    </view>

    <!-- Cards Section -->
    <view class="profile__cards card-container">

      <!-- Group 1: Profile & Security -->
      <view class="card-wrapper">
        <t-cell-group theme="card">
          <t-cell
            title="我的资料"
            t-class-left="profile__menu-left"
            t-class-title="profile__menu-title"
            arrow
            hover
            bindtap="navigateToProfileDetail">
            <view slot="left-icon" class="profile__menu-icon-wrap">
              <t-icon
                t-class="profile__menu-icon"
                name="user-circle"
                size="var(--font-size-lg)"
                color="#4d7bff" />
            </view>
          </t-cell>
          <t-cell
            title="账号与安全"
            t-class-left="profile__menu-left"
            t-class-title="profile__menu-title"
            arrow
            hover
            bindtap="navigateToAccountSecurity">
            <view slot="left-icon" class="profile__menu-icon-wrap">
              <t-icon
                t-class="profile__menu-icon"
                name="user-safety"
                size="var(--font-size-lg)"
                color="#ff8a00" />
            </view>
          </t-cell>
        </t-cell-group>
      </view>

      <!-- Group 2: Invitation -->
      <view class="card-wrapper">
        <t-cell-group theme="card">
          <t-cell
            wx:if="{{showInviteBindEntry}}"
            title="填写邀请码"
            t-class-left="profile__menu-left"
            t-class-title="profile__menu-title"
            arrow
            hover
            bindtap="navigateToInviteBind">
            <view slot="left-icon" class="profile__menu-icon-wrap">
              <t-icon
                t-class="profile__menu-icon"
                name="share"
                size="var(--font-size-lg)"
                color="#06b6d4" />
            </view>
          </t-cell>
          <t-cell
            title="邀请得联系人上限"
            t-class-left="profile__menu-left"
            t-class-title="profile__menu-title"
            arrow
            hover
            bindtap="navigateToInviteShare">
            <view slot="left-icon" class="profile__menu-icon-wrap">
              <t-icon
                t-class="profile__menu-icon"
                name="user-arrow-up"
                size="var(--font-size-lg)"
                color="#f43f5e" />
            </view>
          </t-cell>
        </t-cell-group>
      </view>

      <!-- Group 3: About -->
      <view class="card-wrapper">
        <t-cell-group theme="card">
          <t-cell
            title="关于"
            t-class-left="profile__menu-left"
            t-class-title="profile__menu-title"
            arrow
            hover
            bindtap="navigateToAbout">
            <view slot="left-icon" class="profile__menu-icon-wrap">
              <t-icon
                t-class="profile__menu-icon"
                name="info-circle"
                size="var(--font-size-lg)"
                color="#22c55e" />
            </view>
          </t-cell>
        </t-cell-group>
      </view>
    </view>

    <view wx:if="{{showBuildInfo && buildInfoText}}" class="profile__build-info">
      {{buildInfoText}}
    </view>
  </view>
</page-layout>
