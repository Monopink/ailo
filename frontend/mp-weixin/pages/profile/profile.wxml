<page-layout
  style="--color-navbar-glass-bg: transparent; --color-bg-header-solid: transparent;"
  headerSolidMode="manual"
  headerSolid="{{false}}"
  screenState="{{pageLayoutData.screenModel.screenState}}"
  contentVariant="{{pageLayoutData.screenModel.contentVariant}}"
  refreshState="{{pageLayoutData.screenModel.refreshState}}"
  emptyMessage="{{pageLayoutData.emptyMessage}}"
  hasFooter="{{pageLayoutData.hasFooter}}">
  <t-navbar slot="header" left-arrow="{{false}}" />
  <view slot="content" class="profile">
    <!-- Header Section - Avatar and Name -->
    <view class="profile__header">
      <t-avatar
        image="{{profile ? profile.displayAvatar : ''}}"
        size="128rpx"
        shape="circle"
        class="profile__avatar" />

      <view class="profile__name-row">
        <text class="profile__name">{{profile ? profile.nickname : ''}}</text>
        <gender-badge wx:if="{{profile && profile.gender}}" gender="{{profile.gender}}" />
      </view>

      <text wx:if="{{profile && profile.displayUsername}}" class="profile__qiao-id">敲敲号：{{profile.displayUsername}}</text>
    </view>

    <!-- Cards Section -->
    <view class="profile__cards card-container">

      <!-- Settings Card -->
      <view class="card-wrapper">
        <t-cell-group theme="card">
          <t-cell
            title="我的资料"
            t-class-left="profile__menu-left"
            t-class-title="profile__menu-title"
            arrow
            hover
            bindtap="navigateToProfileDetail">
            <view slot="left-icon" class="profile__menu-icon-wrap">
              <t-icon
                t-class="profile__menu-icon"
                name="user-circle"
                size="var(--font-size-lg)"
                color="#4d7bff" />
            </view>
          </t-cell>
          <t-cell
            title="账号与安全"
            t-class-left="profile__menu-left"
            t-class-title="profile__menu-title"
            arrow
            hover
            bindtap="navigateToAccountSecurity">
            <view slot="left-icon" class="profile__menu-icon-wrap">
              <t-icon
                t-class="profile__menu-icon"
                name="user-safety"
                size="var(--font-size-lg)"
                color="#ff8a00" />
            </view>
          </t-cell>
          <t-cell
            title="关于"
            t-class-left="profile__menu-left"
            t-class-title="profile__menu-title"
            arrow
            hover
            bindtap="navigateToAbout">
            <view slot="left-icon" class="profile__menu-icon-wrap">
              <t-icon
                t-class="profile__menu-icon"
                name="info-circle"
                size="var(--font-size-lg)"
                color="#22c55e" />
            </view>
          </t-cell>
        </t-cell-group>
      </view>
    </view>
  </view>
</page-layout>
