@import '/styles/tdesign-theme.wxss';
@import '/styles/design-tokens.global.wxss';
@import '/styles/profile-cells.wxss';

.setup-page {
  background-color: var(--color-bg-primary);
}

/* Avatar selection */
.setup-avatar {
  padding: var(--space-lg) 0 var(--space-md);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.setup-avatar__trigger {
  padding: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-sm);
  background-color: transparent;
  border: none;
  line-height: normal;
}

.setup-avatar__trigger--hover {
  opacity: 0.8;
}

.setup-avatar__trigger::after {
  border: none;
}

.setup-avatar__trigger[disabled] {
  opacity: 0.5;
}

.setup-avatar__image-wrap {
  position: relative;
}

.setup-avatar__image {
  width: 112rpx;
  height: 112rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background-color: var(--color-bg-secondary);
  display: block;
}

.setup-avatar__hint {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.setup-avatar__edit-badge {
  position: absolute;
  right: calc(var(--space-xs) * -1);
  bottom: calc(var(--space-xs) * -1);
  width: calc(var(--icon-xs) + var(--space-sm));
  height: calc(var(--icon-xs) + var(--space-sm));
  border-radius: var(--radius-full);
  border: 1px solid var(--color-separator);
  background-color: var(--color-bg-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  box-shadow: var(--shadow-xs);
}

/* Input fields */
.setup-input {
  min-width: 320rpx;
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  text-align: right;
}

.setup-input::placeholder {
  color: var(--color-text-placeholder);
}

.setup-textarea {
  display: block;
  width: 100%;
  min-height: 240rpx;
  margin-top: var(--space-sm);
  padding: 0;
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  background-color: transparent;
  border: none;
  line-height: var(--line-height-base);
  box-sizing: border-box;
}

.setup-textarea::placeholder {
  color: var(--color-text-placeholder);
}

/* Footer */
.setup-footer {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.setup-submit-button {
  width: 100%;
  min-height: 88rpx;
  padding: 0 var(--space-md);
  border-radius: var(--radius-lg);
  background-color: var(--color-primary);
  color: var(--color-white);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-medium);
  line-height: 88rpx;
  border: none;
}

.setup-submit-button--hover {
  opacity: 0.9;
}

.setup-submit-button[disabled] {
  opacity: 0.5;
}

.setup-submit-button::after {
  border: none;
}

.setup-avatar__export-canvas {
  position: absolute;
  width: 512rpx;
  height: 512rpx;
  left: -2000rpx;
  top: -2000rpx;
}
