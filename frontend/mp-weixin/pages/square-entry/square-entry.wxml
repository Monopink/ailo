<page-layout
  style="--color-bg-page: var(--color-bg-white); --color-bg-header-solid: var(--color-bg-white); --color-navbar-glass-bg: transparent;"
  screenState="{{pageLayoutData.screenModel.screenState}}"
  contentVariant="{{pageLayoutData.screenModel.contentVariant}}"
  refreshState="{{pageLayoutData.screenModel.refreshState}}"
  emptyMessage="{{pageLayoutData.emptyMessage}}"
  hasFooter="{{pageLayoutData.hasFooter}}">
  <view slot="header" class="square-entry-page__header">
    <view class="square-entry-page__header-top-fade" />
    <view class="square-entry-page__header-main">
      <t-navbar left-arrow="{{false}}" />
    </view>
  </view>

  <view slot="content" class="square-entry-page">
    <view class="page-large-title">
      <text class="page-large-title__text">发现</text>
      <text class="page-large-title__subtitle">发现你的专属朋友</text>
    </view>
    <view class="square-entry-list">
      <view
        wx:for="{{entryCards}}"
        wx:key="categoryKey"
        class="square-entry-card square-entry-card--{{item.themeKey}}"
        bindtap="handleCardTap"
        data-category-key="{{item.categoryKey}}">
        <view class="square-entry-card__icon">
          <t-icon
            name="{{item.iconName}}"
            size="var(--icon-sm)"
            color="var(--square-entry-card-icon-color-current, var(--square-entry-card-icon-color))" />
        </view>
        <view class="square-entry-card__content">
          <text class="square-entry-card__title">{{item.label}}</text>
          <text class="square-entry-card__desc">{{item.description}}</text>
        </view>
      </view>
    </view>
  </view>
</page-layout>
