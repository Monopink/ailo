@import '/styles/tdesign-theme.wxss';
@import '/styles/design-tokens.global.wxss';

.square-page {
  background-color: var(--color-bg-white);
}

.square-page__empty {
  width: 100%;
  min-height: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-xl) var(--padding-page);
  box-sizing: border-box;
}

.square-page__empty-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

/* Header - Always visible */
.square-header {
  background-color: var(--color-bg-white);
}

/* Category tabs */
.square-tabs {
  width: 100%;
  background-color: var(--color-bg-secondary);
  border-bottom: 1rpx solid var(--color-separator);
}

.square-tabs__list {
  display: inline-flex;
  gap: var(--space-md);
  padding: var(--space-md) var(--padding-page);
  min-width: 100%;
}

.square-tabs__item {
  padding: var(--space-xs) var(--space-md);
  border-radius: var(--radius-full);
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  background-color: var(--color-bg-tertiary);
  white-space: nowrap;
  transition: all var(--duration-fast) var(--ease-out);
}

.square-tabs__item--active {
  color: var(--color-text-on-brand);
  background-color: var(--color-primary);
  font-weight: var(--font-weight-medium);
}

.square-tabs__item--friend.square-tabs__item--active {
  color: var(--color-text-inverse);
  background: var(--square-entry-card-friend-gradient);
}

.square-tabs__item--love.square-tabs__item--active {
  color: var(--color-text-inverse);
  background: var(--square-entry-card-love-gradient);
}

.square-tabs__item--talk.square-tabs__item--active {
  color: var(--color-text-inverse);
  background: var(--square-entry-card-talk-gradient);
}

.square-tabs__item--bestie.square-tabs__item--active {
  color: var(--color-text-inverse);
  background: var(--square-entry-card-bestie-gradient);
}

.square-tabs__item--hobby.square-tabs__item--active {
  color: var(--color-text-inverse);
  background: var(--square-entry-card-hobby-gradient);
}

/* Contact list - iOS style direct list */
.square-list {
  background-color: var(--color-bg-secondary);
  margin-top: var(--space-md);
}

.square-item {
  transition: background-color var(--duration-fast) var(--ease-out);
}

.square-item__header {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
}

.square-item__name {
  font-weight: var(--font-weight-medium);
}

.square-item__bio {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.square-item__button {
  flex-shrink: 0;
  min-width: 120rpx;
}
