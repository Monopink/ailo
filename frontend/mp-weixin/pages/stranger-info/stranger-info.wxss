@import '/styles/tdesign-theme.wxss';
@import '/styles/design-tokens.global.wxss';
@import '/styles/profile-cells.wxss';

/* Stranger Info Page */
.stranger-info {
  background-color: var(--color-bg-primary);
  height: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.stranger-info__body {
  min-height: 100%;
  flex: 1;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* Header Section - Avatar and Name */
.stranger-info__header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-xl) var(--space-md) var(--space-lg);
}

.stranger-info__avatar {
  margin-bottom: var(--space-md);
}

.stranger-info__name-row {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  margin-top: var(--space-xs);
  margin-bottom: var(--space-xs);
}

.stranger-info__name {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
}

.stranger-info__qiao-id {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-xs);
}

.stranger-info__category {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

/* Cards Section */
.stranger-info__cards {
  margin-top: var(--space-md);
}

.stranger-info__actions {
  margin-top: auto;
  padding: var(--space-xl) var(--padding-page) var(--space-md);
  padding-bottom: calc(var(--space-md) + env(safe-area-inset-bottom));
}
