<page-layout
  screenState="{{pageLayoutData.screenModel.screenState}}"
  contentVariant="{{pageLayoutData.screenModel.contentVariant}}"
  refreshState="{{pageLayoutData.screenModel.refreshState}}"
  emptyMessage="{{pageLayoutData.emptyMessage}}"
  hasFooter="{{pageLayoutData.hasFooter}}">
  <t-navbar slot="header" left-arrow="{{true}}">
    <view slot="title" class="navbar-title">关于</view>
  </t-navbar>
  <view slot="content" class="about card-container">
    <view class="card-wrapper">
      <t-cell-group theme="card">
        <t-cell
          title="用户协议"
          arrow
          hover
          bindtap="navigateToUserAgreement" />
        <t-cell
          title="隐私政策"
          arrow
          hover
          bindtap="navigateToPrivacyPolicy" />
        <t-cell
          title="联系我们"
          arrow
          hover
          bindtap="navigateToContactUs" />
      </t-cell-group>
    </view>

    <t-dialog
      visible="{{officialAccountFallbackVisible}}"
      confirmBtn="{{officialAccountFallbackConfirmBtn}}"
      cancelBtn="{{officialAccountFallbackCancelBtn}}"
      bind:confirm="handleOfficialAccountFallbackConfirm"
      bind:cancel="handleOfficialAccountFallbackCancel"
      bind:close="handleOfficialAccountFallbackClose">
      <view slot="content" class="official-account-fallback">
        <view class="official-account-fallback__header">
          <text class="official-account-fallback__title">关注公众号</text>
          <text class="official-account-fallback__subtitle">长按识别二维码关注</text>
        </view>

        <image
          class="official-account-fallback__qrcode"
          src="{{officialAccountQrCodeUrl}}"
          mode="aspectFit"
          show-menu-by-longpress="{{true}}" />

        <view class="official-account-fallback__tip">
          <text>公众号：敲敲AI</text>
        </view>
      </view>
    </t-dialog>
  </view>
</page-layout>
