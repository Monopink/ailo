@import '/styles/tdesign-theme.wxss';
@import '/styles/design-tokens.global.wxss';

page {
  background-color: var(--color-bg-white);
}

/* Chat Content Container */
.chat-page__content {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  position: relative;
  background-color: var(--color-bg-white);
}

/* Chat Header (Navbar) */
.chat-page__header {
  /* Ensure t-navbar stays transparent; background is handled by page-layout via CSS variables. */
  --td-navbar-bg-color: transparent;
  --td-navbar-background: transparent;
}

.chat-page__header--solid {
  border-bottom: 1rpx solid var(--color-separator);
}

/* Chat Navbar Title */
.chat-navbar__title {
  min-width: 0;
  max-width: 100%;
}

.chat-navbar__title-text {
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chat-navbar__typing-text {
  color: var(--color-text-placeholder);
}

/* Messages Scroll View */
.chat-page__messages {
  flex: 1;
  height: 0; /* For flex child */
  display: flex;
  flex-direction: column;
  gap: 0;
  padding: 0 var(--space-md);
  background-color: transparent;
  padding-bottom: calc(
    var(--chat-footer-height) + var(--chat-keyboard-offset, 0rpx) +
      var(--chat-safe-area-inset-bottom, var(--safe-area-inset-bottom))
  );
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

.chat-page__messages--with-emoji-panel {
  padding-bottom: calc(
    var(--chat-footer-height) + var(--emoji-panel-height) + var(--chat-keyboard-offset, 0rpx) +
      var(--chat-safe-area-inset-bottom, var(--safe-area-inset-bottom))
  );
}

.chat-page__footer {
  display: flex;
  flex-direction: column;
  width: 100%;
}

.chat-ai-watermark {
  position: absolute;
  left: 50%;
  bottom: calc(
    var(--chat-footer-height) + var(--chat-safe-area-inset-bottom, var(--safe-area-inset-bottom)) +
      var(--space-sm)
  );
  transform: translateX(-50%);
  z-index: 0;
  padding: 0 var(--space-md);
  color: var(--color-text-placeholder);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-base);
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  pointer-events: none;
}

/* Timestamp */
.chat-timestamp {
  align-self: center;
  padding: var(--space-xs) var(--space-sm);
  font-size: var(--font-size-sm);
  color: var(--color-text-placeholder);
  line-height: var(--line-height-base);
  text-align: center;
  background-color: var(--color-bg-white);
  border-radius: var(--radius-sm);
}

/* Info Message */
.chat-info-msg {
  align-self: center;
  padding: var(--space-xs) var(--space-sm);
  font-size: var(--font-size-sm);
  color: var(--color-text-placeholder);
  line-height: var(--line-height-base);
  text-align: center;
  background-color: var(--color-bg-white);
  border-radius: var(--radius-sm);
}

/* Message Row */
.msg-row {
  display: flex;
  align-items: flex-start;
  gap: var(--space-sm);
}

.msg-row + .msg-row {
  margin-top: var(--space-md);
}

.chat-info-msg + .msg-row {
  margin-top: var(--space-md);
}

.msg-row-me {
  justify-content: flex-end;
}

.msg-row-other {
  justify-content: flex-start;
}

/* Avatar */
.msg-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: auto;
  height: auto;
  min-width: var(--avatar-sm);
  min-height: var(--avatar-sm);
  overflow: visible;
  margin-top: 0;
}

/* Message Status Icon (Failed) */
.msg-status-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: center;
  width: var(--icon-sm);
  height: var(--icon-sm);
  color: var(--color-error);
  flex-shrink: 0;
  margin-top: 0;
}

.msg-status-icon__icon {
  color: var(--color-error);
}

/* Message Bubble */
.msg-bubble {
  padding: var(--space-sm) var(--space-sm);
  border-radius: var(--radius-bubble);
  max-width: var(--message-bubble-max-width);
  word-wrap: break-word;
  box-sizing: border-box;
}

.msg-bubble-me {
  background-color: var(--color-primary-light);
  color: var(--color-text-on-brand);
  border-radius: var(--radius-bubble) var(--radius-xs) var(--radius-bubble) var(--radius-bubble);
}

.msg-bubble-other {
  background-color: var(--color-bg-muted);
  color: var(--color-text-primary);
  border-radius: var(--radius-xs) var(--radius-bubble) var(--radius-bubble) var(--radius-bubble);
}

.msg-text {
  font-size: var(--font-size-base);
  line-height: var(--line-height-base);
  white-space: pre-wrap;
}

/* Chat Footer - Input Bar */
.chat-footer {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-sm) var(--space-md);
  background-color: var(--color-bg-muted);
  box-sizing: border-box;
  width: 100%;
}

/* Emoji Button */
.chat-footer__emoji-btn {
  width: var(--button-height-sm);
  height: var(--button-height-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: opacity var(--duration-fast) ease;
}

.chat-footer__emoji-btn:active {
  opacity: 0.6;
}

.chat-footer__emoji-icon {
  width: var(--icon-md);
  height: var(--icon-md);
}

/* Input Wrapper */
.chat-footer__input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  min-height: var(--chat-input-height);
  padding: 0 var(--space-md);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-white);
  border: 1rpx solid var(--color-border-base);
}

.chat-footer__input {
  width: 100%;
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  line-height: var(--line-height-base);
}

.chat-footer__input-placeholder {
  color: var(--color-text-placeholder);
}

/* Send Button - Circular WeChat Style */
.chat-footer__send-button {
  width: var(--button-height-sm);
  height: var(--button-height-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 50%;
  background-color: var(--color-glass-card-bg);
  transition: all var(--duration-fast) var(--ease-out);
}

.chat-footer__send-button--active {
  background-color: var(--color-primary);
}

.chat-footer__send-button:active {
  transform: scale(0.95);
}

/* Send Icon - SVG Arrow */
.chat-footer__send-icon {
  width: var(--icon-sm);
  height: var(--icon-sm);
  transition: opacity var(--duration-fast) ease;
}

.chat-footer__send-icon--active {
  /* Active icon uses a dedicated dark glyph for brand-yellow button background */
}

/* Scroll Anchor */
.chat-scroll-anchor {
  height: var(--space-md);
  width: 100%;
}

/* Emoji Panel */
.chat-emoji-panel {
  height: var(--emoji-panel-height);
  background-color: var(--color-bg-secondary);
  border-top: 1rpx solid var(--color-separator);
  box-shadow: var(--shadow-md);
  overflow-y: auto;
  box-sizing: border-box;
  width: 100%;
}

.chat-emoji-panel__list {
  padding: var(--space-md);
  display: flex;
  flex-wrap: wrap;
  align-content: flex-start;
  gap: var(--space-sm);
}

.chat-emoji-panel__item {
  width: var(--emoji-item-size);
  height: var(--emoji-item-size);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-xxl);
  border-radius: var(--radius-xs);
  transition: background-color var(--duration-fast) ease;
}

.chat-emoji-panel__item:active {
  background-color: var(--color-bg-input);
}
