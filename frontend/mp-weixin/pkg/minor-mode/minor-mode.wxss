@import '/styles/tdesign-theme.wxss';
@import '/styles/design-tokens.global.wxss';

.minor-mode {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
  padding: 0 var(--padding-page);
  background-color: var(--color-bg-primary);
  box-sizing: border-box;
}

.minor-mode__content {
  flex: 1;
  width: 100%;
  min-height: 0;
  padding: calc(var(--space-xxl) + var(--space-lg)) 0 var(--space-xl);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-md);
  text-align: center;
}

.minor-mode__title {
  display: block;
  color: var(--color-text-primary);
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  line-height: var(--line-height-tight);
}

.minor-mode__hint {
  display: block;
  color: var(--color-text-secondary);
  font-size: var(--font-size-base);
  line-height: var(--line-height-relaxed);
  max-width: 560rpx;
  text-align: center;
}

.minor-mode__intro-list {
  width: 100%;
  max-width: 560rpx;
  margin-top: var(--space-sm);
  padding: 0 var(--space-md);
  box-sizing: border-box;
}

.minor-mode__intro-item {
  display: flex;
  align-items: flex-start;
  gap: var(--space-sm);
}

.minor-mode__intro-item + .minor-mode__intro-item {
  margin-top: var(--space-md);
}

.minor-mode__intro-dot {
  width: 12rpx;
  height: 12rpx;
  margin-top: 21rpx;
  border-radius: 999rpx;
  background-color: var(--color-primary-dark);
  flex-shrink: 0;
}

.minor-mode__intro-text {
  flex: 1;
  color: var(--color-text-secondary);
  font-size: var(--font-size-base);
  line-height: var(--line-height-relaxed);
  text-align: left;
}

.minor-mode__pin-panel {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-sm);
  width: 100%;
  margin-top: var(--space-sm);
}

.minor-mode__pin-cell {
  width: 108rpx;
  height: 120rpx;
  border: 1rpx solid var(--color-separator);
  border-radius: var(--radius-lg);
  background-color: var(--color-bg-white);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.minor-mode__pin-cell--active {
  border-color: var(--color-primary);
}

.minor-mode__pin-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background-color: var(--color-text-primary);
}

.minor-mode__pin-hidden-input {
  position: absolute;
  width: 2rpx;
  height: 2rpx;
  opacity: 0;
  pointer-events: none;
}

.minor-mode__footer {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}
