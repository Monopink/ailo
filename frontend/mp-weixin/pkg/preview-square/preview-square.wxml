<page-layout
  style="--color-bg-page: var(--color-bg-white); --color-bg-header-solid: var(--color-bg-white); --color-bg-footer-fixed: var(--color-tabbar-glass-bg); --footer-glass-blur: var(--tabbar-glass-blur); --color-navbar-glass-bg: transparent;"
  screenState="{{pageLayoutData.screenModel.screenState}}"
  contentVariant="{{pageLayoutData.screenModel.contentVariant}}"
  refreshState="{{pageLayoutData.screenModel.refreshState}}"
  emptyMessage="{{pageLayoutData.emptyMessage}}"
  hasFooter="{{pageLayoutData.hasFooter}}"
  fixedFooter="{{true}}">
  <view slot="header" class="square-entry-page__header">
    <view class="square-entry-page__header-top-fade" />
    <view class="square-entry-page__header-main">
      <t-navbar left-arrow="{{false}}" />
    </view>
  </view>

  <view slot="empty" class="square-page__empty">
    <text class="square-page__empty-text">{{pageLayoutData.emptyMessage}}</text>
  </view>

  <view slot="content" class="square-entry-page">
    <view class="page-large-title">
      <text class="page-large-title__text">发现</text>
      <text class="page-large-title__subtitle">发现你的专属 AI 朋友</text>
    </view>
    <view class="square-entry-list">
      <view
        wx:for="{{entryCards}}"
        wx:key="categoryKey"
        class="square-entry-card square-entry-card--{{item.themeKey}}"
        bindtap="handleCardTap"
        data-category-key="{{item.categoryKey}}">
        <view class="square-entry-card__icon">
          <t-icon
            name="{{item.iconName}}"
            size="var(--icon-sm)"
            color="var(--square-entry-card-icon-color-current, var(--square-entry-card-icon-color))" />
        </view>
        <view class="square-entry-card__content">
          <text class="square-entry-card__title">{{item.label}}</text>
          <text class="square-entry-card__desc">{{item.description}}</text>
        </view>
      </view>
    </view>
  </view>

  <view slot="footer" class="preview-tabbar theme-scope">
    <view
      wx:for="{{tabItems}}"
      wx:key="key"
      class="preview-tabbar__item {{activeTabKey === item.key ? 'preview-tabbar__item--active' : ''}}"
      data-key="{{item.key}}"
      bindtap="handleTabTap">
      <image
        class="preview-tabbar__icon"
        src="{{activeTabKey === item.key ? item.activeIcon : item.icon}}"
        mode="aspectFit"
        style="width: {{item.iconSize}}; height: {{item.iconSize}};" />
      <text class="preview-tabbar__text">{{item.label}}</text>
    </view>
  </view>
</page-layout>
