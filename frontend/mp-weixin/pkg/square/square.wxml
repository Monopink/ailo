<page-layout
  style="--color-bg-page: var(--color-bg-white); --color-bg-header-solid: var(--color-bg-white);"
  screenState="{{pageLayoutData.screenModel.screenState}}"
  contentVariant="{{pageLayoutData.screenModel.contentVariant}}"
  refreshState="{{pageLayoutData.screenModel.refreshState}}"
  lowerThreshold="{{200}}"
  enableContentRefresh="{{false}}"
  bind:contentreachbottom="handleContentReachBottom"
  emptyMessage="{{pageLayoutData.emptyMessage}}"
  hasFooter="{{pageLayoutData.hasFooter}}">
  <view slot="header" class="square-header">
    <t-navbar left-arrow="{{true}}">
      <view slot="title" class="navbar-title">发现</view>
    </t-navbar>
    <scroll-view
      wx:if="{{!minorModeDiscoveryBlocked}}"
      scroll-x
      class="square-tabs"
      show-scrollbar="{{false}}">
      <view class="square-tabs__list">
        <view
          wx:for="{{categories}}"
          wx:key="categoryKey"
          class="square-tabs__item square-tabs__item--{{item.themeKey}} {{currentCategoryKey === item.categoryKey ? 'square-tabs__item--active' : ''}}"
          bindtap="selectCategory"
          data-category-key="{{item.categoryKey}}">
          {{item.label}}
        </view>
      </view>
    </scroll-view>
    <view wx:if="{{!minorModeDiscoveryBlocked}}" class="square-refresh-bar">
      <text class="square-refresh-bar__text">{{refreshInfoText}}</text>
    </view>
  </view>

  <view slot="blank" class="square-page__blank">
    <text class="square-page__blank-text">{{blankMessage}}</text>
  </view>

  <view slot="empty" class="square-page__empty">
    <text class="square-page__empty-text">{{pageLayoutData.emptyMessage}}</text>
  </view>

  <view slot="content" class="square-page">
    <view class="square-list">
      <view
        wx:for="{{contacts}}"
        wx:key="qiao_id"
        class="square-item list-row"
        bindtap="handleContactTap"
        data-id="{{item.qiao_id}}">
        <app-avatar
          src="{{item.avatar_url}}"
          size="medium"
          shape="circle"
          class="list-row__avatar" />

        <view class="list-row__info">
          <view class="square-item__header">
            <text class="square-item__name list-text-primary">{{item.nickname}}</text>
            <gender-badge wx:if="{{item.gender}}" gender="{{item.gender}}" />
          </view>
          <view wx:if="{{item.tags.length}}" class="square-item__tags">
            <tag-pills tags="{{item.tags}}" />
          </view>
          <text wx:if="{{item.bio}}" class="square-item__bio list-text-secondary">{{item.bio}}</text>
          <text wx:if="{{item.region}}" class="square-item__region list-text-secondary">{{item.region}}</text>
        </view>
      </view>

      <view wx:if="{{!loadingMore && !hasMore && contacts.length > 0}}" class="square-list__end">
        <text class="square-list__end-text">已经到底啦，待会再来刷新试试~</text>
      </view>
    </view>
  </view>
</page-layout>
