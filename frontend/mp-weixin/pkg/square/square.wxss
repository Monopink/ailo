@import '/styles/tdesign-theme.wxss';
@import '/styles/design-tokens.global.wxss';

.square-page {
  background-color: var(--color-bg-white);
}

.square-page__empty {
  width: 100%;
  min-height: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-xl) var(--padding-page);
  box-sizing: border-box;
}

.square-page__empty-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.square-page__blank {
  width: 100%;
  min-height: calc(100vh - 220rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-xl) var(--padding-page);
  box-sizing: border-box;
}

.square-page__blank-text {
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-relaxed);
  text-align: center;
}

/* Header - Always visible */
.square-header {
  background-color: var(--color-bg-white);
}

/* Category tabs */
.square-tabs {
  width: 100%;
  background-color: var(--color-bg-secondary);
  border-bottom: 1rpx solid var(--color-separator);
}

.square-refresh-bar {
  padding: var(--space-sm) var(--padding-page);
  border-bottom: 1rpx solid var(--color-separator);
  background-color: var(--color-bg-primary);
}

.square-refresh-bar__text {
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-base);
}

.square-tabs__list {
  display: inline-flex;
  gap: var(--space-md);
  padding: var(--space-md) var(--padding-page);
  min-width: 100%;
}

.square-tabs__item {
  --square-tabs-active-bg: var(--color-primary);
  --square-tabs-active-color: var(--color-text-on-brand);

  padding: var(--space-xs) var(--space-md);
  border-radius: var(--radius-full);
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  background-color: var(--color-bg-tertiary);
  white-space: nowrap;
  transition: all var(--duration-fast) var(--ease-out);
}

.square-tabs__item--active {
  color: var(--square-tabs-active-color);
  background: var(--square-tabs-active-bg);
  font-weight: var(--font-weight-medium);
}

.square-tabs__item--blue {
  --square-tabs-active-bg: var(--square-entry-card-blue-solid);
  --square-tabs-active-color: var(--color-text-inverse);
}

.square-tabs__item--cyan {
  --square-tabs-active-bg: var(--square-entry-card-cyan-solid);
  --square-tabs-active-color: var(--color-text-inverse);
}

.square-tabs__item--teal {
  --square-tabs-active-bg: var(--square-entry-card-teal-solid);
  --square-tabs-active-color: var(--color-text-inverse);
}

.square-tabs__item--green {
  --square-tabs-active-bg: var(--square-entry-card-green-solid);
  --square-tabs-active-color: var(--color-text-inverse);
}

.square-tabs__item--lime {
  --square-tabs-active-bg: var(--square-entry-card-lime-solid);
  --square-tabs-active-color: var(--square-entry-card-title-color-inverse);
}

.square-tabs__item--yellow {
  --square-tabs-active-bg: var(--square-entry-card-yellow-solid);
  --square-tabs-active-color: var(--square-entry-card-title-color-inverse);
}

.square-tabs__item--orange {
  --square-tabs-active-bg: var(--square-entry-card-orange-solid);
  --square-tabs-active-color: var(--color-text-inverse);
}

.square-tabs__item--purple {
  --square-tabs-active-bg: var(--square-entry-card-purple-solid);
  --square-tabs-active-color: var(--color-text-inverse);
}

.square-tabs__item--pink {
  --square-tabs-active-bg: var(--square-entry-card-pink-solid);
  --square-tabs-active-color: var(--color-text-inverse);
}

.square-tabs__item--magenta {
  --square-tabs-active-bg: var(--square-entry-card-magenta-solid);
  --square-tabs-active-color: var(--color-text-inverse);
}

.square-tabs__item--beige {
  --square-tabs-active-bg: var(--square-entry-card-beige-solid);
  --square-tabs-active-color: var(--square-entry-card-title-color-inverse);
}

.square-tabs__item--charcoal {
  --square-tabs-active-bg: var(--square-entry-card-charcoal-gradient);
  --square-tabs-active-color: var(--square-entry-card-title-color);
}

/* Contact list - iOS style direct list */
.square-list {
  background-color: var(--color-bg-secondary);
  margin-top: var(--space-md);
}

.square-list__end {
  padding: var(--space-lg) var(--padding-page);
  display: flex;
  justify-content: center;
}

.square-list__end-text {
  color: var(--color-text-placeholder);
  font-size: var(--font-size-sm);
}

.square-item {
  transition: background-color var(--duration-fast) var(--ease-out);
}

.square-item__header {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
}

.square-item__name {
  font-weight: var(--font-weight-medium);
}

.square-item__bio {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.square-item__tags {
  margin-top: var(--space-xs);
  width: 100%;
  min-width: 0;
}

.square-item__button {
  flex-shrink: 0;
  min-width: 120rpx;
}
