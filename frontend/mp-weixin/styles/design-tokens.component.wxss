/**
 * Design Tokens - WeChat MiniProgram Design System
 *
 * Design Philosophy: Gentle, Clean, Modern
 * - Inspired by iOS design language with WeChat's simplicity
 * - Subtle shadows and rounded corners for a soft feel
 * - Generous spacing for breathing room
 * - Muted colors for a calm, professional appearance
 *
 * Technical Specs:
 * - Screen width: 750rpx (iPhone 6 as base)
 * - Spacing base: 8rpx (all spacing must be multiples of 8)
 * - Primary color: #E5FF00 (Brand Yellow)
 *
 * IMPORTANT: All page styles MUST reference these variables.
 * DO NOT hardcode any color, spacing, font-size, or border-radius values.
 */

.theme-scope {
  /* ========================================
     Color System - Gentle & Muted Palette
     ======================================== */

  /* Primary Colors - Brand Yellow with interaction shades */
  --color-primary: #e5ff00; /* Brand yellow - primary actions */
  --color-primary-light: #f1ff80; /* Soft yellow - light emphasis backgrounds */
  --color-primary-lighter: #fbffd6; /* Very light yellow - subtle backgrounds */
  --color-primary-dark: #bfd400; /* Dark yellow-green - pressed state */

  /* Accent Colors - Subtle and warm */
  --color-accent: #ffc300; /* Warm yellow - highlights */
  --color-accent-light: #fff4d9; /* Very light yellow - subtle highlights */

  /* Neutral Colors - Background (iOS-inspired layering) */
  --color-bg-primary: #fafafa; /* Default page background (light gray) */
  --color-bg-page: var(--color-bg-primary); /* Page layout background */
  --color-bg-muted: #f5f5f5; /* Foreground gray surface on white pages */
  --color-bg-secondary: #ffffff; /* Elevated surface (cards, navbar, tabbar) */
  --color-bg-tertiary: #fafafa; /* Tertiary background (subtle distinction) */
  --color-bg-white: #ffffff; /* Pure white for special pages */
  --color-bg-input: #eeeeee; /* Input field background on white pages */
  --color-bg-hover: #f0f0f0; /* Hover state background */
  --color-bg-disabled: #f5f5f5; /* Disabled state background */
  --color-bg-mask: rgba(0, 0, 0, 0.4); /* Modal mask overlay (softer) */
  /* Single source of truth for glass surfaces used by navbar/tabbar/fixed footers. */
  --color-navbar-glass-bg-base: rgba(247, 247, 247, 0.68);
  --color-navbar-glass-bg: var(--color-navbar-glass-bg-base); /* Glass navbar background */
  --color-tabbar-glass-bg: transparent; /* Glass tabbar background */
  --color-mask-solid: #000000; /* Mask solid color */
  --color-glass-card-bg: rgba(255, 255, 255, 0.8); /* Glass card background */
  --color-glass-card-border: rgba(255, 255, 255, 0.5); /* Glass card border */
  --color-overlay-strong: rgba(255, 255, 255, 0.85); /* Light overlay stroke */
  --color-overlay-muted: rgba(0, 0, 0, 0.25); /* Dark overlay stroke */

  /* Neutral Colors - Text (softer blacks, warmer grays) */
  --color-text-primary: #1a1a1a; /* Primary text (soft black) */
  --color-text-secondary: #666666; /* Secondary text (medium gray) */
  --color-text-tertiary: #999999; /* Tertiary text (light gray) */
  --color-text-quaternary: #c0c0c0; /* Quaternary text (very light gray) */
  --color-text-placeholder: #b0b0b0; /* Placeholder text (slightly darker than quaternary) */
  --color-text-disabled: #c0c0c0; /* Disabled text */
  --color-text-inverse: #ffffff; /* Text on dark background */
  --color-text-on-brand: #1a1a1a; /* Text on brand surfaces */

  /* Neutral Colors - Border (subtle and soft) */
  --color-border-base: #e8e8e8; /* Base border color (very light) */
  --color-border-light: #f0f0f0; /* Light border color (barely visible) */
  --color-separator: rgba(0, 0, 0, 0.06); /* iOS-style separator (ultra-subtle) */

  /* Status Colors - Muted for gentleness */
  --color-success: #07c160; /* Success state */
  --color-warning: #ff9500; /* Warning state (iOS orange) */
  --color-error: #ff3b30; /* Error/danger state (iOS red) */

  /* Special Colors */
  --color-link: #007aff; /* Link text (iOS blue) */

  /* Gender Badge Colors */
  --color-gender-male: #4a90e2; /* Male - Blue */
  --color-gender-female: #ff6b9d; /* Female - Pink */
  --color-gender-other: #9b59b6; /* Other - Purple */
  --color-gender-unknown: #95a5a6; /* Unknown - Gray */

  /* Square Entry Card Colors */
  --square-entry-card-blue-gradient: linear-gradient(135deg, #4d7bff 0%, #2a5bff 100%);
  --square-entry-card-cyan-gradient: linear-gradient(135deg, #4cc2ff 0%, #1f8bff 100%);
  --square-entry-card-teal-gradient: linear-gradient(135deg, #2ed8c3 0%, #0fb6a8 100%);
  --square-entry-card-green-gradient: linear-gradient(135deg, #3ad17a 0%, #16b25a 100%);
  --square-entry-card-lime-gradient: linear-gradient(135deg, #b9f000 0%, #7bd400 100%);
  --square-entry-card-yellow-gradient: linear-gradient(135deg, #ffe36a 0%, #ffd000 100%);
  --square-entry-card-amber-gradient: linear-gradient(135deg, #ffcf4d 0%, #ff9500 100%);
  --square-entry-card-orange-gradient: linear-gradient(135deg, #ff9a4d 0%, #ff6a00 100%);
  --square-entry-card-red-gradient: linear-gradient(135deg, #ff6a6a 0%, #ff3b30 100%);
  --square-entry-card-pink-gradient: linear-gradient(135deg, #ff6aa8 0%, #ff1a8a 100%);
  --square-entry-card-purple-gradient: linear-gradient(135deg, #b56dff 0%, #7b3dff 100%);
  --square-entry-card-gray-gradient: linear-gradient(135deg, #9aa0a6 0%, #6b7280 100%);
  --square-entry-card-icon-bg: rgba(255, 255, 255, 0.2);
  --square-entry-card-title-color: rgba(255, 255, 255, 0.98);
  --square-entry-card-desc-color: rgba(255, 255, 255, 0.88);

  /* Tag Tone Palette - hash mapped, semantic-independent */
  --color-tag-tone-1: #4e79ff;
  --color-tag-tone-1-light: #e4ecff;
  --color-tag-tone-2: #1f9dff;
  --color-tag-tone-2-light: #dff1ff;
  --color-tag-tone-3: #00b8d9;
  --color-tag-tone-3-light: #ddf7fb;
  --color-tag-tone-4: #36c86e;
  --color-tag-tone-4-light: #dff7e8;
  --color-tag-tone-5: #79c943;
  --color-tag-tone-5-light: #eaf7dc;
  --color-tag-tone-6: #f0b429;
  --color-tag-tone-6-light: #fff2d9;
  --color-tag-tone-7: #ff8b3d;
  --color-tag-tone-7-light: #ffe7d8;
  --color-tag-tone-8: #ff6b8f;
  --color-tag-tone-8-light: #ffe3ec;
  --color-tag-tone-9: #e06cff;
  --color-tag-tone-9-light: #f8e3ff;
  --color-tag-tone-10: #9d7bff;
  --color-tag-tone-10-light: #ede7ff;
  --color-tag-tone-11: #6b8dff;
  --color-tag-tone-11-light: #e6edff;
  --color-tag-tone-12: #22b6a8;
  --color-tag-tone-12-light: #dcf6f3;

  /* ========================================
     Spacing System - Generous & Breathable
     ======================================== */

  /* Base spacing scale (8rpx base) */
  --space-xs: 8rpx; /* Extra small - 8rpx */
  --space-sm: 16rpx; /* Small - 16rpx */
  --space-md: 24rpx; /* Medium - 24rpx */
  --space-lg: 32rpx; /* Large - 32rpx */
  --space-xl: 48rpx; /* Extra large - 48rpx (increased for breathing room) */
  --space-xxl: 64rpx; /* 2X large - 64rpx (increased for section spacing) */

  /* Semantic spacing - Page level */
  --padding-page: 32rpx; /* Page horizontal padding */
  /* Semantic spacing - Component level */
  --padding-card: 32rpx; /* Card padding */

  /* ========================================
     Typography System
     ======================================== */

  /* Font Sizes (750rpx base, 1rpx = 0.5px on iPhone 6) */
  --font-size-xs: 24rpx; /* 12px - Tiny text */
  --font-size-sm: 28rpx; /* 14px - Small text, captions */
  --font-size-base: 32rpx; /* 16px - Base text, descriptions */
  --font-size-md: 36rpx; /* 18px - Body text, buttons */
  --font-size-lg: 40rpx; /* 20px - Titles, headings */
  --font-size-xl: 44rpx; /* 22px - Large headings */
  --font-size-xxl: 52rpx; /* 26px - Extra large headings */

  /* Line Heights */
  --line-height-tight: 1.2; /* Tight line height for headings */
  --line-height-base: 1.5; /* Base line height for body text */
  --line-height-loose: 1.8; /* Loose line height for readability */
  --line-height-relaxed: 1.7; /* Relaxed line height for multi-line text */

  /* List & Navbar Typography (Semantic) */
  --font-size-nav-title: var(--font-size-base);
  --font-size-list-primary: var(--font-size-md);
  --font-size-list-secondary: var(--font-size-sm);
  --font-size-list-tag: 26rpx;
  --line-height-list-primary: var(--line-height-base);
  --line-height-list-secondary: var(--line-height-base);
  --line-height-list-tag: 44rpx;

  /* List Layout (Semantic) */
  --space-list-vertical: var(--space-md);
  --space-list-horizontal: var(--padding-page);
  --space-list-avatar-gap: var(--space-lg);
  --space-list-tag-gap: calc(var(--space-xs) + 2rpx);
  --space-list-tag-horizontal: calc(var(--space-xs) + 5rpx);
  --size-list-right-meta: calc(var(--space-xxl) + var(--space-xl) + var(--space-sm));

  /* Letter Spacing */
  --letter-spacing-md: 2rpx; /* Medium spacing */
  --letter-spacing-lg: 6rpx; /* Display spacing */

  /* Font Weights */
  --font-weight-medium: 500; /* Medium weight */
  --font-weight-semibold: 600; /* Semibold weight */
  --font-weight-bold: 700; /* Bold weight */

  /* ========================================
     Border Radius System - Gentle Curves
     ======================================== */

  /* Base radius scale */
  --radius-xs: 8rpx; /* Extra small - aligned with TDesign */
  --radius-sm: 12rpx; /* Small - special use cases */
  --radius-md: 24rpx; /* Medium - unified default (cards, buttons, inputs) */
  --radius-lg: 24rpx; /* Large - prominent cards, modals */
  --radius-xl: 32rpx; /* Extra large - special elements */
  --radius-full: 9999rpx; /* Full circle - avatars, badges */

  /* Semantic radius - Component specific (all unified to 24rpx) */
  --radius-card: 24rpx; /* Card border radius - matches --td-radius-large */
  --radius-bubble: 20rpx; /* Message bubble border radius - special case */

  /* ========================================
     Shadow System - Subtle & Soft
     ======================================== */

  /* Base shadow scale (very subtle for gentleness) */
  --shadow-xs: 0 1rpx 4rpx rgba(0, 0, 0, 0.04); /* Extra small - barely visible */
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.06); /* Small - card, hover */
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.08); /* Medium - popup, elevated */
  --shadow-lg: 0 8rpx 32rpx rgba(0, 0, 0, 0.12); /* Large - modal, drawer */

  /* Semantic shadows - Component specific */
  --shadow-card: 0 2rpx 12rpx rgba(0, 0, 0, 0.05); /* Card shadow (very subtle) */
  --shadow-glass-card: 0 8rpx 32rpx rgba(0, 0, 0, 0.08); /* Glass card shadow */

  /* Text Shadows */
  --text-shadow-brand-soft: 0 4rpx 16rpx rgba(229, 255, 0, 0.3);
  --text-shadow-brand-strong: 0 4rpx 24rpx rgba(229, 255, 0, 0.5);

  /* ========================================
     Size System
     ======================================== */

  /* Avatar Sizes */
  --avatar-sm: 64rpx; /* Small avatar */

  /* Icon Sizes */
  --icon-xs: 32rpx; /* Extra small icon */
  --icon-sm: 40rpx; /* Small icon */
  --icon-md: 48rpx; /* Medium icon (default) */
  --icon-xl: 80rpx; /* Extra large icon */

  /* Button Heights */
  --button-height-sm: 64rpx; /* Small button */
  --button-height-md: 88rpx; /* Medium button (default) */
  --button-height-lg: 104rpx; /* Large button */

  /* Input Heights */
  --input-height-md: 72rpx; /* Medium input (default) */

  /* Badge Sizes */
  --badge-size-lg: 40rpx; /* Large badge */

  /* TabBar Sizes */
  --tabbar-height: 100rpx; /* Custom TabBar height */
  --tabbar-icon-size: 44rpx; /* Tab icon size */
  --tabbar-text-size: 20rpx; /* Tab label text size */
  --tabbar-padding-top: 8rpx; /* Top padding inside TabBar */
  --tabbar-text-gap: 4rpx; /* Gap between icon and text */

  /* Message Bubble */
  --message-bubble-max-width: 480rpx; /* Message bubble max width */

  /* Typing Indicator */
  /* Navbar Layout */

  /* Chat Layout */
  --chat-footer-height: 100rpx; /* Chat footer height */
  --chat-input-height: 64rpx; /* Chat input minimum height */
  --emoji-panel-height: 480rpx; /* Emoji panel height */
  --emoji-item-size: 80rpx; /* Emoji item size */

  /* ========================================
     Animation System
     ======================================== */

  /* Transition Durations */
  --duration-fast: 150ms; /* Fast transition - hover effects */
  /* Easing Functions */
  --ease-out: cubic-bezier(0, 0, 0.2, 1); /* Ease out */

  /* ========================================
     Z-Index System
     ======================================== */

  --z-index-navbar: 500; /* Custom navbar (floating) */
  --z-index-fixed: 500; /* Fixed elements (navbar, tabbar) */

  /* ========================================
     Effects
     ======================================== */

  --navbar-glass-blur: 24rpx; /* Glass blur radius */
  --tabbar-glass-blur: var(--navbar-glass-blur); /* Tabbar blur radius */

  /* ========================================
     Safe Area (iPhone X and above)
     ======================================== */

  --safe-area-inset-top: env(safe-area-inset-top);
  --safe-area-inset-bottom: env(safe-area-inset-bottom);
}

/**
 * Dark Mode Tokens - Gentle Dark Theme
 *
 * Philosophy: Soft, comfortable dark mode that's easy on the eyes
 * - True black (#000000) for OLED displays
 * - Subtle elevation through layered grays
 * - Slightly brighter primary colors for better visibility
 * - Reduced contrast for gentleness
 *
 * We keep the exact same variable names so existing components
 * automatically switch when the system theme changes.
 */
@media (prefers-color-scheme: dark) {
  .theme-scope {
    /* Primary Colors */
    --color-primary: #c6dc00;
    --color-primary-light: #d9e95a;
    --color-primary-lighter: #4c5620;
    --color-primary-dark: #a5b800;

    /* Accent Colors */
    --color-accent: #ffc300;
    --color-accent-light: #3d3520;

    /* Background - True black with subtle elevation */
    --color-bg-primary: #000000; /* Default page background (OLED black) */
    --color-bg-page: var(--color-bg-primary); /* Page layout background */
    --color-bg-muted: #2a2b2f; /* Foreground gray surface */
    --color-bg-secondary: #1c1c1e; /* Elevated surface (iOS dark) */
    --color-bg-tertiary: #2c2c2e; /* More elevated surface */
    --color-bg-white: #000000; /* Light-mode white mapped to dark background */
    --color-bg-input: #2a2b2f; /* Input background */
    --color-bg-hover: #2c2c2e; /* Hover state */
    --color-bg-disabled: #1c1c1e; /* Disabled state */
    --color-bg-mask: rgba(0, 0, 0, 0.6); /* Modal mask */
    /* In dark mode, make glass surfaces slightly lighter (while staying translucent). */
    --color-navbar-glass-bg-base: rgba(72, 72, 74, 0.55);
    --color-navbar-glass-bg: var(--color-navbar-glass-bg-base);
    --color-tabbar-glass-bg: transparent;
    --color-glass-card-bg: rgba(30, 30, 30, 0.8);
    --color-glass-card-border: rgba(255, 255, 255, 0.1);
    --color-overlay-strong: rgba(255, 255, 255, 0.85);
    --color-overlay-muted: rgba(0, 0, 0, 0.25);

    /* Text - Softer whites for reduced eye strain */
    --color-text-primary: #f5f5f5; /* Soft white */
    --color-text-secondary: #afafaf; /* Medium gray */
    --color-text-tertiary: #8e8e93; /* Light gray (iOS) */
    --color-text-quaternary: #636366; /* Very light gray */
    --color-text-placeholder: #757575; /* Placeholder */
    --color-text-disabled: #636366; /* Disabled */
    --color-text-inverse: #000000; /* Text on light background */
    --color-text-on-brand: #1a1a1a; /* Text on brand surfaces */

    /* Border - Subtle in dark mode */
    --color-border-base: #38383a; /* Base border (iOS) */
    --color-border-light: #2c2c2e; /* Light border */
    --color-separator: rgba(84, 84, 88, 0.6); /* iOS separator */

    /* Status Colors - Slightly muted */
    --color-success: #0bbf68;
    --color-warning: #ff9f0a; /* iOS orange */
    --color-error: #ff453a; /* iOS red */

    /* Special Colors */
    --color-link: #0a84ff;

    /* Gender Badge Colors - slightly adjusted for dark mode */
    --color-gender-male: #5ba3ff;
    --color-gender-female: #ff7eb0;
    --color-gender-other: #b57ce0;
    --color-gender-unknown: #a8b8b9;

    /* Square Entry Card Colors - adjusted for dark mode */
    --square-entry-card-blue-gradient: linear-gradient(135deg, #5a8bff 0%, #3d6bff 100%);
    --square-entry-card-cyan-gradient: linear-gradient(135deg, #5cd2ff 0%, #2f9bff 100%);
    --square-entry-card-teal-gradient: linear-gradient(135deg, #46e0d0 0%, #1ac0b6 100%);
    --square-entry-card-green-gradient: linear-gradient(135deg, #5fe58f 0%, #2cc46d 100%);
    --square-entry-card-lime-gradient: linear-gradient(135deg, #c7ff4d 0%, #8be600 100%);
    --square-entry-card-yellow-gradient: linear-gradient(135deg, #fff0a6 0%, #ffd95a 100%);
    --square-entry-card-amber-gradient: linear-gradient(135deg, #ffd98a 0%, #ffb84d 100%);
    --square-entry-card-orange-gradient: linear-gradient(135deg, #ffb37a 0%, #ff7a3d 100%);
    --square-entry-card-red-gradient: linear-gradient(135deg, #ff8b7a 0%, #ff4d4d 100%);
    --square-entry-card-pink-gradient: linear-gradient(135deg, #ff7ab8 0%, #ff1a8a 100%);
    --square-entry-card-purple-gradient: linear-gradient(135deg, #c57dff 0%, #8b4dff 100%);
    --square-entry-card-gray-gradient: linear-gradient(135deg, #a8b0b8 0%, #727b86 100%);
    --square-entry-card-icon-bg: rgba(255, 255, 255, 0.25);
    --square-entry-card-title-color: rgba(255, 255, 255, 0.98);
    --square-entry-card-desc-color: rgba(255, 255, 255, 0.9);

    /* Tag Tone Palette - dark mode */
    --color-tag-tone-1: #8aa0ff;
    --color-tag-tone-1-light: #2b3459;
    --color-tag-tone-2: #66baff;
    --color-tag-tone-2-light: #223a52;
    --color-tag-tone-3: #48d0eb;
    --color-tag-tone-3-light: #1f444d;
    --color-tag-tone-4: #5fd78d;
    --color-tag-tone-4-light: #214735;
    --color-tag-tone-5: #9fdc6a;
    --color-tag-tone-5-light: #314724;
    --color-tag-tone-6: #f9c85a;
    --color-tag-tone-6-light: #4c3c1d;
    --color-tag-tone-7: #ffa66e;
    --color-tag-tone-7-light: #4f3022;
    --color-tag-tone-8: #ff8dab;
    --color-tag-tone-8-light: #4d2834;
    --color-tag-tone-9: #ec94ff;
    --color-tag-tone-9-light: #493052;
    --color-tag-tone-10: #b59cff;
    --color-tag-tone-10-light: #3a3351;
    --color-tag-tone-11: #8ca6ff;
    --color-tag-tone-11-light: #2d3555;
    --color-tag-tone-12: #64d3c7;
    --color-tag-tone-12-light: #214b47;

    /* Shadows - More prominent in dark mode */
    --shadow-xs: 0 1rpx 4rpx rgba(0, 0, 0, 0.3);
    --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.4);
    --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.5);
    --shadow-lg: 0 8rpx 32rpx rgba(0, 0, 0, 0.6);
    --shadow-card: 0 2rpx 12rpx rgba(0, 0, 0, 0.4);
    --shadow-glass-card: 0 8rpx 32rpx rgba(0, 0, 0, 0.5);

    /* Text Shadows */
    --text-shadow-brand-soft: 0 4rpx 16rpx rgba(198, 220, 0, 0.3);
    --text-shadow-brand-strong: 0 4rpx 24rpx rgba(198, 220, 0, 0.5);
  }
}
