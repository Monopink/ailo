/**
 * TDesign Theme Customization
 *
 * Maps semantic design tokens to TDesign variables
 * This approach decouples our design system from the component library
 */

page {
  /* ========================================
     Brand Colors - Mapped from design tokens
     ======================================== */

  /* Primary brand color - mapped to our semantic variables */
  --td-brand-color: var(--color-primary);
  --td-brand-color-1: var(--color-primary-lighter);
  --td-brand-color-2: var(--color-primary-lighter);
  --td-brand-color-3: var(--color-primary-lighter);
  --td-brand-color-4: var(--color-primary-light);
  --td-brand-color-5: var(--color-primary-light);
  --td-brand-color-6: var(--color-primary-light);
  --td-brand-color-7: var(--color-primary);
  --td-brand-color-8: var(--color-primary);
  --td-brand-color-9: var(--color-primary);
  --td-brand-color-10: var(--color-primary-dark);

  /* Brand color variations */
  --td-brand-color-light: var(--color-primary-light);
  --td-brand-color-focus: var(--color-primary-dark);
  --td-brand-color-disabled: var(--color-primary-light);
  --td-brand-color-hover: var(--color-primary-dark);
  --td-brand-color-active: var(--color-primary-dark);

  /* ========================================
     Spacing System - Mapped from design tokens
     ======================================== */

  --td-spacer: var(--space-xs);
  --td-spacer-1: var(--space-xs);
  --td-spacer-2: var(--space-sm);
  --td-spacer-3: var(--space-md);
  --td-spacer-4: var(--space-lg);
  --td-spacer-5: var(--space-xl);

  /* ========================================
     Border Radius - Mapped from design tokens
     ======================================== */

  --td-radius-small: var(--radius-xs);
  --td-radius-default: var(--radius-md);
  --td-radius-medium: var(--radius-md);
  --td-radius-large: var(--radius-md);
  --td-radius-extra-large: var(--radius-xl);
  --td-radius-round: var(--radius-full);
  --td-radius-circle: 50%;

  /* ========================================
     Component Heights - Mapped from design tokens
     ======================================== */

  /* Button heights */
  --td-button-extra-small-height: var(--button-height-sm);
  --td-button-small-height: var(--input-height-md);
  --td-button-medium-height: var(--button-height-md);
  --td-button-large-height: var(--button-height-lg);

  /* Input vertical padding */
  --td-input-vertical-padding: 20rpx;

  /* ========================================
     Font System - Mapped from design tokens
     ======================================== */

  --td-font-size-base: var(--font-size-base);
  --td-font-size-s: var(--font-size-sm);
  --td-font-size-m: var(--font-size-base);
  --td-font-size-l: var(--font-size-md);
  --td-font-size-xl: var(--font-size-lg);

  /* ========================================
     Background Colors - Mapped from design tokens
     ======================================== */

  --td-bg-color-page: var(--color-bg-primary);
  --td-bg-color-container: var(--color-bg-secondary);
  --td-bg-color-secondarycontainer: var(--color-bg-tertiary);
  --td-bg-color-component: var(--color-bg-input);
  --td-bg-color-component-hover: var(--color-bg-hover);
  --td-bg-color-component-active: var(--color-bg-hover);
  --td-bg-color-component-disabled: var(--color-bg-disabled);
  --td-avatar-bg-color: var(--color-bg-tertiary);
  --td-avatar-content-color: var(--color-text-tertiary);

  /* ========================================
     Text Colors - Mapped from design tokens
     ======================================== */

  --td-text-color-primary: var(--color-text-primary);
  --td-text-color-secondary: var(--color-text-secondary);
  --td-text-color-placeholder: var(--color-text-placeholder);
  --td-text-color-disabled: var(--color-text-disabled);
  --td-text-color-anti: var(--color-text-inverse);
  --td-text-color-brand: var(--color-primary);
  --td-button-primary-color: var(--color-text-on-brand);

  /* ========================================
     Border Colors - Mapped from design tokens
     ======================================== */

  --td-border-level-1-color: var(--color-border-base);
  --td-border-level-2-color: var(--color-border-light);
  --td-component-border: var(--color-border-base);

  /* ========================================
     Shadow System - Mapped from design tokens
     ======================================== */

  --td-shadow-1: var(--shadow-sm);
  --td-shadow-2: var(--shadow-md);
  --td-shadow-3: var(--shadow-lg);

  /* ========================================
     Status Colors - Mapped from design tokens
     ======================================== */

  --td-error-color: var(--color-error);
  --td-error-color-1: var(--color-primary-lighter);
  --td-error-color-hover: var(--color-error);
  --td-error-color-active: var(--color-error);

  --td-warning-color: var(--color-warning);
  --td-warning-color-1: var(--color-accent-light);
  --td-warning-color-hover: var(--color-warning);
  --td-warning-color-active: var(--color-warning);

  --td-success-color: var(--color-success);
  --td-success-color-1: var(--color-primary-lighter);
  --td-success-color-hover: var(--color-success);
  --td-success-color-active: var(--color-success);
}

/* ========================================
   Dark Mode Support - Mapped from design tokens
   ======================================== */

@media (prefers-color-scheme: dark) {
  page {
    /* All TDesign variables automatically inherit from design-tokens.wxss dark mode */
    /* Background colors */
    --td-bg-color-page: var(--color-bg-primary);
    --td-bg-color-container: var(--color-bg-secondary);
    --td-bg-color-secondarycontainer: var(--color-bg-tertiary);
    --td-bg-color-component: var(--color-bg-input);
    --td-bg-color-component-hover: var(--color-bg-hover);
    --td-bg-color-component-active: var(--color-bg-hover);
    --td-bg-color-component-disabled: var(--color-bg-disabled);
    --td-avatar-bg-color: var(--color-bg-tertiary);
    --td-avatar-content-color: var(--color-text-tertiary);

    /* Text colors */
    --td-text-color-primary: var(--color-text-primary);
    --td-text-color-secondary: var(--color-text-secondary);
    --td-text-color-placeholder: var(--color-text-placeholder);
    --td-text-color-disabled: var(--color-text-disabled);
    --td-text-color-anti: var(--color-text-inverse);

    /* Border colors */
    --td-border-level-1-color: var(--color-border-base);
    --td-border-level-2-color: var(--color-border-light);
    --td-component-border: var(--color-border-base);

    /* Shadow colors */
    --td-shadow-1: var(--shadow-sm);
    --td-shadow-2: var(--shadow-md);
    --td-shadow-3: var(--shadow-lg);
  }
}

/* Manual dark theme via page[theme='dark'] */
page[theme='dark'] {
  /* Same mappings as @media dark mode */
  --td-bg-color-page: var(--color-bg-primary);
  --td-bg-color-container: var(--color-bg-secondary);
  --td-bg-color-secondarycontainer: var(--color-bg-tertiary);
  --td-bg-color-component: var(--color-bg-input);
  --td-bg-color-component-hover: var(--color-bg-hover);
  --td-bg-color-component-active: var(--color-bg-hover);
  --td-bg-color-component-disabled: var(--color-bg-disabled);
  --td-avatar-bg-color: var(--color-bg-tertiary);
  --td-avatar-content-color: var(--color-text-tertiary);

  --td-text-color-primary: var(--color-text-primary);
  --td-text-color-secondary: var(--color-text-secondary);
  --td-text-color-placeholder: var(--color-text-placeholder);
  --td-text-color-disabled: var(--color-text-disabled);
  --td-text-color-anti: var(--color-text-inverse);

  --td-border-level-1-color: var(--color-border-base);
  --td-border-level-2-color: var(--color-border-light);
  --td-component-border: var(--color-border-base);

  --td-shadow-1: var(--shadow-sm);
  --td-shadow-2: var(--shadow-md);
  --td-shadow-3: var(--shadow-lg);
}
