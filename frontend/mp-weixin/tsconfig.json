{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020"],
    "moduleResolution": "node10",
    "strict": true,
    "skipLibCheck": true,
    "typeRoots": ["./typings", "./node_modules/@types"],
    "types": ["miniprogram-api-typings"],
    "resolveJsonModule": true,
    "esModuleInterop": true
  }
}
