# Says Frontend Configuration Example
# Copy this file to .env and modify the values as needed

# API Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_API_TIMEOUT=10000
VITE_API_RETRY_ATTEMPTS=3
VITE_API_RETRY_DELAY=1000

# Cache Configuration (in milliseconds)
VITE_CACHE_CHAT_INFO_DURATION=300000
VITE_CACHE_CONTACT_LIST_DURATION=120000
VITE_CACHE_USER_PROFILE_DURATION=600000
VITE_CACHE_MAX_SIZE=100

# Message Configuration
VITE_MESSAGE_MAX_LENGTH=99
VITE_MESSAGE_MIN_LENGTH=1
VITE_MESSAGE_TYPING_TIMEOUT=3000
VITE_MESSAGE_TYPING_DELAY=500
VITE_MESSAGE_TYPING_AUTO_HIDE=10000
VITE_MESSAGE_RETRY_ATTEMPTS=3
VITE_MESSAGE_RETRY_DELAY=2000

# UI Configuration
VITE_UI_TOAST_DURATION=3000
VITE_UI_ANIMATION_FAST=150
VITE_UI_ANIMATION_NORMAL=300
VITE_UI_ANIMATION_SLOW=500
VITE_UI_SEARCH_DEBOUNCE=300
VITE_UI_INPUT_DEBOUNCE=150

# Error Reporting Configuration
VITE_ERROR_REPORT_COOLDOWN=5000
VITE_ERROR_MAX_QUEUE=10
VITE_ERROR_ENABLE_REPORTING=true

# Development Configuration
VITE_DEV_ENABLE_DEBUG=true
VITE_DEV_ENABLE_PERFORMANCE=false
VITE_DEV_ENABLE_API_LOGGING=true

# Contact Configuration
VITE_CONTACT_DEFAULT_LIMIT=3
VITE_CONTACT_SEARCH_MIN_LENGTH=2
VITE_CONTACT_SEARCH_MAX_RESULTS=20

# Notification Configuration
VITE_NOTIFICATION_PERMISSION_TIMEOUT=10000
VITE_NOTIFICATION_DISPLAY_DURATION=5000
VITE_NOTIFICATION_ENABLE_BY_DEFAULT=false

# Validation Configuration
VITE_VALIDATION_PASSWORD_MIN_LENGTH=8
VITE_VALIDATION_PASSWORD_MAX_LENGTH=128
VITE_VALIDATION_NICKNAME_MIN_LENGTH=1
VITE_VALIDATION_NICKNAME_MAX_LENGTH=20

# LeanCloud Configuration
VITE_LEANCLOUD_APP_ID=your_leancloud_app_id
VITE_LEANCLOUD_APP_KEY=your_leancloud_app_key

# Application Configuration
VITE_BRAND_NAME=Says
VITE_APP_VERSION=1.0.0
