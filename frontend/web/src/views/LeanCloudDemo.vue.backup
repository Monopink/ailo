<template>
    <div class="leancloud-demo-container">
        <h1>LeanCloud Communication Test</h1>

        <!-- Connection Status Panel -->
        <div class="status-panel">
            <div class="status-item">
                <span>Connection Status: </span>
                <span :class="{ 'status-connected': isConnected, 'status-disconnected': !isConnected }">
                    {{ isConnected ? 'Connected' : 'Disconnected' }}
                </span>
            </div>
            <div class="status-item">
                <span>Last Heartbeat: </span>
                <span>{{ lastHeartbeat || 'N/A' }}</span>
            </div>
        </div>

        <!-- Control Panel -->
        <div class="control-panel">
            <div class="input-group">
                <label>Client ID:</label>
                <input type="text" v-model="clientId" placeholder="Enter client ID" />
            </div>

            <div class="button-group">
                <button @click="login" :disabled="isConnected || !clientId" class="btn primary">
                    Login
                </button>
                <button @click="logout" :disabled="!isConnected" class="btn danger">
                    Logout
                </button>
                <button @click="clearMessages" class="btn secondary">
                    Clear Messages
                </button>
            </div>
        </div>

        <!-- Conversation Panel -->
        <div class="conversation-panel" v-if="isConnected">
            <h2>Conversation</h2>

            <div class="input-group">
                <label>Recipient ID:</label>
                <input type="text" v-model="recipientId" placeholder="Enter recipient ID" />
            </div>

            <div class="input-group">
                <label>Message Type:</label>
                <select v-model="messageType">
                    <option value="chat">Chat</option>
                    <option value="typing">Typing</option>
                    <option value="typing_end">Typing End</option>
                    <option value="system">System</option>
                </select>
            </div>

            <div class="input-group">
                <label>Message:</label>
                <textarea v-model="messageText" placeholder="Type your message here"></textarea>
            </div>

            <div class="button-group">
                <button @click="sendMessage" :disabled="!recipientId || (!messageText && messageType === 'chat')" class="btn primary">
                    Send Message
                </button>
                <button @click="simulateTyping" :disabled="!recipientId" class="btn secondary">
                    Simulate Typing
                </button>
            </div>
        </div>

        <!-- Message Panel -->
        <div class="message-panel">
            <h2>Messages</h2>
            <div class="message-list">
                <div v-if="messages.length === 0" class="no-messages">
                    No messages yet
                </div>
                <div v-for="(msg, index) in messages" :key="index" class="message-item" :class="getMessageClass(msg)">
                    <div class="message-header">
                        <span class="message-from">{{ msg.from }}</span>
                        <span class="message-type">{{ msg.type || 'chat' }}</span>
                        <span class="message-time">{{ formatTime(msg.timestamp) }}</span>
                    </div>
                    <div class="message-content">{{ msg.text }}</div>
                </div>
            </div>
        </div>

        <!-- Debug Panel -->
        <div class="debug-panel">
            <h2>Debug Information</h2>
            <div class="debug-controls">
                <button @click="toggleDebugMode" class="btn secondary">
                    {{ isDebugMode ? 'Disable' : 'Enable' }} Debug Mode
                </button>
            </div>
            <div v-if="isDebugMode" class="debug-info">
                <h3>Connection Details:</h3>
                <pre>{{ debugInfo }}</pre>
            </div>
        </div>

        <!-- Error Panel -->
        <div class="error-panel" v-if="errorMessage">
            <h3>Error:</h3>
            <pre>{{ errorMessage }}</pre>
            <button @click="clearError" class="btn danger">Clear Error</button>
        </div>
    </div>
</template>

<script setup>
import { ref, onMounted, onUnmounted, computed } from 'vue';
import { Realtime, TextMessage, Event } from 'leancloud-realtime';
import { useToast } from 'vue-toastification';

const toast = useToast();

// State
const clientId = ref('');
const recipientId = ref('');
const messageText = ref('');
const messageType = ref('chat');
const isConnected = ref(false);
const errorMessage = ref('');
const messages = ref([]);
const realtime = ref(null);
const client = ref(null);
const currentConversation = ref(null);
const lastHeartbeat = ref(null);
const isDebugMode = ref(false);
const debugInfo = computed(() => {
    if (!client.value) return 'Client not initialized';
    return {
        clientId: client.value.id,
        isConnected: client.value.isConnected,
        lastPong: lastHeartbeat.value,
        conversationCount: client.value._conversations ? Object.keys(client.value._conversations).length : 0,
        currentConversationId: currentConversation.value?.id || 'None'
    };
});

// LeanCloud credentials from environment variables
const appId = import.meta.env.VITE_LEANCLOUD_APP_ID;
const appKey = import.meta.env.VITE_LEANCLOUD_APP_KEY;
const serverURL = import.meta.env.VITE_LEANCLOUD_SERVER_URL;

// Initialize LeanCloud Realtime SDK
onMounted(() => {
    try {
        console.log('LeanCloud Demo initializing with:', {
            appId,
            appKey: appKey ? '[HIDDEN]' : undefined,
            server: serverURL
        });

        let options = {
            appId,
            appKey,
            // Enable debug mode for development
            debug: true
        };

        if (serverURL) {
            if (serverURL === 'CN' || serverURL === 'US') {
                options.region = serverURL;
                console.log(`Using region: ${serverURL}`);
            } else {
                options.server = serverURL;
                console.log(`Using custom server URL: ${serverURL}`);
            }
        }

        realtime.value = new Realtime(options);
        console.log('LeanCloud Realtime instance created');
    } catch (error) {
        handleError('Initialization error', error);
    }
});

// Clean up on component unmount
onUnmounted(async () => {
    await logout();
});

// Login to LeanCloud
const login = async () => {
    try {
        if (!clientId.value) {
            toast.error('Please enter a client ID');
            return;
        }

        console.log('Logging in with client ID:', clientId.value);
        client.value = await realtime.value.createIMClient(clientId.value);
        setupEventHandlers();
        isConnected.value = true;
        toast.success(`Logged in as ${clientId.value}`);
        errorMessage.value = '';
    } catch (error) {
        handleError('Login error', error);
    }
};

// Setup client event handlers
const setupEventHandlers = () => {
    if (!client.value) return;

    // Message events
    client.value.on(Event.MESSAGE, (message, conversation) => {
        console.log('Received message:', message, 'in conversation:', conversation);
        messages.value.push({
            id: message.id,
            from: message.from,
            text: message.text,
            type: message.type || 'chat',
            timestamp: message.timestamp
        });
    });

    // Connection events
    client.value.on(Event.DISCONNECT, () => {
        console.log('Disconnected from LeanCloud');
        toast.warning('Disconnected, attempting to reconnect...');
        isConnected.value = false;
    });

    client.value.on(Event.RECONNECT, () => {
        console.log('Reconnected to LeanCloud');
        toast.success('Reconnected');
        isConnected.value = true;
    });

    client.value.on(Event.RECONNECT_ERROR, (error) => {
        console.error('Reconnection error:', error);
        handleError('Reconnection error', error);
    });

    // Heartbeat events
    client.value.on(Event.UNREAD_MESSAGES_COUNT_UPDATE, () => {
        lastHeartbeat.value = new Date().toLocaleTimeString();
    });
};

// Send message
const sendMessage = async () => {
    try {
        if (!recipientId.value || (messageType.value === 'chat' && !messageText.value)) {
            toast.error('Please enter required fields');
            return;
        }

        console.log('Creating or getting conversation with:', recipientId.value);
        const conversation = await client.value.createConversation({
            members: [recipientId.value],
            unique: true
        });

        currentConversation.value = conversation;

        // Create message based on type
        let message;
        switch (messageType.value) {
            case 'chat':
                message = new TextMessage(messageText.value);
                break;
            case 'typing':
                message = new TextMessage('');
                message.setAttributes({ type: 'typing' });
                break;
            case 'typing_end':
                message = new TextMessage('');
                message.setAttributes({ type: 'typing_end' });
                break;
            case 'system':
                message = new TextMessage(messageText.value || 'System Message');
                message.setAttributes({ type: 'system' });
                break;
        }

        console.log('Sending message:', message);
        const result = await conversation.send(message);
        console.log('Message sent:', result);

        messages.value.push({
            id: result.id,
            from: clientId.value,
            text: messageText.value || `[${messageType.value}]`,
            type: messageType.value,
            timestamp: new Date().getTime()
        });

        if (messageType.value === 'chat') {
            messageText.value = '';
        }
        toast.success('Message sent');
    } catch (error) {
        handleError('Send message error', error);
    }
};

// Simulate typing sequence
const simulateTyping = async () => {
    try {
        messageType.value = 'typing';
        await sendMessage();
        await new Promise(resolve => setTimeout(resolve, 2000));
        messageType.value = 'typing_end';
        await sendMessage();
        messageType.value = 'chat';
    } catch (error) {
        handleError('Simulate typing error', error);
    }
};

// Utility functions
const formatTime = (timestamp) => {
    return new Date(timestamp).toLocaleTimeString();
};

const getMessageClass = (message) => {
    return {
        'message-chat': message.type === 'chat',
        'message-typing': message.type === 'typing',
        'message-typing-end': message.type === 'typing_end',
        'message-system': message.type === 'system'
    };
};

const clearMessages = () => {
    messages.value = [];
    toast.info('Messages cleared');
};

const clearError = () => {
    errorMessage.value = '';
};

const toggleDebugMode = () => {
    isDebugMode.value = !isDebugMode.value;
    toast.info(`Debug mode ${isDebugMode.value ? 'enabled' : 'disabled'}`);
};

const handleError = (context, error) => {
    const errorDetails = `${context}: ${error.message}\n${error.stack || ''}`;
    console.error(errorDetails);
    errorMessage.value = errorDetails;
    toast.error(`${context}: ${error.message}`);
};

// Logout
const logout = async () => {
    try {
        if (client.value) {
            await client.value.close();
            client.value = null;
            currentConversation.value = null;
            isConnected.value = false;
            toast.info('Logged out');
        }
    } catch (error) {
        handleError('Logout error', error);
    }
};
</script>

<style scoped>
.leancloud-demo-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 20px;
    font-family: Arial, sans-serif;
}

h1, h2, h3 {
    color: var(--color-text-primary);
}

.status-panel {
    margin-bottom: 20px;
    padding: 10px;
    background-color: var(--color-bg-secondary);
    border-radius: 5px;
}

.status-item {
    margin-bottom: 5px;
}

.status-connected {
    color: #4caf50;
    font-weight: bold;
}

.status-disconnected {
    color: #f44336;
    font-weight: bold;
}

.control-panel,
.conversation-panel,
.debug-panel {
    margin-bottom: 20px;
    padding: 15px;
    background-color: var(--color-bg-secondary);
    border-radius: 5px;
}

.input-group {
    margin-bottom: 15px;
}

.input-group label {
    display: block;
    margin-bottom: 5px;
    font-weight: bold;
}

input,
textarea,
select {
    width: 100%;
    padding: 8px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background-color: var(--color-bg-primary);
    color: var(--color-text-primary);
}

textarea {
    height: 100px;
    resize: vertical;
}

.button-group {
    display: flex;
    gap: 10px;
    margin-bottom: 15px;
}

.btn {
    padding: 8px 15px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-weight: bold;
    transition: opacity 0.2s;
}

.btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.primary {
    background-color: var(--color-primary);
    color: white;
}

.secondary {
    background-color: #607d8b;
    color: white;
}

.danger {
    background-color: #f44336;
    color: white;
}

.message-panel {
    margin-bottom: 20px;
}

.message-list {
    max-height: 400px;
    overflow-y: auto;
    padding: 10px;
    background-color: var(--color-bg-secondary);
    border-radius: 5px;
}

.no-messages {
    text-align: center;
    color: #888;
    padding: 20px;
}

.message-item {
    margin-bottom: 10px;
    padding: 10px;
    background-color: var(--color-bg-primary);
    border-radius: 5px;
    border-left: 4px solid transparent;
}

.message-chat {
    border-left-color: var(--color-primary);
}

.message-typing {
    border-left-color: #ff9800;
    background-color: rgba(255, 152, 0, 0.1);
}

.message-typing-end {
    border-left-color: #8bc34a;
    background-color: rgba(139, 195, 74, 0.1);
}

.message-system {
    border-left-color: #9c27b0;
    background-color: rgba(156, 39, 176, 0.1);
}

.message-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 5px;
    font-size: 0.9em;
}

.message-from {
    font-weight: bold;
}

.message-type {
    color: #607d8b;
    font-style: italic;
}

.message-time {
    color: #888;
}

.debug-panel {
    margin-top: 20px;
}

.debug-controls {
    margin-bottom: 10px;
}

.debug-info {
    background-color: var(--color-bg-primary);
    padding: 10px;
    border-radius: 4px;
}

.error-panel {
    margin-top: 20px;
    padding: 15px;
    background-color: #ffebee;
    border-left: 5px solid #f44336;
    border-radius: 5px;
    overflow-x: auto;
}

pre {
    margin: 0;
    white-space: pre-wrap;
    font-family: monospace;
    font-size: 0.9em;
}
</style>