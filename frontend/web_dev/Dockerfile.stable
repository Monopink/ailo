# frontend/web_dev/Dockerfile.stable

# Use the official Nginx image from Docker Hub
FROM nginx:alpine

# Remove the default nginx index.html
RUN rm /usr/share/nginx/html/index.html

# Copy our custom index.html to the Nginx html directory
COPY ./index.html /usr/share/nginx/html/

# Set the port to 8100 directly in the HTML file at build time
RUN sed -i "s/const port = '8000'; \/\/ WebSocket service port/const port = '8100'; \/\/ WebSocket service port/" /usr/share/nginx/html/index.html

# Use the default Nginx entrypoint
CMD ["nginx", "-g", "daemon off;"] 