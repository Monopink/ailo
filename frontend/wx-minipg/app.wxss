/**
 * Global Styles
 * Theme: Green (#42db5a primary, #fdd700 accent)
 */

/* Reset and Base Styles */
page {
  height: 100%;
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
  font-size: 16px;
  line-height: 1.5;
  color: #333333;
}

/* Theme Colors */
.primary-color {
  color: #42db5a;
}

.accent-color {
  color: #fdd700;
}

.primary-bg {
  background-color: #42db5a;
}

.accent-bg {
  background-color: #fdd700;
}

/* Layout */
.container {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

.flex {
  display: flex;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
}

/* Spacing */
.padding {
  padding: 16px;
}

.padding-sm {
  padding: 8px;
}

.padding-lg {
  padding: 24px;
}

.margin {
  margin: 16px;
}

.margin-sm {
  margin: 8px;
}

.margin-lg {
  margin: 24px;
}

/* Border Radius */
.radius {
  border-radius: 8px;
}

.radius-sm {
  border-radius: 4px;
}

.radius-lg {
  border-radius: 12px;
}

.radius-circle {
  border-radius: 50%;
}

/* Typography */
.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

.text-bold {
  font-weight: bold;
}

.text-sm {
  font-size: 12px;
}

.text-lg {
  font-size: 18px;
}

.text-xl {
  font-size: 20px;
}

.text-gray {
  color: #999999;
}

.text-light-gray {
  color: #cccccc;
}

.text-white {
  color: #ffffff;
}

/* Buttons */
.btn {
  padding: 12px 24px;
  border-radius: 8px;
  font-size: 16px;
  text-align: center;
  border: none;
  outline: none;
}

.btn-primary {
  background-color: #42db5a;
  color: #ffffff;
}

.btn-primary:active {
  background-color: #3bc950;
}

.btn-secondary {
  background-color: #f5f5f5;
  color: #333333;
}

.btn-secondary:active {
  background-color: #e5e5e5;
}

.btn-circle {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Input */
.input {
  padding: 12px 16px;
  border: 1px solid #e5e5e5;
  border-radius: 8px;
  font-size: 16px;
  background-color: #ffffff;
}

.input:focus {
  border-color: #42db5a;
}

.input-error {
  border-color: #ff4444;
}

/* Avatar - WeChat style square with small radius */
.avatar {
  width: 48px;
  height: 48px;
  border-radius: 4px;
  overflow: hidden;
  background-color: #e5e5e5;
}

.avatar-sm {
  width: 32px;
  height: 32px;
  border-radius: 3px;
}

.avatar-lg {
  width: 64px;
  height: 64px;
  border-radius: 5px;
}

.avatar-xl {
  width: 80px;
  height: 80px;
  border-radius: 6px;
}

.avatar image {
  width: 100%;
  height: 100%;
}

/* Card */
.card {
  background-color: #ffffff;
  border-radius: 8px;
  padding: 16px;
  margin-bottom: 8px;
}

/* Divider */
.divider {
  height: 1px;
  background-color: #e5e5e5;
  margin: 16px 0;
}

/* Badge */
.badge {
  display: inline-block;
  padding: 2px 8px;
  border-radius: 12px;
  font-size: 12px;
  background-color: #ff4444;
  color: #ffffff;
  min-width: 18px;
  text-align: center;
}

/* Loading */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32px;
  color: #999999;
}

/* Empty State */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 64px 32px;
  color: #999999;
}

.empty-icon {
  font-size: 48px;
  margin-bottom: 16px;
}

.empty-text {
  font-size: 14px;
}

/* Utility */
.hidden {
  display: none;
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

