/* Import TDesign miniprogram styles */
@import 'miniprogram_npm/tdesign-miniprogram/common/style/index.wxss';

/* Import custom TDesign theme overrides */
@import '/styles/tdesign-theme.wxss';

/* Import shared design tokens for custom components */
@import '/styles/design-tokens.wxss';

/* Override TDesign TabBar colors globally */
page {
  --td-brand-color: #07c160;
  --td-primary-color: #07c160;
  --td-primary-color-7: #07c160;
}

/* ========================================
   TDesign Component Style Fixes
   ======================================== */

/* Fix: TDesign Input has no border-radius by default */
/* Apply unified border-radius to match buttons and cards */
.t-input {
  border-radius: var(--td-radius-default) !important;
}

.t-input__wrap {
  border-radius: var(--td-radius-default) !important;
}

/* Ensure textarea also has unified border-radius */
.t-textarea {
  border-radius: var(--td-radius-default) !important;
}

.t-textarea__wrapper {
  border-radius: var(--td-radius-default) !important;
}

/**
 * Global utility styles.
 * All numeric values reference design tokens to keep UI consistent.
 */

page {
  min-height: 100%;
  background-color: var(--color-bg-primary);
  font-family:
    -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
  font-size: var(--font-size-base);
  line-height: var(--line-height-base);
  color: var(--color-text-primary);
}

/* Layout helpers */
.container {
  width: 100%;
  min-height: 100%;
  box-sizing: border-box;
}

.flex {
  display: flex;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
}

/* Spacing utilities */
.padding {
  padding: var(--space-md);
}

.padding-sm {
  padding: var(--space-sm);
}

.padding-lg {
  padding: var(--space-lg);
}

.margin {
  margin: var(--space-md);
}

.margin-sm {
  margin: var(--space-sm);
}

.margin-lg {
  margin: var(--space-lg);
}

.gap-sm {
  gap: var(--space-sm);
}

.gap-md {
  gap: var(--space-md);
}

/* Border radius */
.radius {
  border-radius: var(--radius-md);
}

.radius-sm {
  border-radius: var(--radius-sm);
}

.radius-lg {
  border-radius: var(--radius-lg);
}

.radius-full {
  border-radius: var(--radius-full);
}

/* Typography */
.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

.text-bold {
  font-weight: var(--font-weight-semibold);
}

.text-sm {
  font-size: var(--font-size-sm);
}

.text-lg {
  font-size: var(--font-size-lg);
}

.text-xl {
  font-size: var(--font-size-xl);
}

.text-muted {
  color: var(--color-text-secondary);
}

.text-placeholder {
  color: var(--color-text-tertiary);
}

.text-inverse {
  color: var(--color-text-inverse);
}

/* Button primitives */
.btn {
  min-height: var(--button-height-md);
  padding: 0 var(--padding-button);
  border-radius: var(--radius-md);
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-medium);
  text-align: center;
  border: none;
  outline: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  transition: background-color var(--duration-fast) var(--ease-out);
}

.btn-primary {
  background-color: var(--color-primary);
  color: var(--color-text-inverse);
}

.btn-primary:active {
  opacity: var(--opacity-pressed);
}

.btn-secondary {
  background-color: var(--color-bg-hover);
  color: var(--color-text-primary);
}

.btn-secondary:active {
  opacity: var(--opacity-pressed);
}

.btn-danger {
  background-color: var(--color-error);
  color: var(--color-text-inverse);
}

.btn-block {
  width: 100%;
}

/* Inputs */
.input {
  display: flex;
  align-items: center;
  min-height: var(--input-height-md);
  padding: 0 var(--space-md);
  border: 1px solid var(--color-border-base);
  border-radius: var(--radius-md);
  font-size: var(--font-size-base);
  background-color: var(--color-bg-input);
  color: var(--color-text-primary);
  box-sizing: border-box;
}

.input:focus {
  border-color: var(--color-primary);
}

.input-error {
  border-color: var(--color-error);
}

/* Avatars */
.avatar {
  width: var(--avatar-md);
  height: var(--avatar-md);
  border-radius: var(--radius-sm);
  overflow: hidden;
  background-color: var(--color-border-light);
}

.avatar-sm {
  width: var(--avatar-sm);
  height: var(--avatar-sm);
}

.avatar-lg {
  width: var(--avatar-lg);
  height: var(--avatar-lg);
}

.avatar-xl {
  width: var(--avatar-xl);
  height: var(--avatar-xl);
}

.avatar image {
  width: 100%;
  height: 100%;
}

/* Cards */
.card {
  background-color: var(--color-bg-secondary);
  border-radius: var(--radius-md);
  padding: var(--padding-card);
  margin-bottom: var(--space-sm);
  box-shadow: var(--shadow-sm);
}

/* Divider */
.divider {
  width: 100%;
  height: 1px;
  background-color: var(--color-border-base);
  margin: var(--space-md) 0;
}

/* Badge */
.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 var(--space-xs);
  border-radius: var(--radius-full);
  font-size: var(--font-size-sm);
  background-color: var(--color-unread);
  color: var(--color-text-inverse);
  min-width: var(--badge-size-md);
  height: var(--badge-size-md);
  line-height: 1;
}

/* Loading / empty states */
.loading,
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-xl);
  color: var(--color-text-tertiary);
}

.loading-icon {
  width: var(--icon-lg);
  height: var(--icon-lg);
  border: 4rpx solid var(--color-border-base);
  border-top-color: var(--color-primary);
  border-radius: var(--radius-full);
  animation: spin var(--duration-base) linear infinite;
  margin-bottom: var(--space-sm);
}

@keyframes spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

/* Overlay */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: var(--color-bg-mask);
  z-index: var(--z-index-modal-backdrop);
}

/* Utility */
.hidden {
  display: none;
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.page-group {
  background-color: var(--color-bg-secondary);
  margin-top: var(--space-md);
  overflow: hidden;
}

/**
 * Card layout container
 * Used for pages with card-style layout
 * Provides consistent padding for card spacing
 */
.card-container {
  padding: 0; /* No horizontal padding - cards span full width */
}

/**
 * Card wrapper - Wraps each t-cell-group to provide spacing
 * IMPORTANT: TDesign's t-cell-group does NOT support custom external-classes
 * Must wrap with <view class="card-wrapper"> to control spacing
 * Usage: <view class="card-wrapper"><t-cell-group theme="card">...</t-cell-group></view>
 */
.card-wrapper {
  margin-top: var(--space-md); /* 24rpx */
}

.card-wrapper:first-child {
  margin-top: var(--space-sm); /* 16rpx - less space at top */
}

.card-wrapper:last-child {
  margin-bottom: var(--space-md); /* 24rpx - breathing room at bottom */
}

/**
 * Page footer container
 * Used for bottom action buttons
 * Example: Most pages with action buttons at bottom
 */
.page-footer {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  padding: var(--space-md) var(--padding-page) calc(var(--space-md) + var(--safe-area-inset-bottom));
  background-color: var(--color-bg-secondary);
  border-top: 1rpx solid var(--color-separator);
}
