<!--
  Layout Container Component

  Purpose: Provides consistent page-level container with padding and background

  Props:
  - padding: 'none' | 'small' | 'medium' | 'large' (default: 'medium')
  - background: 'primary' | 'secondary' | 'tertiary' (default: 'primary')

  Usage:
  <layout-container padding="medium" background="primary">
    <view>Page content here</view>
  </layout-container>
-->

<view class="layout-container layout-container--padding-{{padding}} layout-container--bg-{{background}}">
  <slot></slot>
</view>
