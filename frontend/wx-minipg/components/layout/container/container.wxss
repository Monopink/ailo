/* Layout Container Styles */

.layout-container {
  min-height: 100vh;
  box-sizing: border-box;
}

/* Padding variants */
.layout-container--padding-none {
  padding: 0;
}

.layout-container--padding-small {
  padding: var(--space-sm);
}

.layout-container--padding-medium {
  padding: var(--padding-page);
}

.layout-container--padding-large {
  padding: var(--space-xl);
}

/* Background variants */
.layout-container--bg-primary {
  background-color: var(--color-bg-primary);
}

.layout-container--bg-secondary {
  background-color: var(--color-bg-secondary);
}

.layout-container--bg-tertiary {
  background-color: var(--color-bg-tertiary);
}
