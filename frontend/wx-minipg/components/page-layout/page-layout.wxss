/**
 * Page Layout Component Styles
 *
 * Standard styles for page-layout component.
 * Uses design tokens for all values.
 */

@import '/styles/design-tokens.wxss';

/* ========================================
   Page Layout Container
   ======================================== */

.page-layout {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  background-color: var(--color-bg-page);
  overflow: hidden;
}

/* ========================================
   Header Area - Always Visible
   ======================================== */

.page-layout__header {
  width: 100%;
  flex-shrink: 0;
  background-color: var(--color-bg-page);
}

/* ========================================
   Content Area
   ======================================== */

.page-layout__content {
  flex: 1;
  width: 100%;
  height: 0; /* Required for flex child with scroll */
  overflow-y: auto;
}

/* ========================================
   Footer Actions - Inline (Modern & Clean)
   ======================================== */

.page-layout__footer-inline {
  width: 100%;
  background-color: transparent; /* Transparent for seamless integration */
  padding: var(--space-xl) var(--padding-page);
  padding-bottom: calc(var(--space-xl) + var(--safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ========================================
   Footer Actions - Fixed (Special Cases)
   ======================================== */

.page-layout__footer-fixed {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  background-color: var(--color-bg-secondary);
  border-top: 1rpx solid var(--color-separator);
  padding-bottom: var(--safe-area-inset-bottom);
  box-sizing: border-box;
  z-index: var(--z-index-fixed);
}

/* ========================================
   State Containers (Loading, Error, Empty)
   ======================================== */

.page-layout__state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-xxl);
  text-align: center;
}
