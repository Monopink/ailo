<!--
  Action Sheet Component

  Purpose: iOS-style bottom sheet menu

  Props:
  - show: boolean - Show/hide the action sheet
  - title: string - Optional title
  - actions: Array<{text: string, type?: 'default' | 'destructive', disabled?: boolean}>
  - cancelText: string - Cancel button text (default: '取消')
  - maskClosable: boolean - Close on mask tap (default: true)

  Events:
  - select: Fired when an action is selected, detail: {index, action}
  - cancel: Fired when cancel button is tapped
  - close: Fired when action sheet is closed

  Usage:
  <ui-action-sheet
    show="{{showActions}}"
    title="选择操作"
    actions="{{actions}}"
    bind:select="onActionSelect"
    bind:close="onActionClose" />
-->

<view wx:if="{{show}}" class="ui-action-sheet {{animationClass}}">
  <!-- Mask -->
  <view class="ui-action-sheet__mask" bindtap="onMaskTap"></view>

  <!-- Content -->
  <view class="ui-action-sheet__content" catchtap="preventTap">
    <!-- Actions group -->
    <view class="ui-action-sheet__actions">
      <!-- Title -->
      <view wx:if="{{title}}" class="ui-action-sheet__title">{{title}}</view>

      <!-- Action items -->
      <view
        wx:for="{{actions}}"
        wx:key="index"
        class="ui-action-sheet__item {{item.type === 'destructive' ? 'ui-action-sheet__item--destructive' : ''}} {{item.disabled ? 'ui-action-sheet__item--disabled' : ''}}"
        data-index="{{index}}"
        bindtap="onActionTap">
        {{item.text}}
      </view>
    </view>

    <!-- Cancel button -->
    <view class="ui-action-sheet__cancel" bindtap="onCancelTap">
      {{cancelText}}
    </view>
  </view>
</view>
