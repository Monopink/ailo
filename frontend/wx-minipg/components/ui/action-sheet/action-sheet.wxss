/* Action Sheet Component Styles - iOS Style */

.ui-action-sheet {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: var(--z-index-modal);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

/* Mask */
.ui-action-sheet__mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: var(--color-bg-mask);
  opacity: 0;
  transition: opacity var(--duration-base) var(--ease-out);
}

.ui-action-sheet--show .ui-action-sheet__mask {
  opacity: 1;
}

/* Content */
.ui-action-sheet__content {
  position: relative;
  padding: var(--space-sm);
  padding-bottom: calc(var(--space-sm) + var(--safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform var(--duration-base) var(--ease-out);
}

.ui-action-sheet--show .ui-action-sheet__content {
  transform: translateY(0);
}

/* Actions group */
.ui-action-sheet__actions {
  background-color: var(--color-bg-secondary);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: var(--space-sm);
}

/* Title */
.ui-action-sheet__title {
  padding: var(--space-md);
  text-align: center;
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  border-bottom: 1px solid var(--color-separator);
}

/* Action item */
.ui-action-sheet__item {
  padding: var(--space-lg);
  text-align: center;
  font-size: var(--font-size-lg);
  color: var(--color-text-primary);
  background-color: var(--color-bg-secondary);
  transition: background-color var(--duration-fast) var(--ease-out);
  border-bottom: 1px solid var(--color-separator);
}

.ui-action-sheet__item:last-child {
  border-bottom: none;
}

.ui-action-sheet__item:active {
  background-color: var(--color-bg-hover);
}

/* Destructive action (red text) */
.ui-action-sheet__item--destructive {
  color: var(--color-error);
}

/* Disabled action */
.ui-action-sheet__item--disabled {
  color: var(--color-text-disabled);
  opacity: var(--opacity-disabled);
}

.ui-action-sheet__item--disabled:active {
  background-color: var(--color-bg-secondary);
}

/* Cancel button */
.ui-action-sheet__cancel {
  padding: var(--space-lg);
  text-align: center;
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  background-color: var(--color-bg-secondary);
  border-radius: var(--radius-lg);
  transition: background-color var(--duration-fast) var(--ease-out);
}

.ui-action-sheet__cancel:active {
  background-color: var(--color-bg-hover);
}
