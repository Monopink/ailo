.ui-avatar {
  width: var(--avatar-md);
  height: var(--avatar-md);
  border-radius: var(--radius-sm);
  overflow: hidden;
  background-color: var(--color-border-light);
  position: relative;
  flex-shrink: 0;
}

/* Image should fill the avatar container */
.ui-avatar__image {
  width: 100%;
  height: 100%;
  display: block;
}

.ui-avatar--small {
  width: var(--avatar-sm);
  height: var(--avatar-sm);
}

.ui-avatar--large {
  width: var(--avatar-lg);
  height: var(--avatar-lg);
}

.ui-avatar--xlarge {
  width: var(--avatar-xl);
  height: var(--avatar-xl);
}

.ui-avatar--circle {
  border-radius: var(--radius-full);
}

.ui-avatar__placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, var(--color-border-light), var(--color-border-base));
}

.ui-avatar__gender {
  position: absolute;
  bottom: var(--space-xs);
  right: var(--space-xs);
  width: var(--icon-xs);
  height: var(--icon-xs);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-xs);
  color: var(--color-text-inverse);
}

.ui-avatar__gender--male {
  background-color: var(--color-info);
}

.ui-avatar__gender--female {
  background-color: var(--color-warning);
}
