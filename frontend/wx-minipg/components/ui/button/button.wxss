/* Reset native button styles when using open-type */
button.ui-button {
  border: none;
  outline: none;
  line-height: inherit;
  text-align: center;
  position: relative;
  overflow: visible;
}

button.ui-button::after {
  border: none;
}

.ui-button {
  min-height: var(--button-height-md);
  padding: 0 var(--padding-button);
  border-radius: var(--radius-md);
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-normal);
  color: var(--color-text-primary);
  background-color: var(--color-bg-secondary);
  border: 1rpx solid var(--color-border-base);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  transition: opacity var(--duration-fast) var(--ease-out);
  box-sizing: border-box;
  max-width: 100%;
}

.ui-button--small {
  min-height: var(--button-height-sm);
  font-size: var(--font-size-base);
  padding: 0 var(--space-sm);
}

.ui-button--large {
  min-height: var(--button-height-lg);
  font-size: var(--font-size-lg);
  padding: 0 var(--space-lg);
}

.ui-button--primary {
  color: var(--color-primary);
}

.ui-button--secondary {
  color: var(--color-text-primary);
}

.ui-button--danger {
  color: var(--color-error);
}

.ui-button--text {
  background-color: transparent;
  border: none;
  color: var(--color-primary);
  padding: 0;
  min-height: auto;
}

.ui-button--block {
  width: 100%;
}

.ui-button--disabled {
  opacity: var(--opacity-disabled);
}

.ui-button--active {
  opacity: var(--opacity-pressed);
}

.ui-button__spinner {
  width: var(--icon-xs);
  height: var(--icon-xs);
  border: 4rpx solid var(--color-border-light);
  border-top-color: currentColor;
  border-radius: var(--radius-full);
  animation: ui-button-spin var(--duration-base) linear infinite;
}

/* Spinner color for different button types */
.ui-button--primary .ui-button__spinner {
  border-top-color: var(--color-primary);
}

.ui-button--danger .ui-button__spinner {
  border-top-color: var(--color-error);
}

.ui-button--text .ui-button__spinner {
  border-top-color: var(--color-primary);
}

.ui-button--secondary .ui-button__spinner {
  border-top-color: var(--color-text-primary);
}

@keyframes ui-button-spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}
