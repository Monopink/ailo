<view
  class="ui-cell {{link ? 'ui-cell--link' : ''}}"
  hover-class="{{hover ? 'ui-cell--hover' : ''}}"
  hover-stay-time="120"
  bindtap="handleTap">
  <block wx:if="{{icon}}">
    <image class="ui-cell__icon" src="{{icon}}" mode="aspectFill" />
  </block>
  <slot name="icon"></slot>
  <view class="ui-cell__body">
    <view class="ui-cell__title-row" wx:if="{{title || label}}">
      <text class="ui-cell__title">{{title}}</text>
      <text wx:if="{{label}}" class="ui-cell__label">{{label}}</text>
    </view>
    <text wx:if="{{!label && value}}" class="ui-cell__value">{{value}}</text>
    <slot></slot>
  </view>
  <slot name="footer">
    <view class="ui-cell__footer">
      <text wx:if="{{label && value}}" class="ui-cell__value">{{value}}</text>
      <text wx:if="{{link}}" class="ui-cell__arrow">›</text>
    </view>
  </slot>
</view>
