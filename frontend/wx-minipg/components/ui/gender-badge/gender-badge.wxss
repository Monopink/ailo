@import '/styles/design-tokens.wxss';

.gender-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  line-height: 1;
  flex-shrink: 0;
}

/* Male - Light Blue */
.gender-badge--1 {
  color: var(--color-gender-male);
}

/* Female - Light Pink */
.gender-badge--2 {
  color: var(--color-gender-female);
}

/* Other - Light Purple */
.gender-badge--3 {
  color: var(--color-gender-other);
}

/* Unknown - Light Gray */
.gender-badge--0,
.gender-badge--4 {
  color: var(--color-gender-unknown);
}
