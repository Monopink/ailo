@import '/styles/design-tokens.wxss';

.ui-gender-badge {
  font-size: var(--font-size-lg);
  line-height: 1;
  vertical-align: middle;
}

.ui-gender-badge--0 {
  color: var(--color-gender-unknown);
  opacity: 0.6;
}

.ui-gender-badge--1 {
  color: var(--color-gender-male);
  opacity: 0.6;
}

.ui-gender-badge--2 {
  color: var(--color-gender-female);
  opacity: 0.6;
}

.ui-gender-badge--3 {
  color: var(--color-gender-other);
  opacity: 0.6;
}
