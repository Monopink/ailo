<!--
  Icon Component

  Purpose: Display icons using CSS-based graphics

  Props:
  - name: 'more-horizontal' (currently only this icon is supported)
  - size: 'small' | 'medium' | 'large' (default: 'medium')
  - color: 'primary' | 'secondary' | 'tertiary' (default: 'secondary')

  Usage:
  <ui-icon name="more-horizontal" size="medium" color="secondary" />
-->

<view class="ui-icon ui-icon--{{size}} ui-icon--{{name}} ui-icon--{{color}}">
  <view wx:if="{{name === 'more-horizontal'}}" class="ui-icon__dot"></view>
</view>
