/* Icon Component Styles */

.ui-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: var(--icon-md);
  height: var(--icon-md);
  position: relative;
}

/* Size variants */
.ui-icon--small {
  width: var(--icon-sm);
  height: var(--icon-sm);
}

.ui-icon--large {
  width: var(--icon-lg);
  height: var(--icon-lg);
}

/* More icon (three dots) - horizontal */
.ui-icon--more-horizontal::before,
.ui-icon--more-horizontal::after,
.ui-icon--more-horizontal {
  content: '';
}

.ui-icon--more-horizontal::before,
.ui-icon--more-horizontal::after {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  border-radius: var(--radius-full);
  background-color: currentColor;
}

.ui-icon--more-horizontal::before {
  left: 25%;
  transform: translateX(-50%);
}

.ui-icon--more-horizontal::after {
  right: 25%;
  transform: translateX(50%);
}

/* Center dot */
.ui-icon--more-horizontal .ui-icon__dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: var(--radius-full);
  background-color: currentColor;
}

/* Color variants */
.ui-icon--primary {
  color: var(--color-primary);
}

.ui-icon--secondary {
  color: var(--color-text-secondary);
}

.ui-icon--tertiary {
  color: var(--color-text-tertiary);
}
