<view class="ui-message-bubble ui-message-bubble--{{normalizedDirection}}">
  <image
    wx:if="{{avatar}}"
    class="ui-message-bubble__avatar"
    src="{{avatar}}"
    mode="aspectFill"
  />

  <view class="ui-message-bubble__wrapper">
    <view class="ui-message-bubble__bubble">
      <slot>{{text}}</slot>
    </view>
    <view class="ui-message-bubble__meta">
      <text class="ui-message-bubble__time" wx:if="{{time}}">{{time}}</text>
      <text
        class="ui-message-bubble__status ui-message-bubble__status--{{status}}"
        wx:if="{{statusLabel}}">
        {{statusLabel}}
      </text>
    </view>
  </view>
</view>
