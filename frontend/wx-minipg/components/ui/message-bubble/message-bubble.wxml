<view class="message-bubble message-bubble--{{direction}}">
  <view wx:if="{{direction === 'received' && showAvatar}}" class="message-bubble__avatar">
    <ui-avatar src="{{avatarUrl}}" size="medium" />
  </view>

  <view class="message-bubble__panel">
    <view class="message-bubble__body">
      <text class="message-bubble__text">{{content}}</text>
    </view>
    <view class="message-bubble__meta">
      <text wx:if="{{showTime && formattedTime}}" class="message-bubble__time">
        {{formattedTime}}
      </text>
      <text
        wx:if="{{statusLabel && direction === 'sent'}}"
        class="message-bubble__status {{status === 'failed' ? 'message-bubble__status--error' : ''}}">
        {{statusLabel}}
      </text>
    </view>
  </view>

  <view wx:if="{{direction === 'sent' && showAvatar}}" class="message-bubble__avatar">
    <ui-avatar src="{{avatarUrl}}" size="medium" />
  </view>
</view>
