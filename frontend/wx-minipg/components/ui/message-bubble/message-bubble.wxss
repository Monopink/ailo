@import '/styles/design-tokens.wxss';

.ui-message-bubble {
  display: flex;
  align-items: flex-end;
  gap: var(--space-sm);
  margin: var(--space-xs) 0;
}

.ui-message-bubble--outgoing {
  justify-content: flex-end;
}

.ui-message-bubble__avatar {
  width: var(--avatar-sm);
  height: var(--avatar-sm);
  border-radius: var(--radius-full);
  object-fit: cover;
}

.ui-message-bubble__wrapper {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  max-width: var(--message-bubble-max-width);
}

.ui-message-bubble__bubble {
  padding: var(--space-sm);
  border-radius: var(--radius-bubble);
  background-color: var(--color-bg-secondary);
  color: var(--color-text-primary);
  font-size: var(--font-size-base);
  line-height: var(--line-height-base);
  box-shadow: var(--shadow-xs);
}

.ui-message-bubble--outgoing .ui-message-bubble__bubble {
  background-color: var(--color-primary);
  color: var(--color-text-inverse);
}

.ui-message-bubble__meta {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

.ui-message-bubble__status {
  font-size: var(--font-size-xs);
}

.ui-message-bubble__status--failed {
  color: var(--color-error);
}
