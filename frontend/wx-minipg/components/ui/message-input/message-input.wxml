<view class="message-input">
  <view wx:if="{{showEmoji}}" class="message-input__emoji" bindtap="handleEmojiTap">
    <text>😊</text>
  </view>

  <textarea
    class="message-input__textarea"
    value="{{value}}"
    placeholder="{{placeholder}}"
    disabled="{{disabled || sending}}"
    maxlength="{{maxLength}}"
    auto-height="{{true}}"
    auto-focus="{{autoFocus}}"
    show-confirm-bar="{{false}}"
    bindinput="handleInput"
    bindfocus="handleFocus"
    bindblur="handleBlur"
    bindconfirm="handleConfirm" />

  <ui-button
    type="primary"
    size="small"
    loading="{{sending}}"
    disabled="{{!value || disabled || sending}}"
    bindtap="handleSend">
    发送
  </ui-button>

  <view wx:if="{{showExtra}}" class="message-input__extra" bindtap="handleExtraTap">
    <text>＋</text>
  </view>
</view>

<view wx:if="{{maxLength}}" class="message-input__counter">
  <text>{{(value || '').length}} / {{maxLength}}</text>
</view>
