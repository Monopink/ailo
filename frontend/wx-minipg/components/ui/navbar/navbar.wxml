<view class="ui-navbar" style="height: {{totalHeight}}px;">
  <!-- Status bar placeholder -->
  <view class="ui-navbar__status-bar" style="height: {{statusBarHeight}}px;"></view>

  <!-- Navigation bar content -->
  <view class="ui-navbar__content" style="height: {{navBarHeight}}px;">
    <!-- Back button -->
    <view wx:if="{{showBack}}" class="ui-navbar__back" bindtap="onBackTap">
      <view class="ui-navbar__back-icon"></view>
    </view>

    <!-- Title -->
    <view
      class="ui-navbar__title {{clickable ? 'ui-navbar__title--clickable' : ''}}"
      bindtap="onTitleTap">
      {{title}}
    </view>

    <!-- Right slot for custom actions -->
    <view class="ui-navbar__right">
      <slot name="right"></slot>
    </view>
  </view>
</view>
