/* Phone Input Component Styles
 * CSS variables are inherited from page-level styles
 */

.phone-input {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

/* Country code display - independent box on the left (fixed at +86) */
.phone-input__country {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 var(--space-md);
  background-color: var(--color-bg-secondary);
  border: var(--border-width-thin) solid var(--color-border-base);
  border-radius: var(--radius-input);
  flex-shrink: 0;
}

.phone-input__country-code {
  font-size: var(--font-size-md);
  color: var(--color-text-primary);
  font-weight: var(--font-weight-medium);
  white-space: nowrap;
}

/* Phone input field - independent box on the right */
.phone-input__field {
  flex: 1;
  min-width: 0;
}
