.ui-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 var(--space-sm);
  border-radius: 6rpx;
  font-size: var(--font-size-sm);
  line-height: 1;
  height: var(--button-height-sm);
  border: 1px solid transparent;
}

.ui-tag--small {
  height: var(--button-height-sm);
  padding: 0 var(--space-xs);
}

.ui-tag--default.ui-tag--solid {
  background-color: var(--color-bg-hover);
  color: var(--color-text-secondary);
}

.ui-tag--success.ui-tag--solid {
  background-color: var(--color-success);
  color: var(--color-text-inverse);
}

.ui-tag--warning.ui-tag--solid {
  background-color: var(--color-warning);
  color: var(--color-text-inverse);
}

.ui-tag--danger.ui-tag--solid {
  background-color: var(--color-error);
  color: var(--color-text-inverse);
}

.ui-tag--outline {
  background-color: transparent;
  border-color: currentColor;
}

.ui-tag--default.ui-tag--outline {
  color: var(--color-text-secondary);
}

.ui-tag--success.ui-tag--outline {
  color: var(--color-success);
}

.ui-tag--warning.ui-tag--outline {
  color: var(--color-warning);
}

.ui-tag--danger.ui-tag--outline {
  color: var(--color-error);
}
