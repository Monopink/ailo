<view class="tab-bar theme-scope">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-item {{active === index ? 'active' : ''}}"
    bindtap="onTabChange"
    data-index="{{index}}"
  >
    <t-icon
      class="tab-icon"
      name="{{active === index ? item.activeIcon : item.icon}}"
      size="{{item.iconSize}}" />
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>
