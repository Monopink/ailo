.tab-bar {
  display: flex;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: calc(var(--tabbar-height) + var(--safe-area-inset-bottom));
  box-sizing: border-box;
  background-color: var(--color-tabbar-glass-bg);
  border-top: 1rpx solid var(--color-separator);
  -webkit-backdrop-filter: blur(var(--tabbar-glass-blur));
  backdrop-filter: blur(var(--tabbar-glass-blur));
  padding-bottom: var(--safe-area-inset-bottom);
  z-index: var(--z-index-fixed);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: var(--tabbar-padding-top);
}

.tab-icon {
  font-size: var(--tabbar-icon-size);
  color: var(--color-text-tertiary);
  line-height: 1;
}

.tab-text {
  color: var(--color-text-tertiary);
  font-size: var(--tabbar-text-size);
  margin-top: var(--tabbar-text-gap);
  font-weight: 400;
  transition: color var(--duration-fast) var(--ease-out);
}

.tab-item.active .tab-text {
  color: var(--color-primary);
  font-weight: 500;
}

.tab-item.active .tab-icon {
  color: var(--color-primary);
}
