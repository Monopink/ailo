{
  "name": "says-miniprogram",
  "version": "1.0.0",
  "description": "Says AI Chat MiniProgram",
  "scripts": {
    "build:ts": "tsc",
    "build": "npm run build:ts",
    "watch": "tsc --watch",
    "lint": "eslint . --ext .ts,.js,.wxml",
    "lint:fix": "eslint . --ext .ts,.js,.wxml --fix",
    "lint:style": "stylelint \"components/ui/**/*.wxss\" \"components/page-layout/**/*.wxss\" \"pages/index/**/*.wxss\" \"pages/chat/**/*.wxss\" app.wxss",
    "format": "prettier --write \"**/*.{ts,js,json,wxss}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,wxss}\"",
    "type-check": "tsc --noEmit",
    "ui:audit": "node ./ui-audit.cjs",
    "check": "npm run type-check && npm run lint && npm run lint:style && npm run ui:audit",
    "test": "npm run check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@wxml/parser": "^0.4.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-wxml": "^0.8.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "miniprogram-api-typings": "^3.12.2",
    "prettier": "^3.2.0",
    "stylelint": "^16.2.1",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-declaration-strict-value": "^1.9.2",
    "typescript": "^5.3.0"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,wxss}": [
      "prettier --write"
    ],
    "*.wxml": [
      "eslint --fix"
    ]
  },
  "stylelint": {
    "extends": [
      "stylelint-config-standard"
    ],
    "ignoreFiles": [
      "node_modules/**/*",
      "dist/**/*"
    ],
    "rules": {
      "color-no-hex": true,
      "selector-class-pattern": [
        "^[a-z0-9-]+(?:__[a-z0-9-]+)?(?:--[a-z0-9-]+)?$",
        {
          "resolveNestedSelectors": true,
          "message": "Use BEM naming (block__element--modifier)"
        }
      ],
      "selector-type-no-unknown": [
        true,
        {
          "ignoreTypes": [
            "page"
          ]
        }
      ],
      "import-notation": null,
      "unit-no-unknown": [
        true,
        {
          "ignoreUnits": [
            "rpx"
          ]
        }
      ],
      "unit-allowed-list": [
        "rpx",
        "%",
        "deg",
        "turn",
        "s",
        "ms",
        "vh",
        "vw",
        "px"
      ],
      "value-keyword-case": null,
      "font-family-name-quotes": null,
      "rule-empty-line-before": null,
      "property-no-vendor-prefix": true,
      "declaration-block-no-redundant-longhand-properties": null
    },
    "overrides": [
      {
        "files": [
          "styles/design-tokens.wxss"
        ],
        "rules": {
          "color-no-hex": null
        }
      }
    ]
  }
}
