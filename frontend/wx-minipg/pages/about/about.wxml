<page-layout
  isLoading="{{pageLayoutData.isLoading}}"
  hasError="{{pageLayoutData.hasError}}"
  errorMessage="{{pageLayoutData.errorMessage}}"
  isEmpty="{{pageLayoutData.isEmpty}}"
  emptyMessage="{{pageLayoutData.emptyMessage}}"
  hasFooter="{{pageLayoutData.hasFooter}}"
  bind:retry="onRetry">
  <view slot="content" class="about card-container">
    <!-- App info card -->
    <view class="card-wrapper">
      <t-cell-group theme="card">
        <t-cell title="敲敲" note="版本 {{version}}" align="middle">
          <view slot="left-icon" class="about__logo">
            <text class="about__logo-text">敲</text>
          </view>
        </t-cell>
      </t-cell-group>
    </view>

    <!-- Links card -->
    <view class="card-wrapper">
      <t-cell-group theme="card">
        <t-cell
          title="用户协议"
          arrow
          hover
          bindtap="navigateToUserAgreement" />
        <t-cell
          title="隐私政策"
          arrow
          hover
          bindtap="navigateToPrivacyPolicy" />
      </t-cell-group>
    </view>

    <!-- Copyright -->
    <view class="about__footer">
      <text class="about__copyright">© 2025 敲敲</text>
    </view>
  </view>
</page-layout>
