<view class="account-security-page">
  <!-- Loading state -->
  <view wx:if="{{loading}}" class="loading-container">
    <text>加载中...</text>
  </view>

  <!-- Error state -->
  <view wx:elif="{{error}}" class="error-container">
    <text>{{error}}</text>
    <button bindtap="loadAccount">重试</button>
  </view>

  <!-- Account security content -->
  <view wx:else class="account-security-content">
    <!-- Phone -->
    <view class="security-item" bindtap="managePhone">
      <text class="label">手机号</text>
      <view class="value-with-arrow">
        <text class="value">{{account.phone}}</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <!-- Email -->
    <view class="security-item" bindtap="manageEmail">
      <text class="label">邮箱</text>
      <view class="value-with-arrow">
        <text class="value">{{account.email || '未绑定'}}</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <!-- Password -->
    <view class="security-item" bindtap="managePassword">
      <text class="label">密码</text>
      <view class="value-with-arrow">
        <text class="value">{{account.has_password ? '已设置' : '未设置'}}</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>
</view>