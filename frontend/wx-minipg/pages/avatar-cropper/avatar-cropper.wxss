@import '/styles/tdesign-theme.wxss';
@import '/styles/design-tokens.wxss';

.avatar-cropper {
  min-height: 100vh;
  padding: var(--space-xl) var(--space-lg);
  display: flex;
  flex-direction: column;
  gap: var(--space-xl);
  background-color: var(--color-bg-primary);
}

.avatar-cropper__panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-md);
}

.avatar-cropper__area {
  position: relative;
  border-radius: var(--radius-md);
  overflow: hidden;
  background-color: var(--color-bg-secondary);
}

.avatar-cropper__movable {
  position: absolute;
}

.avatar-cropper__image {
  display: block;
}

.avatar-cropper__mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgb(0 0 0 / 40%);
  pointer-events: none;
}

.avatar-cropper__frame {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border: 2rpx solid rgb(255 255 255 / 85%);
  box-shadow: inset 0 0 0 2rpx rgb(0 0 0 / 25%);
  pointer-events: none;
}

.avatar-cropper__hint {
  font-size: var(--font-size-sm);
  color: var(--color-text-placeholder);
}

.avatar-cropper__loading {
  text-align: center;
  color: var(--color-text-secondary);
  padding: var(--space-lg) 0;
}

.avatar-cropper__actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.avatar-cropper__canvas {
  position: absolute;
  width: 512px;
  height: 512px;
  left: -2000px;
  top: -2000px;
}
