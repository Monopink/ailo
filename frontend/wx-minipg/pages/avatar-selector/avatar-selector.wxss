@import '/styles/design-tokens.wxss';

.avatar-selector {
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
  padding: var(--padding-page);
  background-color: var(--color-bg-page);
}

.avatar-selector__grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-sm);
}

.avatar-selector__item {
  position: relative;
  border-radius: var(--radius-md);
  overflow: hidden;
  border: var(--border-width-medium) solid transparent;
  background-color: var(--color-bg-card);
}

.avatar-selector__item--selected {
  border-color: var(--color-primary);
}

.avatar-selector__image {
  width: 100%;
  height: 100%;
}

.avatar-selector__badge {
  position: absolute;
  top: var(--space-xs);
  right: var(--space-xs);
  padding: 0 var(--space-xs);
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  color: var(--color-text-inverse);
  background-color: rgba(0, 0, 0, 0.4);
}

.avatar-selector__footer {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  padding: var(--space-md) var(--space-lg) calc(var(--space-md) + var(--safe-area-inset-bottom));
  background-color: var(--color-bg-card);
  border-top: 1rpx solid var(--color-border-base);
}
