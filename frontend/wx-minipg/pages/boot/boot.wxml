<page-layout
  isLoading="{{pageLayoutData.isLoading}}"
  hasError="{{pageLayoutData.hasError}}"
  errorMessage="{{pageLayoutData.errorMessage}}"
  isEmpty="{{pageLayoutData.isEmpty}}"
  emptyMessage="{{pageLayoutData.emptyMessage}}"
  hasFooter="{{pageLayoutData.hasFooter}}">
  <view slot="content" class="boot-page">
    <image class="boot-page__logo" src="/assets/logo.png" mode="aspectFit" />
    <view class="boot-page__text">
      <text class="boot-page__brand">敲敲</text>
      <text class="boot-page__subtitle">AI 陪伴 · 实时共鸣</text>
      <text class="boot-page__status">正在为你准备聊天体验…</text>
    </view>
    <ui-loading text="正在进入" />
  </view>
</page-layout>
