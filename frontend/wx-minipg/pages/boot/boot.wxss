/* Minimal splash-like layout */
.boot-container {
  display: flex;
  height: 100vh;
  background-color: #ffffff;
}

.boot-center {
  margin: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.boot-logo {
  width: 160rpx;
  height: 160rpx;
}

.boot-brand {
  font-size: 36rpx;
  color: #333;
}
