<page-layout
  style="--color-bg-page: var(--color-bg-white); --color-bg-footer-fixed: var(--color-bg-muted); --footer-glass-blur: 0rpx; --color-navbar-glass-bg: {{navbarSolid ? 'var(--color-navbar-glass-bg-base)' : 'transparent'}};"
  screenState="{{pageLayoutData.screenModel.screenState}}"
  contentVariant="{{pageLayoutData.screenModel.contentVariant}}"
  refreshState="{{pageLayoutData.screenModel.refreshState}}"
  emptyMessage="{{pageLayoutData.emptyMessage}}"
  hasFooter="{{pageLayoutData.hasFooter}}"
  fixedFooter="{{true}}"
  disableScroll="{{true}}"
  headerSolidMode="manual"
  headerSolid="{{false}}">
  <!-- Custom Navbar -->
  <view slot="header" class="chat-page__header {{navbarSolid ? 'chat-page__header--solid' : ''}}">
    <t-navbar left-arrow="{{true}}">
      <view slot="title" class="navbar-title chat-navbar__title" bindtap="onNavbarTitleClick">
        <text wx:if="{{isContactTyping}}" class="navbar-title chat-navbar__title-text chat-navbar__typing-text">对方正在输入...</text>
        <text wx:else class="navbar-title chat-navbar__title-text">{{navbarTitle}}</text>
      </view>
    </t-navbar>
  </view>

  <!-- Chat Content -->
  <view slot="content" class="chat-page__content">
    <scroll-view
      scroll-y
      enhanced="{{true}}"
      show-scrollbar="{{false}}"
      class="chat-page__messages {{showEmojiPanel ? 'chat-page__messages--with-emoji-panel' : ''}}"
      scroll-into-view="{{pageLayoutData.contentScrollIntoView}}"
      scroll-with-animation="{{pageLayoutData.contentScrollWithAnimation}}"
      bindscroll="onMessageScroll">
      <!-- Messages -->
      <block wx:for="{{messages}}" wx:key="msg_id">
        <!-- Timestamp -->
        <view wx:if="{{item.showTimestamp}}" class="chat-timestamp">
          {{item.timestampText}}
        </view>

        <!-- Info Message -->
        <view wx:if="{{item.isInfoMessage}}" class="chat-info-msg">
          {{item.infoContent}}
        </view>

        <!-- Normal Message -->
        <view wx:else class="msg-row {{item.from_me ? 'msg-row-me' : 'msg-row-other'}}" id="msg-{{item.msg_id}}">
          <!-- My messages (right side): status - bubble - avatar -->
          <block wx:if="{{item.from_me}}">
            <view
              wx:if="{{item.status === 3}}"
              class="msg-status-icon"
              bindtap="onRetryMessage"
              data-msgid="{{item.msg_id}}">
              <t-icon name="error-circle" size="40rpx" class="msg-status-icon__icon" />
            </view>

            <view class="msg-bubble msg-bubble-me">
              <text class="msg-text">{{item.content}}</text>
            </view>

            <view class="msg-avatar">
              <t-avatar image="{{userAvatar}}" size="small" shape="circle" />
            </view>
          </block>

          <!-- Other messages (left side): avatar - bubble -->
          <block wx:else>
            <view class="msg-avatar">
              <t-avatar image="{{contactAvatar}}" size="small" shape="circle" />
            </view>

            <view class="msg-bubble msg-bubble-other">
              <text class="msg-text">{{item.content}}</text>
            </view>
          </block>
        </view>
      </block>

      <!-- Typing Indicator removed: keep navbar text only -->
      <view id="scroll-anchor-{{scrollAnchorKey}}" class="chat-scroll-anchor"></view>
    </scroll-view>
  </view>

  <!-- Chat Footer: Input Bar + Emoji Panel -->
  <view slot="footer" class="chat-page__footer">
    <view class="chat-footer">
      <!-- Emoji Button -->
      <view class="chat-footer__emoji-btn" bindtap="onEmojiButtonTap">
        <image class="chat-footer__emoji-icon" src="/assets/icons/emoji.svg" mode="aspectFit" />
      </view>

      <!-- Input field -->
      <view class="chat-footer__input-wrapper">
        <input
          class="chat-footer__input"
          type="text"
          placeholder="{{inputPlaceholder}}"
          placeholder-class="chat-footer__input-placeholder"
          value="{{inputText}}"
          bindinput="onInputChange"
          bindfocus="onInputFocus"
          bindblur="onInputBlur"
          bindconfirm="onSendMessage"
          bindcompositionstart="onCompositionStart"
          bindcompositionend="onCompositionEnd"
          maxlength="{{maxMessageLength}}"
          confirm-type="send"
          ignoreCompositionEvent="{{false}}"
          show-confirm-bar="{{false}}"
          adjust-position="{{true}}"
          cursor-spacing="16"
          focus="{{inputFocused}}" />
      </view>

      <!-- Send button - circular WeChat style with SVG icon -->
      <view
        class="chat-footer__send-button {{inputText ? 'chat-footer__send-button--active' : ''}}"
        bindtap="onSendMessage">
        <image
          class="chat-footer__send-icon"
          src="{{inputText ? sendIconActive : sendIconInactive}}"
          mode="aspectFit" />
      </view>
    </view>

    <!-- Emoji Panel -->
    <view wx:if="{{showEmojiPanel}}" class="chat-emoji-panel">
      <view class="chat-emoji-panel__list">
        <view
          wx:for="{{emojiList}}"
          wx:key="index"
          class="chat-emoji-panel__item"
          bindtap="onEmojiSelect"
          data-emoji="{{item}}">
          {{item}}
        </view>
      </view>
    </view>
  </view>
</page-layout>
