<!-- Floating navbar -->
<ui-navbar
  title="{{navbarTitle}}"
  showBack="{{true}}"
  clickable="{{true}}"
  bind:titleclick="onNavbarTitleClick"
  bind:ready="onNavbarReady" />

<page-layout
  isLoading="{{pageLayoutData.isLoading}}"
  hasError="{{pageLayoutData.hasError}}"
  errorMessage="{{pageLayoutData.errorMessage}}"
  isEmpty="{{pageLayoutData.isEmpty}}"
  emptyMessage="{{pageLayoutData.emptyMessage}}"
  hasFooter="{{pageLayoutData.hasFooter}}"
  fixedFooter="{{true}}"
  contentScrollIntoView="{{pageLayoutData.contentScrollIntoView}}"
  contentScrollWithAnimation="{{pageLayoutData.contentScrollWithAnimation}}"
  bind:retry="onRetry">
  <view slot="content" class="chat-page" style="padding-top: {{navbarHeight}}px;">
    <view class="chat-page__messages">
      <view wx:if="{{!messages.length && !pageLayoutData.isLoading}}" class="chat-placeholder">
        <text class="chat-placeholder__text">开始和对方聊天吧～</text>
      </view>

      <block wx:for="{{messages}}" wx:key="msg_id">
        <view wx:if="{{item.showTimestamp}}" class="chat-timestamp">
          {{item.timestampText}}
        </view>

        <view wx:if="{{item.isSystemMessage}}" class="chat-system-msg">
          {{item.systemContent}}
        </view>

        <view wx:else class="msg-row {{item.from_me ? 'msg-row-me' : 'msg-row-other'}}" id="msg-{{item.msg_id}}">
          <!-- For "my messages" (right side): status icon - bubble - avatar -->
          <block wx:if="{{item.from_me}}">
            <view
              wx:if="{{item.status === 3}}"
              class="msg-status-icon"
              bindtap="onRetryMessage"
              data-msgid="{{item.msg_id}}">
              !
            </view>

            <view class="msg-bubble msg-bubble-me">
              <text class="msg-text">{{item.content}}</text>
            </view>

            <view class="msg-avatar">
              <ui-avatar src="{{userAvatar}}" size="medium" />
            </view>
          </block>

          <!-- For "other messages" (left side): avatar - bubble -->
          <block wx:else>
            <view class="msg-avatar">
              <ui-avatar src="{{contactAvatar}}" size="medium" />
            </view>

            <view class="msg-bubble msg-bubble-other">
              <text class="msg-text">{{item.content}}</text>
            </view>
          </block>
        </view>
      </block>

      <view wx:if="{{isContactTyping}}" class="msg-row msg-row-other typing-row">
        <view class="msg-avatar">
          <ui-avatar src="{{contactAvatar}}" size="medium" />
        </view>
        <view class="msg-bubble msg-bubble-other typing-indicator">
          <view class="typing-dot"></view>
          <view class="typing-dot"></view>
          <view class="typing-dot"></view>
        </view>
      </view>
    </view>
  </view>

  <view slot="footer">
    <!-- Input bar -->
    <view class="chat-footer">
      <!-- Input field -->
      <view class="chat-footer__input-wrapper">
        <input
          class="chat-footer__input"
          type="text"
          placeholder="{{inputPlaceholder}}"
          placeholder-class="chat-footer__input-placeholder"
          value="{{inputText}}"
          bindinput="onInputChange"
          bindfocus="onInputFocus"
          bindblur="onInputBlur"
          bindconfirm="onSendMessage"
          bindcompositionstart="onCompositionStart"
          bindcompositionend="onCompositionEnd"
          maxlength="{{maxMessageLength}}"
          confirm-type="send"
          ignoreCompositionEvent="{{false}}"
          show-confirm-bar="{{false}}"
          adjust-position="{{true}}"
          cursor-spacing="16"
          focus="{{inputFocused}}" />
      </view>

      <!-- Send button - circular WeChat style -->
      <view
        class="chat-footer__send-button {{inputText ? 'chat-footer__send-button--active' : ''}}"
        bindtap="onSendMessage">
        <view class="chat-footer__send-icon"></view>
      </view>
    </view>
  </view>
</page-layout>
