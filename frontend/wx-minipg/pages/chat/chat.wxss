@import '/styles/design-tokens.wxss';

.chat-page {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.chat-page__messages {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  padding: var(--space-md);
  box-sizing: border-box;
}

.chat-placeholder {
  width: 100%;
  padding: var(--space-xl);
  text-align: center;
  color: var(--color-text-tertiary);
}

.chat-placeholder__text {
  font-size: var(--font-size-base);
  line-height: var(--line-height-base);
}

.chat-timestamp,
.chat-system-msg {
  align-self: center;
  padding: var(--space-xs) var(--space-sm);
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  line-height: var(--line-height-base);
}

.msg-row {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.msg-row-me {
  justify-content: flex-end;
}

.msg-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.msg-status-icon {
  width: var(--icon-sm);
  height: var(--icon-sm);
  border-radius: var(--radius-full);
  background-color: var(--color-error);
  color: var(--color-text-inverse);
  font-size: var(--font-size-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  cursor: pointer;
}

.msg-bubble {
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-md);
  background-color: var(--color-bg-card);
  color: var(--color-text-primary);
  max-width: var(--message-bubble-max-width);
  word-wrap: break-word;
}

.msg-bubble-me {
  background-color: var(--color-primary-light);
  color: var(--color-text-inverse);
  border-radius: var(--radius-md) var(--radius-xs) var(--radius-md) var(--radius-md);
}

.msg-bubble-other {
  border-radius: var(--radius-xs) var(--radius-md) var(--radius-md) var(--radius-md);
}

.msg-text {
  font-size: var(--font-size-md);
  line-height: var(--line-height-base);
  white-space: pre-wrap;
}

.typing-indicator {
  display: flex;
  gap: var(--space-xs);
  align-items: center;
}

.typing-dot {
  width: var(--typing-dot-size);
  height: var(--typing-dot-size);
  border-radius: var(--radius-full);
  background-color: var(--color-text-tertiary);
  animation: typing-bounce 1.4s infinite ease-in-out;
}

.typing-dot:nth-child(2) {
  animation-delay: 0.15s;
}

.typing-dot:nth-child(3) {
  animation-delay: 0.3s;
}

@keyframes typing-bounce {
  0%,
  60%,
  100% {
    transform: translateY(0);
    opacity: 0.6;
  }
  30% {
    transform: translateY(-10rpx);
    opacity: 1;
  }
}

/* Chat footer - WeChat style */
.chat-footer {
  display: flex;
  align-items: flex-end;
  gap: var(--space-sm);
  padding: var(--space-sm) var(--space-md);
  background-color: var(--color-bg-secondary);
  border-top: 1rpx solid var(--color-border-light);
}

/* Input wrapper */
.chat-footer__input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  min-height: 64rpx;
  padding: 0 var(--space-md);
  border-radius: 12rpx;
  background-color: var(--color-bg-input);
  border: 1rpx solid var(--color-border-light);
}

.chat-footer__input {
  width: 100%;
  font-size: var(--font-size-md);
  color: var(--color-text-primary);
  line-height: var(--line-height-base);
}

.chat-footer__input-placeholder {
  color: var(--color-text-placeholder);
}

/* Send button - circular WeChat style */
.chat-footer__send-button {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 50%;
  background-color: var(--color-bg-disabled);
  transition: all var(--duration-fast) var(--ease-out);
}

.chat-footer__send-button--active {
  background-color: var(--color-primary);
}

.chat-footer__send-button:active {
  transform: scale(0.95);
}

/* Send icon - arrow pointing up */
.chat-footer__send-icon {
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-bottom: 16rpx solid var(--color-text-quaternary);
  transition: border-color var(--duration-fast) var(--ease-out);
}

.chat-footer__send-button--active .chat-footer__send-icon {
  border-bottom-color: var(--color-text-inverse);
}
