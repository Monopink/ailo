/* Chat page styles */

.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #EDEDED;
}

/* Message list */
.message-list {
  flex: 1;
  padding: 24rpx 16rpx;
}

/* Timestamp */
.message-timestamp {
  text-align: center;
  margin: 24rpx 0;
}

.message-timestamp text {
  font-size: 24rpx;
  color: #888888;
}

/* System message */
.system-message {
  text-align: center;
  margin: 24rpx 0;
}

.system-message text {
  font-size: 24rpx;
  color: #888888;
}

/* Message item */
.message-item {
  display: flex;
  margin-bottom: 24rpx;
}

.message-item.from-me {
  flex-direction: row-reverse;
}

.message-item.from-other {
  flex-direction: row;
}

/* Avatar */
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.message-item.from-me .avatar {
  margin-left: 16rpx;
}

.message-item.from-other .avatar {
  margin-right: 16rpx;
}

/* Message content wrapper */
.message-content {
  max-width: 480rpx;
  display: flex;
  align-items: center;
}

.message-item.from-me .message-content {
  flex-direction: row-reverse;
}

.message-item.from-other .message-content {
  flex-direction: row;
}

/* Text message bubble */
.text-message {
  padding: 20rpx 24rpx;
  border-radius: 8rpx;
  word-wrap: break-word;
  word-break: break-all;
  max-width: 100%;
}

/* Status indicator for failed messages */
.status-indicator.failed {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background-color: #FF4D4F;
  color: #FFFFFF;
  font-size: 22rpx;
  line-height: 28rpx;
  text-align: center;
  margin: 0 12rpx;
}

.message-item.from-me .text-message {
  background-color: #95EC69;
  color: #000000;
}

.message-item.from-other .text-message {
  background-color: #FFFFFF;
  color: #000000;
}

.text-message text {
  font-size: 30rpx;
  line-height: 1.5;
}

/* Input bar */
.input-bar {
  display: flex;
  align-items: flex-end;
  padding: 16rpx 24rpx;
  background-color: #F7F7F7;
  border-top: 1rpx solid #E5E5E5;
}

.input-wrapper {
  flex: 1;
  background-color: #FFFFFF;
  border-radius: 8rpx;
  padding: 16rpx 24rpx;
  margin-right: 16rpx;
  min-height: 72rpx;
  max-height: 200rpx;
}

.input-text {
  width: 100%;
  font-size: 30rpx;
  line-height: 1.5;
}

.send-button {
  width: 120rpx;
  height: 72rpx;
  border-radius: 8rpx;
  background-color: #E5E5E5;
  color: #888888;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.send-button.active {
  background-color: #07C160;
  color: #FFFFFF;
}
