<page-layout
  isLoading="{{pageLayoutData.isLoading}}"
  hasError="{{pageLayoutData.hasError}}"
  errorMessage="{{pageLayoutData.errorMessage}}"
  isEmpty="{{pageLayoutData.isEmpty}}"
  emptyMessage="{{pageLayoutData.emptyMessage}}"
  hasFooter="{{pageLayoutData.hasFooter}}"
  bind:retry="refreshContactInfo">
  <t-navbar slot="header" left-arrow="{{true}}">
    <view slot="title" class="navbar-title">联系人详情</view>
  </t-navbar>
  <view slot="content" class="contact-info">
    <view wx:if="{{contact}}">
      <!-- Header Section - Avatar and Name -->
      <view class="contact-info__header">
        <t-avatar
          image="{{contact.displayAvatar}}"
          size="128rpx"
          shape="circle"
          class="contact-info__avatar" />

        <view class="contact-info__name-row">
          <text class="contact-info__name">{{contact.alias || contact.profile.nickname}}</text>
          <gender-badge wx:if="{{contact.gender}}" gender="{{contact.gender}}" />
        </view>

        <text class="contact-info__qiao-id">敲敲号：{{contact.contact_qiao_id}}</text>
      </view>

      <!-- Cards Section -->
      <view class="contact-info__cards card-container">
        <!-- Bio Card -->
        <view wx:if="{{contact.bio}}" class="card-wrapper">
          <t-cell-group theme="card">
            <t-cell title="个性签名" note="{{contact.bio}}" />
          </t-cell-group>
        </view>

        <!-- Tags Card -->
        <view wx:if="{{contact.tags && contact.tags.length}}" class="card-wrapper">
          <t-cell-group theme="card">
            <t-cell title="标签">
              <view slot="note" class="contact-info__tags">
                <t-tag
                  wx:for="{{contact.tags}}"
                  wx:key="*this"
                  size="small"
                  variant="outline">
                  {{item}}
                </t-tag>
              </view>
            </t-cell>
          </t-cell-group>
        </view>

        <!-- Settings Card -->
        <view class="card-wrapper">
          <t-cell-group theme="card">
            <t-cell title="备注和标签" arrow hover bindtap="editRemarkAndTags" />
          </t-cell-group>
        </view>

        <!-- Preferences Card -->
        <view class="card-wrapper">
          <t-cell-group theme="card">
            <t-cell title="置顶聊天">
              <t-switch slot="note" value="{{isPinned}}" bindchange="onPinnedChange" />
            </t-cell>
            <t-cell title="消息免打扰">
              <t-switch slot="note" value="{{isMuted}}" bindchange="onMutedChange" />
            </t-cell>
          </t-cell-group>
        </view>

        <!-- Actions section -->
        <view class="page-actions">
          <t-button theme="primary" block bindtap="goToChat">
            发送消息
          </t-button>
          <view class="page-actions__secondary">
            <t-button variant="outline" block bindtap="clearChatHistory">
              清空聊天记录
            </t-button>
            <t-button theme="danger" block bindtap="deleteContact">
              删除联系人
            </t-button>
          </view>
        </view>
      </view>
    </view>
  </view>
</page-layout>
