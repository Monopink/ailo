/* Contact info page */
.contact-info-page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* Loading state */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  font-size: 28rpx;
  color: #999;
}

/* Contact info */
.contact-info {
  display: flex;
  flex-direction: column;
}

/* Profile section (资料区域) */
.profile-section {
  background-color: #fff;
  padding: 32rpx;
  margin-bottom: 16rpx;
}

.profile-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 8rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.header-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: #000;
}

.gender {
  font-size: 32rpx;
  color: #999;
}

.qiao-id {
  font-size: 28rpx;
  color: #999;
}

.bio-section {
  margin-bottom: 24rpx;
}

.bio {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.tags-section {
  margin-bottom: 0;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  padding: 8rpx 24rpx;
  background-color: #f5f5f5;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #666;
}

/* Entry section (备注和标签区域) */
.entry-section {
  background-color: #fff;
  margin-bottom: 16rpx;
}

.entry-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.entry-item:last-child {
  border-bottom: none;
}

.entry-item .label {
  font-size: 32rpx;
  color: #000;
}

.entry-item .arrow {
  font-size: 40rpx;
  color: #999;
}

/* Settings section (对话设置区域) */
.settings-section {
  background-color: #fff;
  margin-bottom: 16rpx;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-item .label {
  font-size: 32rpx;
  color: #000;
}

/* Actions section (操作按钮区域) */
.actions-section {
  padding: 40rpx;
  background-color: #fff;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  background-color: #f5f5f5;
  border-radius: 16rpx;
  font-size: 32rpx;
  color: #333;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn.primary {
  background-color: #42db5a;
  color: #fff;
}

.action-btn.danger {
  color: #ff3b30;
}
