<page-layout
  style="--color-bg-page: var(--color-bg-white); --color-bg-header-solid: var(--color-bg-white); --color-navbar-glass-bg: transparent;"
  isLoading="{{pageLayoutData.isLoading}}"
  hasError="{{pageLayoutData.hasError}}"
  errorMessage="{{pageLayoutData.errorMessage}}"
  isEmpty="{{pageLayoutData.isEmpty}}"
  emptyMessage="{{pageLayoutData.emptyMessage}}"
  hasFooter="{{pageLayoutData.hasFooter}}"
  bind:retry="onRetry">
  <view slot="header" class="index-page__header">
    <t-navbar left-arrow="{{false}}" />
    <view class="page-large-title">
      <text class="page-large-title__text">{{navbarTitle}}</text>
    </view>
    <view wx:if="{{showConnectionIssue}}" class="index-page__connection">
      <t-loading theme="spinner" size="24rpx" />
      <text class="index-page__connection-text"></text>
    </view>
  </view>

  <view slot="empty" class="index-page__empty">
    <t-empty description="{{pageLayoutData.emptyMessage}}">
      <t-button slot="action" theme="primary" size="medium" bindtap="goToSquareEntry">去添加</t-button>
    </t-empty>
  </view>

  <view slot="content" class="index-page__content">
    <t-cell-group>
    <t-swipe-cell
        wx:for="{{contactList}}"
        wx:key="conv_id"
        right="{{item.swipeActions}}"
        data-id="{{item.conv_id}}"
        data-index="{{index}}"
        bind:click="onSwipeActionClick">
        <t-cell
          class="index-cell"
          align="middle"
          hover
          bind:click="goToChat"
          data-id="{{item.conv_id}}"
          data-index="{{index}}">
          <t-avatar slot="image" image="{{item.avatarUrl}}" size="small" shape="circle" />
          <view slot="title" class="index-cell__title-row">
            <text class="index-cell__title list-text-primary">{{item.displayName}}</text>
            <text class="list-time index-cell__time">{{item.lastMessageTime}}</text>
          </view>
          <view slot="description" class="index-cell__description">
            <view class="index-cell__message-row">
              <text class="list-text-secondary list-preview">{{item.lastMessage}}</text>
              <t-badge
                wx:if="{{item.hasUnread}}"
                count="{{item.unreadBadge}}"
                dot="{{item.unreadDot}}"
                max-count="99"
                size="large"
                shape="circle"
                t-class-count="index-cell__badge" />
            </view>
            <view wx:if="{{item.tags && item.tags.length}}" class="contact-item__tags">
              <t-tag
                wx:for="{{item.tags}}"
                wx:for-item="tag"
                wx:key="*this"
                size="small"
                variant="outline">
                {{tag}}
              </t-tag>
            </view>
          </view>
        </t-cell>
      </t-swipe-cell>
    </t-cell-group>
  </view>
</page-layout>
