<page-layout
  isLoading="{{pageLayoutData.isLoading}}"
  hasError="{{pageLayoutData.hasError}}"
  errorMessage="{{pageLayoutData.errorMessage}}"
  isEmpty="{{pageLayoutData.isEmpty}}"
  emptyMessage="{{pageLayoutData.emptyMessage}}"
  hasFooter="{{pageLayoutData.hasFooter}}"
  contentScrollIntoView="{{pageLayoutData.contentScrollIntoView}}"
  contentScrollWithAnimation="{{pageLayoutData.contentScrollWithAnimation}}"
  bind:retry="onRetry">
  <view slot="content" class="contact-page">
    <!-- iOS style list - no card, direct list -->
    <view class="contact-list" wx:if="{{contactList.length > 0}}">
      <ui-cell
        wx:for="{{contactList}}"
        wx:key="conv_id"
        title="{{item.displayName}}"
        label="{{item.lastMessage}}"
        link="{{true}}"
        bindtap="goToChat"
        bindlongpress="onContactLongPress"
        data-id="{{item.conv_id}}"
        data-index="{{index}}"
        data-name="{{item.displayName}}">
        <view slot="icon">
          <ui-avatar src="{{item.avatarUrl}}" size="large" />
        </view>
        <view wx:if="{{item.tags && item.tags.length}}" class="contact-item__tags">
          <ui-tag
            wx:for="{{item.tags}}"
            wx:for-item="tag"
            wx:key="*this"
            size="small"
            variant="outline">
            {{tag}}
          </ui-tag>
        </view>
        <view slot="footer" class="contact-item__meta">
          <text class="contact-item__time">{{item.lastMessageTime}}</text>
          <ui-badge wx:if="{{item.hasUnread}}" count="{{item.unreadBadge}}" />
        </view>
      </ui-cell>
    </view>
  </view>
</page-layout>

<!-- Action Sheet for contact actions -->
<ui-action-sheet
  show="{{actionSheet.show}}"
  title="{{actionSheet.displayName}}"
  actions="{{actionSheetActions}}"
  maskClosable="{{true}}"
  bind:select="handleActionSelect"
  bind:close="handleActionSheetClose" />
