@import '/styles/tdesign-theme.wxss';

/* Index Page - Contact List */
.index-page {
  min-height: 100vh;
  background-color: var(--td-bg-color-page);
}

/* Loading, Error, Empty States */
.index-page__state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
  padding: var(--td-spacer-4);
}

/* Contact Item Meta (Time & Badge) */
.contact-item__meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: var(--td-spacer-1);
}

.contact-item__time {
  font-size: 24rpx;
  color: var(--td-text-color-placeholder);
  line-height: 1.5;
}

/* Contact Item Tags */
.contact-item__tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--td-spacer-1);
  margin-top: var(--td-spacer-1);
}
