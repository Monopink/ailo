@import '/styles/design-tokens.wxss';

/* Page container */
.contact-page {
  background-color: var(--color-bg-primary);
}

/* Contact list - iOS style, no card, direct list */
.contact-list {
  display: flex;
  flex-direction: column;
  background-color: var(--color-bg-secondary);
}

/* Contact item tags */
.contact-item__tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-xs);
  margin-top: var(--space-xs);
}

/* Contact item metadata (time, badge, actions) */
.contact-item__meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: var(--space-xs);
  min-width: 140rpx;
}

/* Contact item time */
.contact-item__time {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}
