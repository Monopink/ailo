/* Index page - Contact list */
.index-container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* Search bar */
.search-bar {
  padding: 20rpx 40rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.search-bar input {
  padding: 20rpx 30rpx;
  background-color: #f5f5f5;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.search-bar.hide {
  display: none;
}

/* Chat list */
.chat-list {
  height: 100vh;
}

.chat-item-wrapper {
  position: relative;
  overflow: hidden;
}

.chat-item {
  position: relative;
  display: flex;
  align-items: center;
  padding: 30rpx 40rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.chat-item .avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  margin-right: 30rpx;
  flex-shrink: 0;
}

.chat-item .info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.chat-item .top-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.chat-item .name {
  font-size: 32rpx;
  font-weight: bold;
  margin-right: 20rpx;
}

.chat-item .tags {
  display: flex;
  gap: 10rpx;
  margin-right: auto;
}

.chat-item .tag {
  padding: 4rpx 12rpx;
  background-color: #f0f0f0;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.chat-item .time {
  font-size: 24rpx;
  color: #999;
}

.chat-item .bottom-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.chat-item .last-message {
  flex: 1;
  font-size: 28rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chat-item .unread-badge {
  min-width: 40rpx;
  height: 40rpx;
  padding: 0 10rpx;
  background-color: #ff4444;
  color: #fff;
  border-radius: 20rpx;
  font-size: 24rpx;
  text-align: center;
  line-height: 40rpx;
}

/* More button */
.more-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #999;
  margin-left: 20rpx;
  flex-shrink: 0;
}

/* Menu overlay */
.menu-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Menu popup */
.menu-popup {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  min-width: 500rpx;
  max-width: 600rpx;
}

/* Menu header */
.menu-header {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  margin-right: 24rpx;
}

.menu-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.menu-item {
  padding: 32rpx 40rpx;
  font-size: 32rpx;
  color: #333;
  text-align: center;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background-color: #f5f5f5;
}

.menu-item.delete {
  color: #ff4444;
}

/* Empty state */
.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  font-size: 28rpx;
  color: #999;
}

