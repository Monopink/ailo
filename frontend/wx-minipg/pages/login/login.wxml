<page-layout
  isLoading="{{pageLayoutData.isLoading}}"
  hasError="{{pageLayoutData.hasError}}"
  errorMessage="{{pageLayoutData.errorMessage}}"
  isEmpty="{{pageLayoutData.isEmpty}}"
  emptyMessage="{{pageLayoutData.emptyMessage}}"
  hasFooter="{{false}}"
  disableScroll="{{true}}"
  bind:retry="onRetry">
  <view slot="content" class="login-page">
    <!-- Animated background gradient - Full screen -->
    <view class="login-bg"></view>

    <!-- Hero section - Integrated with background -->
    <view class="login-hero">
      <!-- Logo with pulse animation -->
      <view class="login-hero__logo-wrapper">
        <image class="login-hero__logo" src="/assets/logo.png" mode="aspectFit" />
        <view class="login-hero__glow"></view>
      </view>

      <!-- Text with fade-in animation -->
      <view class="login-hero__text">
        <text class="login-hero__title">敲敲</text>
        <text class="login-hero__subtitle">AI 陪伴 · 实时共鸣</text>
        <text class="login-hero__description">一键进入与 AI 的沉浸式对话</text>
      </view>
    </view>

    <!-- Features section - Compact -->
    <view class="login-features">
      <view
        class="login-features__item login-features__item--{{index}}"
        wx:for="{{featureList}}"
        wx:key="id"
        wx:for-index="index">
        <view class="login-features__icon">✨</view>
        <text class="login-features__title">{{item.title}}</text>
      </view>
    </view>

    <!-- Preview section - Auto scroll carousel -->
    <view class="login-preview">
      <text class="login-preview__title">发现有趣的 AI 伙伴</text>
      <view class="login-preview__carousel">
        <view class="login-preview__track">
          <!-- Triple items for seamless infinite loop -->
          <block wx:for="{{sampleContacts}}" wx:key="qiao_id" wx:for-item="contact1">
            <view class="login-preview__item">
              <view class="login-preview__avatar-wrapper">
                <t-avatar size="medium" image="{{contact1.avatar}}" />
                <view class="login-preview__avatar-ring"></view>
              </view>
              <text class="login-preview__name">{{contact1.nickname}}</text>
              <text class="login-preview__bio">{{contact1.bio}}</text>
            </view>
          </block>
          <block wx:for="{{sampleContacts}}" wx:key="qiao_id" wx:for-item="contact2">
            <view class="login-preview__item">
              <view class="login-preview__avatar-wrapper">
                <t-avatar size="medium" image="{{contact2.avatar}}" />
                <view class="login-preview__avatar-ring"></view>
              </view>
              <text class="login-preview__name">{{contact2.nickname}}</text>
              <text class="login-preview__bio">{{contact2.bio}}</text>
            </view>
          </block>
          <block wx:for="{{sampleContacts}}" wx:key="qiao_id" wx:for-item="contact3">
            <view class="login-preview__item">
              <view class="login-preview__avatar-wrapper">
                <t-avatar size="medium" image="{{contact3.avatar}}" />
                <view class="login-preview__avatar-ring"></view>
              </view>
              <text class="login-preview__name">{{contact3.nickname}}</text>
              <text class="login-preview__bio">{{contact3.bio}}</text>
            </view>
          </block>
        </view>
      </view>
    </view>

    <!-- Actions section - Login buttons -->
    <view class="login-actions">
      <t-button
        theme="primary"
        block
        loading="{{wechatLoading}}"
        bindtap="handleWeChatLogin">
        微信授权登录
      </t-button>
      <t-button
        variant="outline"
        block
        bindtap="handlePhoneLogin">
        手机号登录
      </t-button>
    </view>
  </view>
</page-layout>
