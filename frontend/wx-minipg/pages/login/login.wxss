@import '/styles/tdesign-theme.wxss';
@import '/styles/design-tokens.wxss';

/* ========================================
   Login Page - Full Screen, No Scroll
   ======================================== */

.login-page {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-evenly;
  align-items: center;
  height: 100vh;
  padding: var(--space-sm) var(--padding-page);
  padding-bottom: calc(var(--space-sm) + var(--safe-area-inset-bottom));
  overflow: hidden;
}

/* ========================================
   Animated Background - Full Screen
   ======================================== */

.login-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: linear-gradient(
    135deg,
    var(--color-primary-lighter) 0%,
    var(--color-accent-light) 25%,
    var(--color-bg-secondary) 50%,
    var(--color-primary-lighter) 75%,
    var(--color-accent-light) 100%
  );
  background-size: 400% 400%;
  animation: gradient-flow 20s ease infinite;
  z-index: 0;
  opacity: 0.6;
}

@keyframes gradient-flow {
  0% {
    background-position: 0% 50%;
  }

  50% {
    background-position: 100% 50%;
  }

  100% {
    background-position: 0% 50%;
  }
}

/* ========================================
   Hero Section - Integrated with Background
   ======================================== */

.login-hero {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-xs);
  flex-shrink: 0;
}

/* Logo with pulse and glow */
.login-hero__logo-wrapper {
  position: relative;
  animation: float 3s ease-in-out infinite;
}

.login-hero__logo {
  width: 200rpx;
  height: 200rpx;
  animation: pulse-scale 2s ease-in-out infinite;
}

.login-hero__glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 240rpx;
  height: 240rpx;
  border-radius: var(--radius-full);
  background: radial-gradient(circle, var(--color-primary) 0%, transparent 70%);
  opacity: 0.3;
  animation: glow-pulse 2s ease-in-out infinite;
  z-index: -1;
}

@keyframes float {
  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-16rpx);
  }
}

@keyframes pulse-scale {
  0%,
  100% {
    transform: scale(1);
  }

  50% {
    transform: scale(1.05);
  }
}

@keyframes glow-pulse {
  0%,
  100% {
    opacity: 0.3;
    transform: translate(-50%, -50%) scale(1);
  }

  50% {
    opacity: 0.5;
    transform: translate(-50%, -50%) scale(1.1);
  }
}

/* Hero text */
.login-hero__text {
  position: relative;
  z-index: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  animation: fade-in-up 0.8s ease-out;
}

.login-hero__title {
  font-size: 72rpx;
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  letter-spacing: 6rpx;
  text-shadow: 0 4rpx 16rpx rgb(7 193 96 / 20%);
  animation: title-shimmer 3s ease-in-out infinite;
}

.login-hero__subtitle {
  font-size: var(--font-size-lg);
  color: var(--color-text-secondary);
  font-weight: var(--font-weight-medium);
  letter-spacing: 2rpx;
}

.login-hero__description {
  font-size: var(--font-size-base);
  color: var(--color-text-tertiary);
  line-height: var(--line-height-base);
}

@keyframes fade-in-up {
  from {
    opacity: 0;
    transform: translateY(32rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes title-shimmer {
  0%,
  100% {
    text-shadow: 0 4rpx 16rpx rgb(7 193 96 / 20%);
  }

  50% {
    text-shadow: 0 4rpx 24rpx rgb(7 193 96 / 40%);
  }
}

/* ========================================
   Features Section - Compact Horizontal
   ======================================== */

.login-features {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: center;
  gap: var(--space-md);
  width: 100%;
  flex-shrink: 0;
}

.login-features__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-xs);
  opacity: 0;
  transform: translateY(16rpx);
  animation: fade-in-up 0.6s ease-out forwards;
}

.login-features__item--0 {
  animation-delay: 0.2s;
}

.login-features__item--1 {
  animation-delay: 0.4s;
}

.login-features__item--2 {
  animation-delay: 0.6s;
}

.login-features__icon {
  font-size: 40rpx;
  animation: icon-bounce 2s ease-in-out infinite;
}

.login-features__title {
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  white-space: nowrap;
}

@keyframes icon-bounce {
  0%,
  100% {
    transform: translateY(0) rotate(0deg);
  }

  25% {
    transform: translateY(-8rpx) rotate(-5deg);
  }

  75% {
    transform: translateY(-8rpx) rotate(5deg);
  }
}

/* ========================================
   Preview Section - Auto Scroll Carousel
   ======================================== */

.login-preview {
  position: relative;
  z-index: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  animation: fade-in 0.8s ease-out 0.8s backwards;
  flex-shrink: 0;
}

.login-preview__title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  text-align: center;
}

.login-preview__carousel {
  width: 100%;
  overflow: hidden;
  mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
}

.login-preview__track {
  display: flex;
  gap: var(--space-lg);
  animation: scroll-carousel 30s linear infinite;
  will-change: transform;
}

@keyframes scroll-carousel {
  0% {
    transform: translateX(0);
  }

  100% {
    transform: translateX(-33.333%);
  }
}

.login-preview__item {
  flex-shrink: 0;
  width: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-xs);
  padding: var(--space-md);
  border-radius: var(--radius-lg);
  background: rgb(255 255 255 / 80%);
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgb(255 255 255 / 50%);
  box-shadow: 0 8rpx 32rpx rgb(0 0 0 / 8%);
  animation: card-float 3s ease-in-out infinite;
}

.login-preview__item:nth-child(2n) {
  animation-delay: 0.5s;
}

.login-preview__item:nth-child(3n) {
  animation-delay: 1s;
}

@keyframes card-float {
  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-8rpx);
  }
}

/* Avatar with animated ring */
.login-preview__avatar-wrapper {
  position: relative;
}

.login-preview__avatar-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-full);
  border: 3rpx solid var(--color-primary);
  opacity: 0.3;
  animation: ring-pulse 2s ease-in-out infinite;
}

@keyframes ring-pulse {
  0% {
    transform: translate(-50%, -50%) scale(1);
    opacity: 0.3;
  }

  50% {
    transform: translate(-50%, -50%) scale(1.2);
    opacity: 0;
  }

  100% {
    transform: translate(-50%, -50%) scale(1);
    opacity: 0.3;
  }
}

.login-preview__name {
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

.login-preview__bio {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  text-align: center;
  line-height: var(--line-height-relaxed);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

/* ========================================
   Actions Section - Login Buttons
   ======================================== */

.login-actions {
  position: relative;
  z-index: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  animation: fade-in 0.8s ease-out 1s backwards;
  flex-shrink: 0;
}

@keyframes fade-in {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes text-glow {
  0%,
  100% {
    opacity: 1;
  }

  50% {
    opacity: 0.9;
  }
}

/* ========================================
   Dark Mode Adjustments
   ======================================== */

@media (prefers-color-scheme: dark) {
  .login-bg {
    opacity: 0.4;
  }

  .login-hero__title {
    text-shadow: 0 4rpx 16rpx rgb(11 191 104 / 30%);
  }

  .login-preview__item {
    background: rgb(30 30 30 / 80%);
    border-color: rgb(255 255 255 / 10%);
  }
}
