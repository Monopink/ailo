/* Login page */
.login-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background-color: #f5f5f5;
}

/* Brand */
.brand {
  margin-bottom: 80rpx;
  text-align: center;
}

.brand-name {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.brand-slogan {
  font-size: 28rpx;
  color: #666;
}

/* Login form */
.login-form {
  width: 100%;
  max-width: 600rpx;
  padding: 60rpx 40rpx;
  background-color: #fff;
  border-radius: 16rpx;
}

.form-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 40rpx;
  text-align: center;
}

/* Form group */
.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  margin-bottom: 10rpx;
  color: #333;
}

.form-input {
  width: 100%;
  padding: 25rpx 30rpx;
  background-color: #f5f5f5;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.input-group {
  display: flex;
  gap: 20rpx;
}

.input-group .form-input {
  flex: 1;
}

.captcha-image {
  width: 200rpx;
  height: 80rpx;
  border-radius: 16rpx;
}

.code-btn {
  padding: 25rpx 40rpx;
  background-color: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
  white-space: nowrap;
}

.code-btn:disabled {
  background-color: #f5f5f5;
  color: #999;
}

.error-message {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #ff4444;
}

/* Submit button */
.submit-btn {
  width: 100%;
  padding: 30rpx;
  margin-top: 40rpx;
  background-color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
}

.submit-btn:disabled {
  background-color: #f5f5f5;
  color: #999;
}

/* Login buttons (initial state) */
.login-buttons {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
  margin-bottom: 40rpx;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
}

.wechat-login-btn {
  background: #42db5a;
  color: #fff;
}

.wechat-login-btn::after {
  border: none;
}

.phone-login-btn {
  background: #fff;
  color: #42db5a;
  border: 2rpx solid #42db5a;
}

.phone-login-btn::after {
  border: none;
}

/* Phone auth (after WeChat login) */
.phone-auth {
  width: 100%;
  margin-bottom: 40rpx;
}

.phone-auth-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  background: #42db5a;
  color: #fff;
}

.phone-auth-btn::after {
  border: none;
}

/* Phone bind section */
.phone-bind {
  width: 100%;
}

.bind-title {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 40rpx;
  text-align: center;
}

.phone-input {
  flex: 1;
}

.sms-group {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.sms-input {
  flex: 1;
}

.sms-btn {
  padding: 25rpx 30rpx;
  background-color: #f5f5f5;
  border-radius: 16rpx;
  font-size: 24rpx;
  white-space: nowrap;
  border: none;
}

.sms-btn.disabled {
  background-color: #f5f5f5;
  color: #999;
}

.bind-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  background: #42db5a;
  color: #fff;
}

.bind-btn::after {
  border: none;
}

/* Loading state */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 40rpx;
}

.loading-container text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #666;
}
