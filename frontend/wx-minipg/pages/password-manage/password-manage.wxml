<view class="password-manage-page">
  <!-- Loading state -->
  <view wx:if="{{loading}}" class="loading-container">
    <text>加载中...</text>
  </view>

  <!-- Password manage content -->
  <view wx:else class="password-manage-content">
    <!-- Reset password mode (with operation token) -->
    <view wx:if="{{isResetMode}}" class="section">
      <view class="section-title">重置密码</view>

      <!-- New password -->
      <view class="input-item">
        <text class="label">新密码</text>
        <input
          class="input-field"
          type="password"
          placeholder="请输入新密码"
          value="{{newPassword}}"
          bindinput="onNewPasswordInput"
        />
      </view>

      <!-- Confirm password -->
      <view class="input-item">
        <text class="label">确认密码</text>
        <input
          class="input-field"
          type="password"
          placeholder="请再次输入新密码"
          value="{{confirmPassword}}"
          bindinput="onConfirmPasswordInput"
        />
      </view>

      <button class="action-button" bindtap="handleResetPasswordWithToken" disabled="{{saving}}">
        {{saving ? '重置中...' : '确认重置'}}
      </button>
    </view>

    <!-- Change password mode (normal) -->
    <view wx:else>
      <!-- Change password section -->
      <view class="section">
        <view class="section-title">修改密码</view>

        <!-- Old password (if has password) -->
        <view wx:if="{{hasPassword}}" class="input-item">
          <text class="label">当前密码</text>
          <input
            class="input-field"
            type="password"
            placeholder="请输入当前密码"
            value="{{oldPassword}}"
            bindinput="onOldPasswordInput"
          />
        </view>

        <!-- New password -->
        <view class="input-item">
          <text class="label">新密码</text>
          <input
            class="input-field"
            type="password"
            placeholder="请输入新密码"
            value="{{newPassword}}"
            bindinput="onNewPasswordInput"
          />
        </view>

        <!-- Confirm password -->
        <view class="input-item">
          <text class="label">确认密码</text>
          <input
            class="input-field"
            type="password"
            placeholder="请再次输入新密码"
            value="{{confirmPassword}}"
            bindinput="onConfirmPasswordInput"
          />
        </view>

        <button class="action-button" bindtap="handleChangePassword" disabled="{{saving}}">
          {{saving ? '保存中...' : (hasPassword ? '修改密码' : '设置密码')}}
        </button>
      </view>

      <!-- Reset password (requires verification) -->
      <view class="section">
        <view class="section-title">忘记密码?</view>
        <button class="action-button secondary" bindtap="handleResetPassword">
          通过验证码重置密码
        </button>
      </view>
    </view>
  </view>
</view>

