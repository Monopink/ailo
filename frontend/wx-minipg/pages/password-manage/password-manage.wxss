/* Password manage page container */
.password-manage-page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* Loading container */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}

/* Password manage content */
.password-manage-content {
  padding: 40rpx;
}

/* Section */
.section {
  margin-bottom: 60rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

/* Input item */
.input-item {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx 40rpx;
  margin-bottom: 20rpx;
}

.input-item .label {
  display: block;
  font-size: 28rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.input-field {
  width: 100%;
  font-size: 32rpx;
  color: #333;
  border: none;
  outline: none;
}

/* Action button */
.action-button {
  width: 100%;
  padding: 30rpx;
  background-color: #fff;
  color: #333;
  border-radius: 16rpx;
  font-size: 32rpx;
  text-align: center;
  border: none;
  margin-top: 20rpx;
}

.action-button[disabled] {
  background-color: #f5f5f5;
  color: #999;
}

.action-button.secondary {
  background-color: #fff;
  color: #333;
}

