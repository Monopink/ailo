<page-layout
  isLoading="{{pageLayoutData.isLoading}}"
  hasError="{{pageLayoutData.hasError}}"
  errorMessage="{{pageLayoutData.errorMessage}}"
  isEmpty="{{pageLayoutData.isEmpty}}"
  emptyMessage="{{pageLayoutData.emptyMessage}}"
  hasFooter="{{pageLayoutData.hasFooter}}"
  bind:retry="onRetry">
  <view slot="content" class="phone-bind-page">
    <view class="phone-bind-header">
      <text class="phone-bind-header__title">绑定手机号</text>
      <text class="phone-bind-header__subtitle">{{headerSubtitle}}</text>
    </view>

    <view class="phone-bind-options">
      <ui-button
        type="primary"
        block="{{true}}"
        openType="getPhoneNumber"
        loading="{{phoneButtonLoading}}"
        bindgetphonenumber="handleGetPhoneNumber">
        一键获取手机号
      </ui-button>

      <view class="phone-bind-divider">
        <view class="phone-bind-divider__line"></view>
        <text class="phone-bind-divider__text">或</text>
        <view class="phone-bind-divider__line"></view>
      </view>

      <view class="phone-bind-form">
        <view class="phone-bind-form__field">
          <ui-input
            label="手机号"
            type="number"
            placeholder="请输入手机号"
            value="{{phone}}"
            maxLength="{{11}}"
            bindinput="handlePhoneInput" />
        </view>

        <view class="phone-bind-form__field">
          <ui-input
            label="验证码"
            type="number"
            placeholder="请输入验证码"
            value="{{smsCode}}"
            maxLength="{{6}}"
            bindinput="handleSmsCodeInput" />
        </view>

        <view class="phone-bind-form__field">
          <ui-button
            type="secondary"
            block="{{true}}"
            disabled="{{!canSendSms || smsCountdown > 0}}"
            bindtap="handleSendSms">
            {{smsCountdown > 0 ? smsCountdown + 's' : '获取验证码'}}
          </ui-button>
        </view>

        <aliyun-captcha
          wx:if="{{showCaptcha}}"
          class="phone-bind-captcha"
          scene="{{captchaScene}}"
          bind:onVerify="handleCaptchaVerify"
          bind:onClose="handleCaptchaClose" />
      </view>

      <!-- Submit button - Inline as part of form -->
      <view class="phone-bind-options__submit">
        <ui-button
          type="primary"
          block="{{true}}"
          disabled="{{!canBind}}"
          loading="{{bindLoading}}"
          bindtap="handleBind">
          绑定并登录
        </ui-button>
      </view>
    </view>
  </view>
</page-layout>
