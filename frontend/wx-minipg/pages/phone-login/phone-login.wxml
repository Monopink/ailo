<page-layout
  isLoading="{{pageLayoutData.isLoading}}"
  hasError="{{pageLayoutData.hasError}}"
  errorMessage="{{pageLayoutData.errorMessage}}"
  isEmpty="{{pageLayoutData.isEmpty}}"
  emptyMessage="{{pageLayoutData.emptyMessage}}"
  hasFooter="{{pageLayoutData.hasFooter}}"
  bind:retry="onRetry">
  <view slot="content" class="phone-login-page">
    <view class="phone-login-header">
      <text class="phone-login-header__title">手机号登录</text>
      <text class="phone-login-header__subtitle">未注册的手机号将自动创建账号</text>
    </view>

    <view class="phone-login-form">
      <!-- WeChat one-click phone login button -->
      <!-- Note: Requires enterprise certification, will fail if not available -->
      <view class="phone-login-form__field">
        <t-button
          theme="primary"
          block
          open-type="getPhoneNumber"
          loading="{{phoneButtonLoading}}"
          bindgetphonenumber="handleGetPhoneNumber">
          一键获取手机号
        </t-button>
      </view>

      <view class="phone-login-divider">
        <view class="phone-login-divider__line"></view>
        <text class="phone-login-divider__text">或</text>
        <view class="phone-login-divider__line"></view>
      </view>

      <!-- Phone input with country code selector -->
      <view class="phone-login-form__field">
        <phone-input
          value="{{phone}}"
          bindchange="handlePhoneChange" />
      </view>

      <view class="phone-login-form__field">
        <t-input
          label="验证码"
          type="number"
          placeholder="请输入验证码"
          value="{{smsCode}}"
          maxlength="{{6}}"
          bindchange="handleSmsCodeInput" />
      </view>

      <view class="phone-login-form__field">
        <t-button
          variant="outline"
          block
          disabled="{{!canSendSms || smsCountdown > 0}}"
          bindtap="handleSendSms">
          {{smsCountdown > 0 ? smsCountdown + 's' : '获取验证码'}}
        </t-button>
      </view>

      <!-- Aliyun Captcha Plugin (mounted only when needed) -->
      <view wx:if="{{loadCaptcha}}">
        <aliyun-captcha id="aliyun-captcha" props="{{pluginProps}}" />
      </view>

      <!-- Submit button - Inline as part of form -->
      <view class="phone-login-form__submit">
        <t-button
          theme="primary"
          block
          disabled="{{!canLogin}}"
          loading="{{loginLoading}}"
          bindtap="handleLogin">
          登录
        </t-button>
      </view>
    </view>
  </view>
</page-layout>
