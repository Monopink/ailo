@import '/styles/tdesign-theme.wxss';
@import '/styles/design-tokens.wxss';

.phone-login-page {
  display: flex;
  flex-direction: column;
  gap: var(--space-xl);
  padding: var(--padding-page);
  background-color: var(--color-bg-page);
}

.phone-login-header {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.phone-login-header__title {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.phone-login-header__subtitle {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.phone-login-form {
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

.phone-login-form__field {
  display: flex;
  flex-direction: column;
}

/* Phone input group with country code selector */
.phone-input-group {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--input-vertical-padding, 20rpx) var(--space-lg);
  background-color: var(--color-bg-input);
  border-radius: var(--radius-input);
  border: var(--border-width-thin) solid var(--color-border-light);
  min-height: 88rpx;
  box-sizing: border-box;
}

.country-code-selector {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  padding: var(--space-xs) var(--space-sm);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg-hover);
  cursor: pointer;
  flex-shrink: 0;
  min-height: 48rpx;
}

.country-code-selector:active {
  opacity: var(--opacity-pressed);
}

.country-code-selector__code {
  font-size: var(--font-size-md);
  color: var(--color-text-primary);
  font-weight: var(--font-weight-medium);
}

.country-code-selector__icon {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}

.phone-input-wrapper {
  flex: 1;
  min-width: 0;
}

/* Country picker item styles */
.country-picker-item {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-md) var(--padding-page);
}

.country-picker-item__flag {
  font-size: var(--font-size-xl);
  flex-shrink: 0;
}

.country-picker-item__name {
  flex: 1;
  font-size: var(--font-size-md);
  color: var(--color-text-primary);
}

.country-picker-item__code {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.phone-login-form__sms {
  display: flex;
  gap: var(--space-sm);
  align-items: flex-end;
}

.phone-login-form__sms-input {
  flex: 1;
}

.phone-login-form__submit {
  margin-top: var(--space-xl);
}

.phone-login-captcha {
  margin-top: var(--space-md);
}
