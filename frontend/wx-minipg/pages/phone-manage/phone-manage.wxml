<page-layout
  isLoading="{{pageLayoutData.isLoading}}"
  hasError="{{pageLayoutData.hasError}}"
  errorMessage="{{pageLayoutData.errorMessage}}"
  isEmpty="{{pageLayoutData.isEmpty}}"
  emptyMessage="{{pageLayoutData.emptyMessage}}"
  hasFooter="{{false}}"
  bind:retry="onRetry">
  <view slot="content" class="phone-manage">
    <view wx:if="{{!pageLayoutData.isLoading}}">
      <!-- Current phone info -->
      <view class="phone-manage__info">
        <text class="phone-manage__label">当前手机号</text>
        <text class="phone-manage__value">{{currentPhone || '未绑定'}}</text>
      </view>

      <!-- New phone form -->
      <view class="phone-manage__form">
        <view class="phone-manage__field">
          <ui-input
            label="新手机号"
            type="number"
            placeholder="请输入新手机号"
            value="{{newPhone}}"
            maxLength="11"
            bindinput="onNewPhoneInput" />
        </view>

        <view class="phone-manage__field">
          <ui-input
            label="验证码"
            type="number"
            placeholder="请输入验证码"
            value="{{smsCode}}"
            maxLength="6"
            bindinput="onSmsCodeInput" />
        </view>

        <view class="phone-manage__field">
          <ui-button
            type="secondary"
            block="{{true}}"
            loading="{{sending}}"
            disabled="{{cooldown > 0 || sending}}"
            bindtap="sendSmsCode">
            {{cooldown > 0 ? cooldown + 's' : '发送验证码'}}
          </ui-button>
        </view>

        <view class="phone-manage__hint">
          <text class="phone-manage__hint-text">每次更换手机号都需要短信验证，请确保手机号可接收验证码。</text>
        </view>
      </view>

      <!-- Submit button -->
      <view class="phone-manage__actions">
        <ui-button
          type="primary"
          block="{{true}}"
          loading="{{saving}}"
          disabled="{{saving}}"
          bindtap="handleChangePhone">
          {{saving ? '修改中...' : '确认修改'}}
        </ui-button>
      </view>
    </view>
  </view>
</page-layout>

<view wx:if="{{loadCaptcha}}">
  <aliyun-captcha id="captcha-element" props="{{pluginProps}}" />
</view>
