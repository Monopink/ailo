/* Phone manage page container */
.phone-manage-page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* Loading container */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}

/* Phone manage content */
.phone-manage-content {
  padding: 40rpx;
}

/* Info section */
.info-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
}

.info-label {
  display: block;
  font-size: 28rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.info-value {
  display: block;
  font-size: 32rpx;
  color: #333;
}

/* Section */
.section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

/* Input item */
.input-item {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx 40rpx;
  margin-bottom: 20rpx;
}

.input-item .label {
  display: block;
  font-size: 28rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.input-field {
  width: 100%;
  font-size: 32rpx;
  color: #333;
  border: none;
  outline: none;
}

/* Code section */
.code-section {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.code-input {
  flex: 1;
  padding: 30rpx;
  background-color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  color: #333;
}

.send-code-button {
  width: 240rpx;
  padding: 30rpx 20rpx;
  background-color: #fff;
  color: #333;
  border-radius: 16rpx;
  font-size: 28rpx;
  text-align: center;
  border: none;
}

.send-code-button[disabled] {
  background-color: #f5f5f5;
  color: #999;
}

/* Action button */
.action-button {
  width: 100%;
  padding: 30rpx;
  background-color: #fff;
  color: #333;
  border-radius: 16rpx;
  font-size: 32rpx;
  text-align: center;
  border: none;
}

.action-button[disabled] {
  background-color: #f5f5f5;
  color: #999;
}

