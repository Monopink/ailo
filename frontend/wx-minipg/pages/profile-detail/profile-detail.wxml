<page-layout
  isLoading="{{pageLayoutData.isLoading}}"
  hasError="{{pageLayoutData.hasError}}"
  errorMessage="{{pageLayoutData.errorMessage}}"
  isEmpty="{{pageLayoutData.isEmpty}}"
  emptyMessage="{{pageLayoutData.emptyMessage}}"
  hasFooter="{{pageLayoutData.hasFooter}}"
  bind:retry="onRetry">
  <view slot="content" class="profile-detail">
    <!-- Info groups - Using ui-card -->
    <ui-card wx:if="{{profile}}" padding="none">
      <ui-cell title="头像" link="{{true}}" bindtap="editAvatar">
        <ui-avatar
          slot="footer"
          src="{{profile.avatar_url || '/assets/avatars/default.png'}}"
          size="large"
        />
      </ui-cell>

      <ui-cell
        title="昵称"
        value="{{profile.nickname || '未设置'}}"
        link="{{true}}"
        bindtap="editNickname"
      />

      <ui-cell
        title="敲敲号"
        value="{{profile.username || '--'}}"
        link="{{true}}"
        bindtap="editUsername"
      />

      <ui-cell
        title="手机号"
        value="{{phoneMasked || '未绑定'}}"
        link="{{true}}"
        bindtap="editPhone"
      />
    </ui-card>

    <ui-card wx:if="{{profile}}" padding="none">
      <ui-cell
        title="性别"
        value="{{genderText}}"
        link="{{true}}"
        bindtap="editGender"
      />

      <ui-cell
        title="地区"
        value="{{profile.region || '未设置'}}"
        link="{{true}}"
        bindtap="editRegion"
      />

      <ui-cell title="个性签名" link="{{true}}" bindtap="editBio">
        <text slot="footer" style="max-width: 320rpx; font-size: var(--font-size-base); color: var(--color-text-secondary); text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{profile.bio || '未设置'}}</text>
      </ui-cell>
    </ui-card>
  </view>
</page-layout>
