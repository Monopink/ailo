<page-layout
  isLoading="{{pageLayoutData.isLoading}}"
  hasError="{{pageLayoutData.hasError}}"
  errorMessage="{{pageLayoutData.errorMessage}}"
  isEmpty="{{pageLayoutData.isEmpty}}"
  emptyMessage="{{pageLayoutData.emptyMessage}}"
  hasFooter="{{pageLayoutData.hasFooter}}"
  bind:retry="onRetry">
  <t-navbar slot="header" left-arrow="{{true}}">
    <view slot="title" class="navbar-title">详细资料</view>
  </t-navbar>
  <view slot="content" class="profile-detail card-container">
    <!-- Info groups - Using t-cell-group with card theme -->
    <view wx:if="{{profile}}" class="card-wrapper">
      <t-cell-group theme="card">
        <t-cell
          title="头像"
          arrow
          hover
          bindtap="editAvatar">
          <view slot="note" class="profile-detail__avatar-slot">
            <t-avatar
              image="{{profile.displayAvatar}}"
              size="large"
            />
            <text class="profile-detail__avatar-hint">
              {{avatarHint}}
            </text>
          </view>
        </t-cell>

        <t-cell
          title="昵称"
          note="{{profile.nickname}}"
          arrow
          hover
          bindtap="editNickname"
        />

        <t-cell
          title="敲敲号"
          note="{{profile.displayUsername}}"
          arrow
          hover
          bindtap="editUsername"
        />

        <t-cell
          title="手机号"
          note="{{phoneMasked}}"
          arrow
          hover
          bindtap="editPhone"
        />
      </t-cell-group>
    </view>

    <view wx:if="{{profile}}" class="card-wrapper">
      <t-cell-group theme="card">
        <t-cell
          title="性别"
          note="{{genderText}}"
          arrow
          hover
          bindtap="editGender"
        />

        <t-cell
          title="地区"
          note="{{profile.region}}"
          arrow
          hover
          bindtap="editRegion"
        />

        <t-cell title="个性签名" arrow hover bindtap="editBio">
          <text slot="note" style="max-width: 320rpx; font-size: var(--font-size-base); color: var(--color-text-secondary); text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{profile.bio}}</text>
        </t-cell>
      </t-cell-group>
    </view>
  </view>
</page-layout>
