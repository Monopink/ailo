<view class="profile-detail-page">
  <!-- Loading state -->
  <view wx:if="{{loading}}" class="loading-container">
    <text>加载中...</text>
  </view>

  <!-- Error state -->
  <view wx:elif="{{error}}" class="error-container">
    <text>{{error}}</text>
    <button bindtap="loadProfile">重试</button>
  </view>

  <!-- Profile detail content -->
  <view wx:else class="profile-detail-content">
    <!-- Avatar -->
    <view class="detail-item" bindtap="editAvatar">
      <text class="label">头像</text>
      <view class="value-with-arrow">
        <image
          class="avatar-preview"
          src="{{profile.avatar_url || '/assets/avatars/default.png'}}"
          mode="aspectFill"
        />
        <text class="arrow">›</text>
      </view>
    </view>

    <!-- Nickname -->
    <view class="detail-item" bindtap="editNickname">
      <text class="label">昵称</text>
      <view class="value-with-arrow">
        <text class="value">{{profile.nickname || '未设置'}}</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <!-- Username (敲敲号) -->
    <view class="detail-item" bindtap="editUsername">
      <text class="label">敲敲号</text>
      <view class="value-with-arrow">
        <text class="value">{{profile.username}}</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <!-- Phone -->
    <view class="detail-item" bindtap="editPhone">
      <text class="label">手机号</text>
      <view class="value-with-arrow">
        <text class="value">{{phoneMasked || '未绑定'}}</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <!-- Gender -->
    <view class="detail-item" bindtap="editGender">
      <text class="label">性别</text>
      <view class="value-with-arrow">
        <text class="value">{{genderText}}</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <!-- Region -->
    <view class="detail-item" bindtap="editRegion">
      <text class="label">地区</text>
      <view class="value-with-arrow">
        <text class="value">{{profile.region || '未设置'}}</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <!-- Bio -->
    <view class="detail-item" bindtap="editBio">
      <text class="label">个性签名</text>
      <view class="value-with-arrow">
        <text class="value">{{profile.bio || '未设置'}}</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>
</view>
