/* Profile detail page container */
.profile-detail-page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* Loading and error states */
.loading-container,
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 40rpx;
}

.error-container button {
  margin-top: 20rpx;
}

/* Profile detail content */
.profile-detail-content {
  padding: 40rpx;
}

/* Detail item */
.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-item:first-child {
  border-top-left-radius: 16rpx;
  border-top-right-radius: 16rpx;
}

.detail-item:last-child {
  border-bottom: none;
  border-bottom-left-radius: 16rpx;
  border-bottom-right-radius: 16rpx;
}

.detail-item .label {
  font-size: 32rpx;
  color: #333;
}

.value-with-arrow {
  display: flex;
  align-items: center;
}

.detail-item .value {
  font-size: 32rpx;
  color: #666;
  margin-right: 20rpx;
}

.detail-item .arrow {
  font-size: 48rpx;
  color: #ccc;
}

/* Avatar preview */
.avatar-preview {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

