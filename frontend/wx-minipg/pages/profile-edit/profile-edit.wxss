/* Profile edit page container */
.profile-edit-page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* Edit content */
.edit-content {
  padding: 40rpx;
}

/* Input section */
.input-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
}

.input-field {
  width: 100%;
  font-size: 32rpx;
  color: #333;
  border: none;
  outline: none;
}

.textarea-field {
  min-height: 200rpx;
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 20rpx;
}

/* Hint section */
.hint-section {
  margin-bottom: 40rpx;
}

.hint-text {
  font-size: 28rpx;
  color: #999;
  line-height: 1.6;
}

/* Picker section */
.picker-section {
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 40rpx;
}

.picker-display {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx;
  font-size: 32rpx;
  color: #333;
}

.picker-display .arrow {
  font-size: 48rpx;
  color: #ccc;
}

/* Save button */
.save-button {
  width: 100%;
  padding: 30rpx;
  background-color: #fff;
  color: #333;
  border-radius: 16rpx;
  font-size: 32rpx;
  text-align: center;
  border: none;
}

.save-button[disabled] {
  background-color: #f5f5f5;
  color: #999;
}
