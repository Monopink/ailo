@import '/styles/tdesign-theme.wxss';
@import '/styles/design-tokens.wxss';

.profile-edit {
  background-color: var(--color-bg-page);
  padding: var(--padding-page);
}

/* Form */
.profile-edit__form {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.profile-edit__field {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.profile-edit__label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  padding-left: var(--space-xs);
}

.profile-edit__textarea {
  width: 100%;
  min-height: 240rpx;
  padding: var(--space-md);
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  background-color: var(--color-bg-secondary);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border-base);
  line-height: var(--line-height-base);
  box-sizing: border-box;
}

.profile-edit__textarea::placeholder {
  color: var(--color-text-placeholder);
}

.profile-edit__counter {
  text-align: right;
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  padding-right: var(--space-xs);
}

.profile-edit__hint {
  padding: 0 var(--space-xs);
}

.profile-edit__hint-text {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  line-height: var(--line-height-loose);
}

.profile-edit__picker-display {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  gap: var(--space-xs);
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  padding: var(--space-md);
  background-color: var(--color-bg-secondary);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border-base);
}

.profile-edit__picker-arrow {
  margin-left: auto;
  font-size: 48rpx;
  color: var(--color-text-quaternary);
  line-height: 1;
}

/* Actions */
.profile-edit__actions {
  margin-top: var(--space-xl);
}
