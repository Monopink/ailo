<page-layout
  isLoading="{{pageLayoutData.isLoading}}"
  hasError="{{pageLayoutData.hasError}}"
  errorMessage="{{pageLayoutData.errorMessage}}"
  isEmpty="{{pageLayoutData.isEmpty}}"
  emptyMessage="{{pageLayoutData.emptyMessage}}"
  hasFooter="{{pageLayoutData.hasFooter}}"
  bind:retry="onRetry">
  <view slot="content" class="profile">
    <view wx:if="{{profile}}">
      <!-- Hero section - WeChat style -->
      <view class="profile__hero" bindtap="navigateToProfileDetail">
        <ui-avatar
          src="{{profile.avatar_url || '/assets/avatars/default.png'}}"
          size="xlarge" />
        <view class="profile__hero-info">
          <text class="profile__hero-name">{{profile.nickname || '未设置昵称'}}</text>
          <view class="profile__hero-meta">
            <text class="profile__hero-id">敲敲号：{{profile.username || '--'}}</text>
          </view>
        </view>
        <view class="profile__hero-arrow">
          <text class="profile__hero-arrow-icon">›</text>
        </view>
      </view>

      <!-- Settings group -->
      <view class="profile__group">
        <ui-cell title="账号与安全" link="{{true}}" bindtap="navigateToAccountSecurity" />
      </view>

      <!-- About group -->
      <view class="profile__group">
        <ui-cell title="关于" link="{{true}}" bindtap="navigateToAbout" />
      </view>
    </view>
  </view>
</page-layout>
