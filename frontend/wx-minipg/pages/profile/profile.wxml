<page-layout
  isLoading="{{pageLayoutData.isLoading}}"
  hasError="{{pageLayoutData.hasError}}"
  errorMessage="{{pageLayoutData.errorMessage}}"
  isEmpty="{{pageLayoutData.isEmpty}}"
  emptyMessage="{{pageLayoutData.emptyMessage}}"
  hasFooter="{{pageLayoutData.hasFooter}}"
  bind:retry="onRetry">
  <view slot="content" class="profile">
    <view wx:if="{{profile}}">
      <!-- Header Section - Avatar and Name -->
      <view class="profile__header">
        <t-avatar
          image="{{profile.displayAvatar}}"
          size="128rpx"
          shape="circle"
          class="profile__avatar" />

        <view class="profile__name-row">
          <text class="profile__name">{{profile.nickname}}</text>
          <gender-badge wx:if="{{profile.gender}}" gender="{{profile.gender}}" />
        </view>

        <text class="profile__qiao-id">敲敲号：{{profile.displayUsername}}</text>
      </view>

      <!-- Cards Section -->
      <view class="profile__cards card-container">
        <!-- Bio Card -->
        <view wx:if="{{profile.bio}}" class="card-wrapper">
          <t-cell-group theme="card">
            <t-cell title="个性签名" note="{{profile.bio}}" />
          </t-cell-group>
        </view>

        <!-- Region Card -->
        <view wx:if="{{profile.region}}" class="card-wrapper">
          <t-cell-group theme="card">
            <t-cell title="地区" note="{{profile.region}}" />
          </t-cell-group>
        </view>

        <!-- Settings Card -->
        <view class="card-wrapper">
          <t-cell-group theme="card">
            <t-cell title="我的资料" arrow hover bindtap="navigateToProfileDetail" />
            <t-cell title="账号与安全" arrow hover bindtap="navigateToAccountSecurity" />
            <t-cell title="关于" arrow hover bindtap="navigateToAbout" />
          </t-cell-group>
        </view>
      </view>
    </view>
  </view>
</page-layout>
