/* Profile page container */
.profile-page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* Loading and error states */
.loading-container,
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 40rpx;
}

.error-container button {
  margin-top: 20rpx;
}

/* Profile content */
.profile-content {
  padding: 40rpx;
}

/* Profile header */
.profile-header {
  display: flex;
  align-items: center;
  padding: 40rpx;
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  position: relative;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 30rpx;
}

.basic-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.qiao-id {
  font-size: 28rpx;
  color: #999;
}

.arrow {
  font-size: 48rpx;
  color: #ccc;
  margin-left: 20rpx;
}

/* Profile actions */
.profile-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-button {
  width: 100%;
  height: 88rpx;
  background-color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

