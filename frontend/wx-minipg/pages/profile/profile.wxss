@import '/styles/design-tokens.wxss';

.profile {
  background-color: var(--color-bg-page);
}

/* Hero section - WeChat style horizontal layout */
.profile__hero {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-lg) var(--padding-page);
  background-color: var(--color-bg-secondary);
  transition: background-color var(--duration-fast) var(--ease-out);
}

.profile__hero:active {
  background-color: var(--color-bg-hover);
}

.profile__hero-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  min-width: 0;
}

.profile__hero-name {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-normal);
  color: var(--color-text-primary);
}

.profile__hero-meta {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.profile__hero-id {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.profile__hero-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--icon-sm);
  height: var(--icon-sm);
}

.profile__hero-arrow-icon {
  font-size: var(--font-size-xxl);
  color: var(--color-text-quaternary);
  line-height: 1;
}

/* Info groups - iOS style */
.profile__group {
  background-color: var(--color-bg-secondary);
  margin-top: var(--space-md);
  overflow: hidden;
}

/* Actions section - Modern inline style */
.profile__actions {
  margin-top: var(--space-xxl);
  padding: 0 var(--padding-page);
}
