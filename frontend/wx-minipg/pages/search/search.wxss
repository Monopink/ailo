/* Search page */
.search-page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* Search bar */
.search-bar {
  padding: 20rpx 40rpx;
  background-color: #fff;
}

.search-input {
  width: 100%;
  padding: 20rpx 30rpx;
  background-color: #f5f5f5;
  border-radius: 16rpx;
  font-size: 28rpx;
}

/* Search history */
.search-history {
  margin-top: 20rpx;
  padding: 30rpx 40rpx;
  background-color: #fff;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.history-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.clear-btn {
  font-size: 24rpx;
  color: #999;
}

.history-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.history-item {
  padding: 16rpx 32rpx;
  background-color: #f5f5f5;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
}

/* Loading state */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  font-size: 28rpx;
  color: #999;
}

/* Empty state */
.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  font-size: 28rpx;
  color: #999;
}

/* Search results */
.search-results {
  margin-top: 20rpx;
  background-color: #fff;
}

.result-item {
  display: flex;
  align-items: center;
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.result-item:last-child {
  border-bottom: none;
}

.result-item .avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 30rpx;
}

.result-item .info {
  flex: 1;
}

.name-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-right: 20rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  padding: 4rpx 12rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.last-message {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.content {
  flex: 1;
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.time {
  margin-left: 20rpx;
  font-size: 24rpx;
  color: #999;
}

