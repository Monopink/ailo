<view class="settings-page">
  <!-- Settings list -->
  <view class="settings-list">
    <!-- Account Security -->
    <view class="setting-item" bindtap="navigateToAccountSecurity">
      <text class="label">账户安全</text>
      <text class="arrow">›</text>
    </view>

    <!-- Message Notifications -->
    <view class="setting-item" bindtap="navigateToNotifications">
      <text class="label">消息通知</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- Logout button -->
  <view class="logout-section">
    <button class="logout-button" bindtap="handleLogout">退出登录</button>
  </view>
</view>

