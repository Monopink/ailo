/* Settings page container */
.settings-page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 40rpx;
}

/* Settings list */
.settings-list {
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 40rpx;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-item .label {
  font-size: 32rpx;
  color: #333;
}

.setting-item .arrow {
  font-size: 48rpx;
  color: #ccc;
}

/* Logout section */
.logout-section {
  margin-top: 40rpx;
}

.logout-button {
  width: 100%;
  padding: 30rpx;
  background-color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  text-align: center;
  color: #ff4444;
}

