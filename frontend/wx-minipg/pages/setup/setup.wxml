<page-layout
  isLoading="{{pageLayoutData.isLoading}}"
  hasError="{{pageLayoutData.hasError}}"
  errorMessage="{{pageLayoutData.errorMessage}}"
  isEmpty="{{pageLayoutData.isEmpty}}"
  emptyMessage="{{pageLayoutData.emptyMessage}}"
  hasFooter="{{pageLayoutData.hasFooter}}"
  bind:retry="onRetry">
  <view slot="content" class="setup-page">
    <!-- Avatar selection group -->
    <view class="setup-group">
      <view class="setup-group__header">
        <text class="setup-group__title">头像 (可选)</text>
      </view>
      <scroll-view scroll-x class="setup-avatar__list" show-scrollbar="{{false}}">
        <view class="setup-avatar__items">
          <view
            wx:for="{{presetAvatars}}"
            wx:key="id"
            class="setup-avatar__item {{selectedAvatar === item.id ? 'setup-avatar__item--selected' : ''}}"
            bindtap="selectAvatar"
            data-id="{{item.id}}">
            <t-avatar image="{{item.url}}" size="medium" />
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- Basic info group -->
    <view class="setup-group">
      <t-cell title="昵称 (可选)">
        <input
          slot="note"
          class="setup-input"
          placeholder="请输入昵称"
          bindinput="onNicknameInput"
          value="{{nickname}}"
          maxlength="{{maxNicknameLength}}" />
      </t-cell>

      <t-cell title="性别 (必填)" arrow hover>
        <picker
          slot="note"
          mode="selector"
          range="{{genderOptions}}"
          range-key="label"
          value="{{genderIndex}}"
          bindchange="onGenderChange">
          <view class="setup-picker">
            {{genderIndex >= 0 ? genderOptions[genderIndex].label : '请选择性别'}}
          </view>
        </picker>
      </t-cell>
    </view>

    <!-- Additional info group -->
    <view class="setup-group">
      <t-cell title="个人简介 (可选)">
        <textarea
          slot="note"
          class="setup-textarea"
          placeholder="请输入个人简介"
          bindinput="onBioInput"
          value="{{bio}}"
          maxlength="{{maxBioLength}}"
          auto-height />
      </t-cell>

      <t-cell title="地区 (可选)" arrow hover>
        <picker
          slot="note"
          mode="region"
          value="{{regionValue}}"
          bindchange="onRegionChange">
          <view class="setup-picker">
            {{regionDisplay}}
          </view>
        </picker>
      </t-cell>
    </view>
  </view>

  <view slot="footer" class="setup-footer">
    <t-button
      theme="primary"
      block
      loading="{{loading}}"
      bindtap="handleSubmit">
      完成
    </t-button>
    <t-button variant="outline" block bindtap="handleCancel">
      取消
    </t-button>
  </view>
</page-layout>
