@import '/styles/tdesign-theme.wxss';
@import '/styles/design-tokens.wxss';

.setup-page {
  background-color: var(--color-bg-page);
}

/* Group - iOS style */
.setup-group {
  background-color: var(--color-bg-secondary);
  margin-top: var(--space-md);
  overflow: hidden;
}

.setup-group__header {
  padding: var(--space-md) var(--padding-page) var(--space-xs);
}

.setup-group__title {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

/* Avatar selection */
.setup-avatar {
  padding: var(--space-lg) 0 var(--space-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-xs);
}

.setup-avatar--active {
  opacity: 0.8;
}

.setup-avatar__hint {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

/* Input fields */
.setup-input {
  min-width: 320rpx;
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  text-align: right;
}

.setup-picker {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
}

.setup-textarea {
  width: 100%;
  min-height: 200rpx;
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  line-height: var(--line-height-base);
}

/* Footer */
.setup-footer {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  padding: var(--space-md) var(--padding-page) calc(var(--space-md) + var(--safe-area-inset-bottom));
  background-color: var(--color-bg-secondary);
  border-top: 1rpx solid var(--color-separator);
}
