@import '/styles/design-tokens.wxss';

.setup-page {
  background-color: var(--color-bg-page);
}

/* Group - iOS style */
.setup-group {
  background-color: var(--color-bg-secondary);
  margin-top: var(--space-md);
  overflow: hidden;
}

.setup-group__header {
  padding: var(--space-md) var(--padding-page) var(--space-xs);
}

.setup-group__title {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

/* Avatar selection */
.setup-avatar__list {
  width: 100%;
  padding: var(--space-sm) 0;
}

.setup-avatar__items {
  display: flex;
  gap: var(--space-md);
  padding: 0 var(--padding-page);
}

.setup-avatar__item {
  padding: var(--space-xs);
  border-radius: var(--radius-lg);
  border: var(--border-width-medium) solid transparent;
  transition: border-color var(--duration-fast) var(--ease-out);
}

.setup-avatar__item--selected {
  border-color: var(--color-primary);
}

/* Input fields */
.setup-input {
  min-width: 320rpx;
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  text-align: right;
}

.setup-picker {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
}

.setup-textarea {
  width: 100%;
  min-height: 200rpx;
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  line-height: var(--line-height-base);
}

/* Footer */
.setup-footer {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  padding: var(--space-md) var(--padding-page) calc(var(--space-md) + var(--safe-area-inset-bottom));
  background-color: var(--color-bg-secondary);
  border-top: 1rpx solid var(--color-separator);
}
