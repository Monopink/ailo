<view class="square-container">
  <!-- Category tabs -->
  <scroll-view scroll-x class="category-tabs">
    <view class="tabs-inner">
      <view
        wx:for="{{categories}}"
        wx:key="key"
        class="tab-item {{currentCategory === item.key ? 'active' : ''}}"
        bindtap="selectCategory"
        data-category="{{item.key}}">
        <text>{{item.label}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- Contact list -->
  <scroll-view
    scroll-y
    class="contact-list"
    bindscrolltolower="onReachBottom"
    lower-threshold="100">

    <!-- Contact cards -->
    <view
      wx:for="{{contacts}}"
      wx:key="id"
      class="contact-card"
      bindtap="handleContactTap"
      data-id="{{item.id}}">

      <image src="{{item.avatar_url}}" class="avatar" mode="aspectFill" />

      <view class="info">
        <view class="name-row">
          <text class="nickname">{{item.nickname}}</text>
          <text class="gender" wx:if="{{item.gender}}">
            {{item.gender === 1 ? '♂' : item.gender === 2 ? '♀' : ''}}
          </text>
        </view>

        <text class="bio" wx:if="{{item.bio}}">{{item.bio}}</text>

        <text class="region" wx:if="{{item.region}}">{{item.region}}</text>
      </view>

      <button
        class="add-btn"
        catchtap="handleAddContact"
        data-id="{{item.id}}">
        添加
      </button>
    </view>

    <!-- Empty state -->
    <view wx:if="{{contacts.length === 0 && !loading}}" class="empty-state">
      <text class="empty-text">暂无内容</text>
      <text class="empty-hint">试试切换分类</text>
    </view>

    <!-- Loading state -->
    <view wx:if="{{loading}}" class="loading-state">
      <text class="loading-text">加载中...</text>
    </view>

    <!-- Load more indicator -->
    <view wx:if="{{loadingMore}}" class="loading-more">
      <text>加载更多...</text>
    </view>

    <!-- No more data -->
    <view wx:if="{{!hasMore && contacts.length > 0}}" class="no-more">
      <text>没有更多了</text>
    </view>
  </scroll-view>
</view>
