@import '/styles/tdesign-theme.wxss';
@import '/styles/design-tokens.wxss';

.square-page {
  background-color: var(--color-bg-page);
}

/* Header - Always visible */
.square-header {
  background-color: var(--color-bg-page);
}

/* Category tabs */
.square-tabs {
  width: 100%;
  background-color: var(--color-bg-secondary);
  border-bottom: 1rpx solid var(--color-separator);
}

.square-tabs__list {
  display: inline-flex;
  gap: var(--space-md);
  padding: var(--space-md) var(--padding-page);
  min-width: 100%;
}

.square-tabs__item {
  padding: var(--space-xs) var(--space-md);
  border-radius: var(--radius-full);
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  background-color: var(--color-bg-tertiary);
  white-space: nowrap;
  transition: all var(--duration-fast) var(--ease-out);
}

.square-tabs__item--active {
  color: var(--color-text-inverse);
  background-color: var(--color-primary);
  font-weight: var(--font-weight-medium);
}

/* Contact list - iOS style direct list */
.square-list {
  background-color: var(--color-bg-secondary);
  margin-top: var(--space-md);
}

.square-item {
  display: flex;
  align-items: flex-start;
  gap: var(--space-md);
  padding: var(--space-md) var(--padding-page);
  background-color: var(--color-bg-secondary);
  border-bottom: 1rpx solid var(--color-separator);
  transition: background-color var(--duration-fast) var(--ease-out);
}

.square-item:active {
  background-color: var(--color-bg-hover);
}

.square-item:last-child {
  border-bottom: none;
}

.square-item__avatar {
  flex-shrink: 0;
  margin-top: 4rpx;
}

.square-item__info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.square-item__header {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  line-height: 44rpx;
  margin-bottom: 4rpx;
}

.square-item__name {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
}

.square-item__bio {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 40rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 4rpx;
}

.square-item__region {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  line-height: 32rpx;
}

.square-item__button {
  flex-shrink: 0;
  min-width: 120rpx;
}
