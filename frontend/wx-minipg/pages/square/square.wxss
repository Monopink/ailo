/* Square page */

.square-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

/* Category tabs */
.category-tabs {
  background-color: #fff;
  border-bottom: 1rpx solid #e5e5e5;
  white-space: nowrap;
}

.tabs-inner {
  display: inline-flex;
  padding: 20rpx 32rpx;
  gap: 24rpx;
}

.tab-item {
  padding: 16rpx 32rpx;
  background-color: #f8f8f8;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.2s;
}

.tab-item.active {
  background-color: #42db5a;
  color: #fff;
}

/* Contact list */
.contact-list {
  flex: 1;
  height: 100%;
}

/* Contact card */
.contact-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  margin: 16rpx 32rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  background-color: #f5f5f5;
  flex-shrink: 0;
}

.info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.nickname {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.gender {
  font-size: 28rpx;
  color: #999;
}

.bio {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.region {
  font-size: 24rpx;
  color: #999;
}

.add-btn {
  padding: 12rpx 32rpx;
  background-color: #42db5a;
  color: #fff;
  font-size: 28rpx;
  border-radius: 32rpx;
  border: none;
  flex-shrink: 0;
}

.add-btn::after {
  border: none;
}

/* Empty state */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  gap: 16rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
}

.empty-hint {
  font-size: 26rpx;
  color: #ccc;
}

/* Loading state */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* Load more */
.loading-more,
.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  font-size: 26rpx;
  color: #999;
}
