.stranger-info-page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  color: #999;
}

.profile-content {
  display: flex;
  flex-direction: column;
}

/* Header section - WeChat style */
.header-section {
  background-color: #fff;
  padding: 32rpx;
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 8rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.header-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.name-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.nickname {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  margin-right: 12rpx;
}

.gender {
  font-size: 36rpx;
  color: #666;
}

.qiao-id {
  font-size: 28rpx;
  color: #999;
}

/* Info list */
.info-list {
  background-color: #fff;
  margin-bottom: 16rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.bio-item {
  align-items: flex-start;
}

.label {
  font-size: 32rpx;
  color: #333;
  flex-shrink: 0;
  margin-right: 32rpx;
}

.value {
  font-size: 32rpx;
  color: #666;
  text-align: right;
}

.bio-value {
  text-align: left;
  line-height: 1.6;
}

/* Action section */
.action-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: #fff;
  border-top: 1rpx solid #f0f0f0;
}

.add-btn {
  width: 100%;
  height: 88rpx;
  background-color: #42db5a;
  color: #fff;
  font-size: 32rpx;
  border-radius: 16rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-btn::after {
  border: none;
}

