<page-layout
  isLoading="{{pageLayoutData.isLoading}}"
  hasError="{{pageLayoutData.hasError}}"
  errorMessage="{{pageLayoutData.errorMessage}}"
  isEmpty="{{pageLayoutData.isEmpty}}"
  emptyMessage="{{pageLayoutData.emptyMessage}}"
  hasFooter="{{pageLayoutData.hasFooter}}"
  bind:retry="onRetry">
  <view slot="content" class="verify-page">
    <view class="verify-header">
      <text class="verify-title">身份验证</text>
      <text class="verify-subtitle">为了您的账户安全，请完成验证</text>
    </view>

    <view class="verify-methods">
      <view
        class="verify-method {{verifyType === 'phone' ? 'verify-method--active' : ''}}"
        bindtap="selectPhone">
        <text class="verify-method__label">手机号验证</text>
        <text class="verify-method__value">{{maskedPhone || '未绑定'}}</text>
      </view>
      <view
        wx:if="{{hasEmail}}"
        class="verify-method {{verifyType === 'email' ? 'verify-method--active' : ''}}"
        bindtap="selectEmail">
        <text class="verify-method__label">邮箱验证</text>
        <text class="verify-method__value">{{maskedEmail || '未绑定'}}</text>
      </view>
    </view>

    <view class="verify-code">
      <input
        class="verify-code__input"
        type="number"
        placeholder="请输入验证码"
        value="{{code}}"
        bindinput="onCodeInput"
        maxlength="6" />
      <ui-button
        type="secondary"
        size="small"
        disabled="{{cooldown > 0 || sending}}"
        loading="{{sending}}"
        bindtap="sendCode">
        {{cooldown > 0 ? cooldown + 's' : '发送验证码'}}
      </ui-button>
    </view>
  </view>

  <view slot="footer" class="verify-footer">
    <ui-button
      type="primary"
      block="{{true}}"
      disabled="{{verifying || code.length !== 6}}"
      loading="{{verifying}}"
      bindtap="handleVerify">
      确认
    </ui-button>
  </view>
</page-layout>

<view wx:if="{{loadCaptcha}}" class="verify-captcha">
  <aliyun-captcha id="captcha-element" props="{{pluginProps}}" />
</view>
