@import '/styles/tdesign-theme.wxss';
@import '/styles/design-tokens.wxss';

.verify-page {
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
  padding: var(--padding-page);
  background-color: var(--color-bg-page);
}

.verify-header {
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.verify-title {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.verify-subtitle {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

/* Method section */
.verify-methods {
  display: flex;
  flex-direction: column;
  background-color: var(--color-bg-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.verify-method {
  padding: var(--space-lg);
  border-bottom: 1rpx solid var(--color-border-light);
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.verify-method:last-child {
  border-bottom: none;
}

.verify-method--active {
  background-color: var(--color-bg-hover);
}

.verify-method--active::after {
  display: none;
}

.verify-method__label {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.verify-method__value {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

/* Code section */
.verify-code {
  display: flex;
  gap: var(--space-sm);
  align-items: center;
}

.verify-code__input {
  flex: 1;
  min-width: 0;
  border-radius: var(--radius-md);
  border: none;
  background-color: var(--color-bg-input);
  padding: 0 var(--space-sm);
  min-height: var(--input-height-md);
  font-size: var(--font-size-lg);
  color: var(--color-text-primary);
  letter-spacing: var(--space-xs);
  text-align: center;
}

.verify-code__input::placeholder {
  color: var(--color-text-placeholder);
  letter-spacing: normal;
  text-align: left;
}

.verify-footer {
  padding: var(--space-md) var(--space-lg) calc(var(--space-md) + var(--safe-area-inset-bottom));
  background-color: var(--color-bg-card);
  border-top: 1rpx solid var(--color-border-base);
}

.verify-captcha {
  margin-top: var(--space-md);
}
