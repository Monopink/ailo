/**
 * TDesign Theme Customization
 *
 * Overrides TDesign default theme variables to match WeChat style
 * Brand Color: #07C160 (WeChat Green)
 */

page {
  /* ========================================
     Brand Colors - WeChat Green
     ======================================== */

  /* Primary brand color */
  --td-brand-color: #07c160;
  --td-brand-color-1: #e8f8f0;
  --td-brand-color-2: #d1f1e1;
  --td-brand-color-3: #baebd2;
  --td-brand-color-4: #a3e4c3;
  --td-brand-color-5: #8cddb4;
  --td-brand-color-6: #75d6a5;
  --td-brand-color-7: #5ed096;
  --td-brand-color-8: #47c987;
  --td-brand-color-9: #30c278;
  --td-brand-color-10: #07c160;

  /* Brand color variations */
  --td-brand-color-light: #38cd7f;
  --td-brand-color-focus: #06ad56;
  --td-brand-color-disabled: #a3e4c3;
  --td-brand-color-hover: #06ad56;
  --td-brand-color-active: #06ad56;

  /* ========================================
     Spacing System - 8rpx base
     ======================================== */

  --td-spacer: 8rpx;
  --td-spacer-1: 8rpx;
  --td-spacer-2: 16rpx;
  --td-spacer-3: 24rpx;
  --td-spacer-4: 32rpx;
  --td-spacer-5: 40rpx;

  /* ========================================
     Border Radius - Gentle & Modern
     ======================================== */

  /* Unified border-radius: All components (buttons, inputs, cards) use 24rpx (12px) */
  --td-radius-small: 8rpx;
  --td-radius-default: 24rpx; /* Changed from 16rpx to match card radius */
  --td-radius-medium: 24rpx; /* Changed from 16rpx to match card radius */
  --td-radius-large: 24rpx;
  --td-radius-extra-large: 32rpx;
  --td-radius-round: 999rpx;
  --td-radius-circle: 50%;

  /* ========================================
     Component Heights - Unified at 88rpx
     ======================================== */

  /* Button heights - set medium (default) to 88rpx */
  --td-button-extra-small-height: 56rpx;
  --td-button-small-height: 72rpx;
  --td-button-medium-height: 88rpx; /* Default - matches our design tokens */
  --td-button-large-height: 104rpx;

  /* Input vertical padding - adjusted for 88rpx total height */
  /* Total height = padding-top + min-height(48rpx) + padding-bottom */
  /* 88rpx = 20rpx + 48rpx + 20rpx */
  --td-input-vertical-padding: 20rpx;

  /* ========================================
     Font System
     ======================================== */

  --td-font-size-base: 28rpx;
  --td-font-size-s: 24rpx;
  --td-font-size-m: 28rpx;
  --td-font-size-l: 32rpx;
  --td-font-size-xl: 36rpx;

  /* ========================================
     Background Colors - iOS inspired
     ======================================== */

  --td-bg-color-page: #f5f5f5;
  --td-bg-color-container: #ffffff;
  --td-bg-color-secondarycontainer: #fafafa;
  --td-bg-color-component: #f8f8f8;
  --td-bg-color-component-hover: #f0f0f0;
  --td-bg-color-component-active: #e8e8e8;
  --td-bg-color-component-disabled: #f5f5f5;

  /* ========================================
     Text Colors - Soft & Readable
     ======================================== */

  --td-text-color-primary: #1a1a1a;
  --td-text-color-secondary: #666666;
  --td-text-color-placeholder: #999999;
  --td-text-color-disabled: #cccccc;
  --td-text-color-anti: #ffffff;
  --td-text-color-brand: #07c160;

  /* ========================================
     Border Colors
     ======================================== */

  --td-border-level-1-color: #e8e8e8;
  --td-border-level-2-color: #f0f0f0;
  --td-component-border: #e8e8e8;

  /* ========================================
     Shadow System - Subtle & Soft
     ======================================== */

  --td-shadow-1: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  --td-shadow-2: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  --td-shadow-3: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);

  /* ========================================
     Error & Warning Colors
     ======================================== */

  --td-error-color: #e34d59;
  --td-error-color-1: #fef0f0;
  --td-error-color-hover: #c9353f;
  --td-error-color-active: #b72835;

  --td-warning-color: #ed7b2f;
  --td-warning-color-1: #fff1e9;
  --td-warning-color-hover: #d56829;
  --td-warning-color-active: #ba5425;

  --td-success-color: #07c160;
  --td-success-color-1: #e8f8f0;
  --td-success-color-hover: #06ad56;
  --td-success-color-active: #059a4d;
}

/* ========================================
   Dark Mode Support
   ======================================== */

page[theme='dark'] {
  /* Brand colors remain the same in dark mode */
  --td-brand-color: #07c160;

  /* Background colors for dark mode */
  --td-bg-color-page: #1a1a1a;
  --td-bg-color-container: #2a2a2a;
  --td-bg-color-secondarycontainer: #333333;
  --td-bg-color-component: #2f2f2f;
  --td-bg-color-component-hover: #3a3a3a;
  --td-bg-color-component-active: #454545;
  --td-bg-color-component-disabled: #2a2a2a;

  /* Text colors for dark mode */
  --td-text-color-primary: #e8e8e8;
  --td-text-color-secondary: #b3b3b3;
  --td-text-color-placeholder: #808080;
  --td-text-color-disabled: #5c5c5c;
  --td-text-color-anti: #1a1a1a;

  /* Border colors for dark mode */
  --td-border-level-1-color: #3f3f3f;
  --td-border-level-2-color: #333333;
  --td-component-border: #3f3f3f;

  /* Shadow colors for dark mode */
  --td-shadow-1: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  --td-shadow-2: 0 4rpx 16rpx rgba(0, 0, 0, 0.4);
  --td-shadow-3: 0 8rpx 24rpx rgba(0, 0, 0, 0.5);
}
